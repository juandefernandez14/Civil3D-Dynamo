    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\n# Lee la lista de nombres ordenados que Python1 dejo en globales.\n# IN[0] es solo para forzar orden de ejecucion (recibe el Document\n# de Python1 para asegurar que Python1 ya termino).\nimport sys\n_doc = IN[0]   # passthrough trigger\nmain_mod = sys.modules.get('__main__')\nif main_mod is None:\n    import __main__ as main_mod\nOUT = list(getattr(main_mod, '_tracker_align_names', []))\n",
      "Engine": "CPython3",
