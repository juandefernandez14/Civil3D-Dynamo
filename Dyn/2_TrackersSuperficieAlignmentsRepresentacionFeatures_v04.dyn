    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Deletes any existing profile (matching the target name) on each\n# alignment before AddProfileBySurface runs. Runs once per execution.\n#\n# IN[0] : list[Alignment]   (Civil 3D Toolkit / Civil DynamoNodes wrappers)\n# IN[1] : list[str]         (target profile names, parallel to IN[0])\n# OUT   : list[Alignment]   (the same alignments, passed through)\n\nimport clr\nimport sys\nimport traceback\n\nclr.AddReference(\"AcMgd\")\nclr.AddReference(\"AcDbMgd\")\nclr.AddReference(\"AcCoreMgd\")\nclr.AddReference(\"AcCui\")\n\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import OpenMode\n\nalignments = IN[0]\ntarget_names = IN[1]\n\n# Allow scalar inputs (Dynamo sometimes auto-unwraps single-element lists)\nif not isinstance(alignments, list):\n    alignments = [alignments]\nif not isinstance(target_names, list):\n    target_names = [target_names]\n\ndoc = Application.DocumentManager.MdiActiveDocument\ndb = doc.Database\n\ndeleted = []\nerrors = []\n\n\ndef get_object_id(wrapper):\n    \"\"\"Robust extraction of an ObjectId from a Civil 3D Dynamo wrapper.\n    The Civil3DToolkit / Autodesk Civil DynamoNodes wrappers expose the\n    underlying DBObject as ``InternalDBObject``. We try a couple of\n    fallbacks rather than guessing.\"\"\"\n    for attr in (\"InternalDBObject\", \"InternalObject\", \"InternalAlignment\"):\n        if hasattr(wrapper, attr):\n            obj = getattr(wrapper, attr)\n            if obj is not None and hasattr(obj, \"ObjectId\"):\n                return obj.ObjectId\n    if hasattr(wrapper, \"InternalObjectId\"):\n        return wrapper.InternalObjectId\n    return None\n\n\ndoc_lock = doc.LockDocument()\ntry:\n    tr = db.TransactionManager.StartTransaction()\n    try:\n        n_pairs = min(len(alignments), len(target_names))\n        for i in range(n_pairs):\n            wrapper = alignments[i]\n            target = target_names[i]\n            try:\n                align_id = get_object_id(wrapper)\n                if align_id is None:\n                    errors.append(\"[{0}] no ObjectId from wrapper {1}\".format(i, type(wrapper).__name__))\n                    continue\n\n                align = tr.GetObject(align_id, OpenMode.ForRead)\n                prof_ids = align.GetProfileIds()\n\n                for pid in prof_ids:\n                    prof = tr.GetObject(pid, OpenMode.ForRead)\n                    if prof.Name == target:\n                        prof.UpgradeOpen()\n                        prof.Erase()\n                        deleted.append(\"{0} :: {1}\".format(i, target))\n                        break\n            except Exception as ex:\n                errors.append(\"[{0}] {1}: {2}\".format(i, target, str(ex)))\n        tr.Commit()\n    finally:\n        tr.Dispose()\nfinally:\n    doc_lock.Dispose()\n\n# Pass the alignments through so downstream AddProfileBySurface can consume them.\n# We also tag the result with diagnostics in case the user wants to inspect them.\nOUT = alignments\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "a94101a2f9244b91be674633fb9a890a",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "f48eb16215a84464a79d8a30dbad25f4",
          "Name": "IN[0]",
          "Description": "",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "f773794f8bbd4775a6fa69b760e1da80",
          "Name": "IN[1]",
          "Description": "",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "2b91e3761c6641db96b6281a2b95dee3",
          "Name": "OUT",
          "Description": "",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Deletes any existing profile (matching the target name) on each\n# alignment before AddProfileBySurface runs. Runs once per execution.\n#\n# IN[0] : list[Alignment]   (Civil 3D Toolkit / Civil DynamoNodes wrappers)\n# IN[1] : list[str]         (target profile names, parallel to IN[0])\n# OUT   : list[Alignment]   (the same alignments, passed through)\n\nimport clr\nimport sys\nimport traceback\n\nclr.AddReference(\"AcMgd\")\nclr.AddReference(\"AcDbMgd\")\nclr.AddReference(\"AcCoreMgd\")\nclr.AddReference(\"AcCui\")\n\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import OpenMode\n\nalignments = IN[0]\ntarget_names = IN[1]\n\n# Allow scalar inputs (Dynamo sometimes auto-unwraps single-element lists)\nif not isinstance(alignments, list):\n    alignments = [alignments]\nif not isinstance(target_names, list):\n    target_names = [target_names]\n\ndoc = Application.DocumentManager.MdiActiveDocument\ndb = doc.Database\n\ndeleted = []\nerrors = []\n\n\ndef get_object_id(wrapper):\n    \"\"\"Robust extraction of an ObjectId from a Civil 3D Dynamo wrapper.\n    The Civil3DToolkit / Autodesk Civil DynamoNodes wrappers expose the\n    underlying DBObject as ``InternalDBObject``. We try a couple of\n    fallbacks rather than guessing.\"\"\"\n    for attr in (\"InternalDBObject\", \"InternalObject\", \"InternalAlignment\"):\n        if hasattr(wrapper, attr):\n            obj = getattr(wrapper, attr)\n            if obj is not None and hasattr(obj, \"ObjectId\"):\n                return obj.ObjectId\n    if hasattr(wrapper, \"InternalObjectId\"):\n        return wrapper.InternalObjectId\n    return None\n\n\ndoc_lock = doc.LockDocument()\ntry:\n    tr = db.TransactionManager.StartTransaction()\n    try:\n        n_pairs = min(len(alignments), len(target_names))\n        for i in range(n_pairs):\n            wrapper = alignments[i]\n            target = target_names[i]\n            try:\n                align_id = get_object_id(wrapper)\n                if align_id is None:\n                    errors.append(\"[{0}] no ObjectId from wrapper {1}\".format(i, type(wrapper).__name__))\n                    continue\n\n                align = tr.GetObject(align_id, OpenMode.ForRead)\n                prof_ids = align.GetProfileIds()\n\n                for pid in prof_ids:\n                    prof = tr.GetObject(pid, OpenMode.ForRead)\n                    if prof.Name == target:\n                        prof.UpgradeOpen()\n                        prof.Erase()\n                        deleted.append(\"{0} :: {1}\".format(i, target))\n                        break\n            except Exception as ex:\n                errors.append(\"[{0}] {1}: {2}\".format(i, target, str(ex)))\n        tr.Commit()\n    finally:\n        tr.Dispose()\nfinally:\n    doc_lock.Dispose()\n\n# Pass the alignments through so downstream AddProfileBySurface can consume them.\n# We also tag the result with diagnostics in case the user wants to inspect them.\nOUT = alignments\n",
