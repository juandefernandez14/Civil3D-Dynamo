    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Groups alignments by their 'Cxx' contour tag and lays them out as\n# one column per contour. Returns 4 parallel lists for downstream nodes.\n#\n# IN[0] : list[Alignment]   - alignments (from Alignments node)\n# IN[1] : list[Profile]     - TN profiles (SYNC BARRIER, content unused)\n# IN[2] : list[Profile]     - Trackers profiles (SYNC BARRIER, content unused)\n# IN[3] : float             - Origin X\n# IN[4] : float             - Origin Y\n# IN[5] : float             - Column spacing\n# IN[6] : float             - Row spacing\n# IN[7] : str               - Profile View name prefix\n#\n# OUT : [xs, ys, names, ordered_alignments] - 4 parallel sublists\n\nimport re\nimport clr\n\nclr.AddReference(\"AcMgd\")\nclr.AddReference(\"AcDbMgd\")\nclr.AddReference(\"AcCoreMgd\")\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import OpenMode\n\nalignments  = IN[0]\norigin_x    = float(IN[3])\norigin_y    = float(IN[4])\ncol_spacing = float(IN[5])\nrow_spacing = float(IN[6])\npv_prefix   = str(IN[7])\n\n# Allow scalar inputs\nif not isinstance(alignments, list):\n    alignments = [alignments]\n\n# Regex: first 'Cxx' in the name (case-insensitive). Captures the digits.\ncontour_re = re.compile(r\"C(\\d+)\", re.IGNORECASE)\n\ndoc = Application.DocumentManager.MdiActiveDocument\ndb = doc.Database\n\n\ndef get_align_name(wrapper):\n    \"\"\"Return the alignment name. Try the wrapper's .Name first\n    (works for Civil 3D Toolkit and Autodesk.Civil.DynamoNodes wrappers).\n    Fall back to opening the underlying CivilDB Alignment in a transaction.\"\"\"\n    # Direct property on the wrapper\n    if hasattr(wrapper, \"Name\"):\n        try:\n            n = wrapper.Name\n            if n is not None:\n                return str(n)\n        except Exception:\n            pass\n\n    # Fallback: read from the underlying DBObject inside a transaction\n    obj_id = None\n    for attr in (\"InternalDBObject\", \"InternalObject\", \"InternalAlignment\"):\n        if hasattr(wrapper, attr):\n            obj = getattr(wrapper, attr)\n            if obj is not None and hasattr(obj, \"ObjectId\"):\n                obj_id = obj.ObjectId\n                break\n    if obj_id is None and hasattr(wrapper, \"InternalObjectId\"):\n        obj_id = wrapper.InternalObjectId\n    if obj_id is None:\n        return None\n\n    name = None\n    doc_lock = doc.LockDocument()\n    try:\n        tr = db.TransactionManager.StartTransaction()\n        try:\n            entity = tr.GetObject(obj_id, OpenMode.ForRead)\n            name = str(entity.Name)\n            tr.Commit()\n        finally:\n            tr.Dispose()\n    finally:\n        doc_lock.Dispose()\n    return name\n\n\n# ---- Parse + group by contour ----\ngroups = {}        # int contour_id -> list of (name, wrapper)\nunmatched = []\n\nfor w in alignments:\n    name = get_align_name(w)\n    if name is None:\n        unmatched.append(w)\n        continue\n    m = contour_re.search(name)\n    if not m:\n        unmatched.append(w)\n        continue\n    cid = int(m.group(1))\n    groups.setdefault(cid, []).append((name, w))\n\n# Sort entries within each contour by full name (lexicographic), so that\n# AL_C01_01 < AL_C01_02 < AL_C01_10 ...  We also pad numeric tail to ensure\n# correct ordering for double-digit row indices.\ndef natural_key(s):\n    return [int(t) if t.isdigit() else t.lower()\n            for t in re.split(r\"(\\d+)\", s)]\n\nfor cid in groups:\n    groups[cid].sort(key=lambda pair: natural_key(pair[0]))\n\ncontour_ids = sorted(groups.keys())\n\n# Append unmatched alignments as a synthetic trailing column\nif unmatched:\n    groups[-1] = [(\"\", w) for w in unmatched]\n    contour_ids.append(-1)\n\n# ---- Layout: one column per contour ----\nxs = []\nys = []\nnames = []\nordered = []\n\nfor col_idx, cid in enumerate(contour_ids):\n    x = origin_x + col_idx * col_spacing\n    pairs = groups[cid]\n    for row_idx, (aname, wrapper) in enumerate(pairs):\n        y = origin_y + row_idx * row_spacing\n        if cid >= 0:\n            pv_name = \"{0}_C{1:02d}_{2:02d}\".format(pv_prefix, cid, row_idx + 1)\n        else:\n            pv_name = \"{0}_UNGROUPED_{1:02d}\".format(pv_prefix, row_idx + 1)\n        xs.append(x)\n        ys.append(y)\n        names.append(pv_name)\n        ordered.append(wrapper)\n\nOUT = [xs, ys, names, ordered]\n",
