      "Replication": "Auto",
      "Description": "Creates a Profile View.\n\nProfileView.ByAlignmentPointName (alignment: Alignment, insertPoint: Point, profileViewName: string, bandSet: string = \"\", style: string = \"\"): ProfileView"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Post-proceso: limpia SampleLines, etiquetas PVI y Polylines EJES.\n#\n# PASS 1: por cada alignment, borra SampleLineGroups + SampleLines.\n# PASS 2: barre ModelSpace borrando SampleLine huerfanas.\n# PASS 3: SOLO borra etiquetas PVI (GetPVILabelGroupIds). NO toca bandas.\n# PASS 4: borra Polylines de la capa de ejes.\n#\n# IN[0] : list[Alignment]   - alignments\n# IN[1] : list[ProfileView] - barrera de sincronizacion\n# IN[2] : str               - nombre de la capa de ejes\n\nimport clr\n\nclr.AddReference(\"AcMgd\")\nclr.AddReference(\"AcDbMgd\")\nclr.AddReference(\"AcCoreMgd\")\nclr.AddReference(\"AeccDbMgd\")\n\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import (\n    OpenMode, SymbolUtilityServices, Polyline\n)\nfrom Autodesk.Civil.DatabaseServices import SampleLine, SampleLineGroup\n\n\ndef to_list(x):\n    if x is None:\n        return []\n    if isinstance(x, list):\n        return x\n    try:\n        return list(x)\n    except TypeError:\n        return [x]\n\n\ndef get_object_id(wrapper):\n    for attr in (\"InternalDBObject\", \"InternalObject\", \"InternalAlignment\"):\n        if hasattr(wrapper, attr):\n            obj = getattr(wrapper, attr)\n            if obj is not None and hasattr(obj, \"ObjectId\"):\n                return obj.ObjectId\n    if hasattr(wrapper, \"InternalObjectId\"):\n        return wrapper.InternalObjectId\n    return None\n\n\nalignments = to_list(IN[0])\naxis_layer = str(IN[2]) if IN[2] is not None else \"\"\n\ndoc = Application.DocumentManager.MdiActiveDocument\ndb = doc.Database\n\nsl_targeted = 0\nslg_targeted = 0\nsl_sweep = 0\npvi_labels_deleted = 0\npolys_deleted = 0\nerrors = []\n\ndoc_lock = doc.LockDocument()\ntry:\n    tr = db.TransactionManager.StartTransaction()\n    try:\n        # ================================================================\n        # PASS 1: targeted SampleLine cleanup per alignment\n        # ================================================================\n        for i, wrapper in enumerate(alignments):\n            try:\n                al_id = get_object_id(wrapper)\n                if al_id is None:\n                    errors.append(\"[{0}] no ObjectId\".format(i))\n                    continue\n                align = tr.GetObject(al_id, OpenMode.ForRead)\n                try:\n                    slg_id_coll = align.GetSampleLineGroupIds()\n                except Exception as ex:\n                    errors.append(\"[{0}] GetSLG: {1}\".format(i, str(ex)))\n                    continue\n                slg_id_list = []\n                for slg_id in slg_id_coll:\n                    slg_id_list.append(slg_id)\n                for slg_id in slg_id_list:\n                    try:\n                        slg = tr.GetObject(slg_id, OpenMode.ForRead)\n                        sl_id_list = []\n                        for sl_id in slg.GetSampleLineIds():\n                            sl_id_list.append(sl_id)\n                        for sl_id in sl_id_list:\n                            try:\n                                sl = tr.GetObject(sl_id, OpenMode.ForWrite)\n                                sl.Erase()\n                                sl_targeted += 1\n                            except Exception as ex:\n                                errors.append(\"[{0}] erase SL: {1}\".format(i, str(ex)))\n                        slg.UpgradeOpen()\n                        slg.Erase()\n                        slg_targeted += 1\n                    except Exception as ex:\n                        errors.append(\"[{0}] erase SLG: {1}\".format(i, str(ex)))\n            except Exception as ex:\n                errors.append(\"[{0}] pass1: {1}\".format(i, str(ex)))\n\n        # ================================================================\n        # PASS 2: sweep ModelSpace for orphan SampleLines\n        # ================================================================\n        try:\n            ms_id = SymbolUtilityServices.GetBlockModelSpaceId(db)\n            ms = tr.GetObject(ms_id, OpenMode.ForRead)\n            ent_ids = []\n            for oid in ms:\n                ent_ids.append(oid)\n            for oid in ent_ids:\n                try:\n                    ent = tr.GetObject(oid, OpenMode.ForRead)\n                    if isinstance(ent, SampleLine):\n                        ent.UpgradeOpen()\n                        ent.Erase()\n                        sl_sweep += 1\n                except Exception:\n                    pass\n        except Exception as ex:\n            errors.append(\"sweep SL: {0}\".format(str(ex)))\n\n        # ================================================================\n        # PASS 3: delete PVI labels ONLY (NO toca bandas ni otras labels)\n        # ================================================================\n        for i, wrapper in enumerate(alignments):\n            try:\n                al_id = get_object_id(wrapper)\n                if al_id is None:\n                    continue\n                align = tr.GetObject(al_id, OpenMode.ForRead)\n                prof_ids = align.GetProfileIds()\n                prof_id_list = []\n                for pid in prof_ids:\n                    prof_id_list.append(pid)\n                for pid in prof_id_list:\n                    try:\n                        prof = tr.GetObject(pid, OpenMode.ForRead)\n                        # SOLO GetPVILabelGroupIds\n                        fn = getattr(prof, \"GetPVILabelGroupIds\", None)\n                        if fn is not None:\n                            try:\n                                label_ids = fn()\n                                lid_list = []\n                                for lid in label_ids:\n                                    lid_list.append(lid)\n                                for lid in lid_list:\n                                    try:\n                                        lbl = tr.GetObject(lid, OpenMode.ForWrite)\n                                        lbl.Erase()\n                                        pvi_labels_deleted += 1\n                                    except Exception:\n                                        pass\n                            except Exception as ex:\n                                errors.append(\"[{0}] GetPVILabelGroupIds: {1}\".format(i, str(ex)))\n                    except Exception as ex:\n                        errors.append(\"[{0}] pass3 prof: {1}\".format(i, str(ex)))\n            except Exception as ex:\n                errors.append(\"[{0}] pass3: {1}\".format(i, str(ex)))\n\n        # Fallback sweep: SOLO PVILabel (no ProfileLabel generico)\n        if pvi_labels_deleted == 0:\n            try:\n                ms_id = SymbolUtilityServices.GetBlockModelSpaceId(db)\n                ms = tr.GetObject(ms_id, OpenMode.ForRead)\n                ent_ids2 = []\n                for oid in ms:\n                    ent_ids2.append(oid)\n                for oid in ent_ids2:\n                    try:\n                        ent = tr.GetObject(oid, OpenMode.ForRead)\n                        tn = ent.GetType().Name\n                        if \"PVILabel\" in tn:\n                            ent.UpgradeOpen()\n                            ent.Erase()\n                            pvi_labels_deleted += 1\n                    except Exception:\n                        pass\n            except Exception as ex:\n                errors.append(\"sweep PVI: {0}\".format(str(ex)))\n\n        # ================================================================\n        # PASS 4: delete helper Polylines on the EJES layer\n        # ================================================================\n        if axis_layer:\n            try:\n                ms_id = SymbolUtilityServices.GetBlockModelSpaceId(db)\n                ms = tr.GetObject(ms_id, OpenMode.ForRead)\n                ent_ids3 = []\n                for oid in ms:\n                    ent_ids3.append(oid)\n                for oid in ent_ids3:\n                    try:\n                        ent = tr.GetObject(oid, OpenMode.ForRead)\n                        if isinstance(ent, Polyline) and ent.Layer == axis_layer:\n                            ent.UpgradeOpen()\n                            ent.Erase()\n                            polys_deleted += 1\n                    except Exception:\n                        pass\n            except Exception as ex:\n                errors.append(\"sweep EJES: {0}\".format(str(ex)))\n\n        tr.Commit()\n    finally:\n        tr.Dispose()\nfinally:\n    doc_lock.Dispose()\n\nOUT = {\n    \"sl_deleted_targeted\": sl_targeted,\n    \"slg_deleted_targeted\": slg_targeted,\n    \"sl_deleted_sweep\": sl_sweep,\n    \"pvi_labels_deleted\": pvi_labels_deleted,\n    \"polys_ejes_deleted\": polys_deleted,\n    \"errors\": errors,\n}\n",
