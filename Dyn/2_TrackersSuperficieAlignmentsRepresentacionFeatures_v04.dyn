          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Enables selection between True and False",
      "InputValue": true
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\n# =============================================================================\n# Proyectar_FL_a_PerfilLongitudinal.dyn\n#\n# Proyecta Feature Lines de una capa dada a las ProfileViews de los alignments\n# indicados, invocando el comando nativo de Civil 3D:\n#\n#   _.AECCPROJECTOBJECTSTOPROF\n#\n# El comando NO esta expuesto en la API de Civil 3D 2024 (confirmado en los\n# foros de Autodesk). Unica via: LISP enviado por SendStringToExecute.\n#\n# LIMITACION importante: el comando abre un dialogo modal (\"Project Objects\n# To Profile View\") por cada invocacion, pidiendo estilo de proyeccion y\n# label. El dialogo no se puede suprimir via FILEDIA/CMDDIA en C3D 2024.\n# Mitigacion: el dialogo recuerda la ultima configuracion. Tras el primer\n# OK, los siguientes se aceptan con Enter.\n#\n# ENTRADAS:\n#   IN[0] : list[str]        NOMBRES DE PROFILE VIEWS a procesar. Cada\n#                             item es un string tipo 'PV_C01_01'. Para\n#                             cada PV, el script obtiene su alignment\n#                             via pv.AlignmentId (no hay ambiguedad).\n#                             Tambien acepta wrappers Dynamo si tienen\n#                             .Name legible, pero el caso comun es el\n#                             de nombres desde el code block de split.\n#   IN[1] : str              PATRON DE NOMBRE de las Feature Lines a\n#                             proyectar. Se admite sufijo comodin '*'.\n#                             Ej: 'FL_T*' (todas las FL de tracker\n#                             generadas por el pipeline).\n#                             Tambien acepta varios patrones separados\n#                             por coma: 'FL_T*,FL_C*'.\n#                             Se ignora la capa y se filtra solo por\n#                             nombre, porque el pipeline crea los FLs\n#                             con nombres conocidos (FL_Txx, FL_Cxx).\n#   IN[2] : float            tolerancia maxima (m) para considerar que una\n#                             FL pertenece al perfil de un alignment. Se\n#                             mide como distancia perpendicular del punto\n#                             medio de la FL al polyline del alignment.\n#   IN[3] : str (opcional)   nombre del estilo de proyeccion para FeatureLine.\n#                             Se muestra como referencia en el log; el estilo\n#                             real del dialogo se controla manualmente la\n#                             primera vez y se recuerda despues.\n#   IN[4] : bool             si True, intenta suprimir dialogos con\n#                             FILEDIA/CMDDIA (best effort, normalmente\n#                             NO funciona en C3D custom dialogs pero es\n#                             inofensivo).\n#   IN[5] : str              ruta del archivo temporal a usar para el\n#                             intercambio con el LISP. Default: C:\\\\Temp\\\\\n#                             proyeccion_fl.txt\n#   IN[6] : any (opcional)   BARRERA DE SINCRONIZACION. Cualquier cosa\n#                             conectada aqui (p.ej. el output del nodo\n#                             de limpieza previo) fuerza a este nodo a\n#                             ejecutarse DESPUES. El contenido se ignora.\n#   IN[7] : bool (opcional)  AUTO-OK. Si True, lanza un script PowerShell\n#                             en paralelo que detecta el dialogo \"Project\n#                             Objects To Profile View\" y le envia Enter\n#                             automaticamente. Usa los estilos configurados\n#                             la ultima vez (Civil 3D los recuerda).\n#                             Si False, el usuario pulsa OK manualmente.\n#\n# SALIDA: [log, comando_enviado_preview]\n# =============================================================================\n\nimport clr\nimport os\nimport traceback\n\nclr.AddReference(\"AcMgd\")\nclr.AddReference(\"AcDbMgd\")\nclr.AddReference(\"AcCoreMgd\")\nclr.AddReference(\"AeccDbMgd\")\n\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import (\n    OpenMode, SymbolUtilityServices, ObjectId\n)\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import FeatureLine, ProfileView\n\n\n# ============================================================================\n# Inputs\n# ============================================================================\nalignments = IN[0] if IN[0] is not None else []\nif not isinstance(alignments, list):\n    alignments = [alignments]\n\nfl_layer    = str(IN[1]).strip() if IN[1] else \"\"\n# Parse patterns. Accept comma-separated list. '*' at end is prefix match.\n_pat_list = [p.strip() for p in fl_layer.split(\",\") if p.strip()]\n\ndef _fl_name_matches(name):\n    \"\"\"Matcher simple, sin closures, evita cualquier edge case raro.\"\"\"\n    if not _pat_list or not name:\n        return False\n    # Normalizar a Python str por si pythonnet devuelve System.String\n    try:\n        name = str(name)\n    except Exception:\n        return False\n    for pat in _pat_list:\n        pat = str(pat)\n        if pat.endswith(\"*\"):\n            if name.startswith(pat[:-1]):\n                return True\n        else:\n            if name == pat:\n                return True\n    return False\n\n# Debug: lista de (name, matched) de los primeros N FLs procesados\n_match_debug = []\n_MATCH_DEBUG_N = 5\ntolerance   = float(IN[2]) if IN[2] is not None else 1.5\nproj_style  = str(IN[3]).strip() if (len(IN) > 3 and IN[3]) else \"\"\nsuppress_dl = bool(IN[4]) if (len(IN) > 4 and IN[4] is not None) else True\ntmp_file    = str(IN[5]) if (len(IN) > 5 and IN[5]) else r\"C:\\Temp\\proyeccion_fl.txt\"\n\n# IN[6]: barrera de sincronizacion. Contenido ignorado; solo forzamos la\n# lectura para que Dynamo marque la dependencia en el grafo.\n_sync_barrier = IN[6] if len(IN) > 6 else None\n_ = _sync_barrier\n\n# IN[7]: auto-OK via PowerShell\nauto_ok = bool(IN[7]) if (len(IN) > 7 and IN[7] is not None) else False\n\n# Asegurar carpeta del temp_file\ntry:\n    tmp_dir = os.path.dirname(tmp_file)\n    if tmp_dir and not os.path.isdir(tmp_dir):\n        os.makedirs(tmp_dir)\nexcept Exception:\n    pass\n\nlog = []\nlog.append(\"=== Proyectar FL a Profile View ===\")\nlog.append(\"Patron(es) nombre FL: {}\".format(\n    _pat_list if _pat_list else \"(ninguno — nada que proyectar)\"))\nlog.append(\"Tolerancia matching: {:.2f} m\".format(tolerance))\nlog.append(\"Auto-OK dialogos: {}\".format(\"SI\" if auto_ok else \"NO\"))\nlog.append(\"Estilo proyeccion: '{}'\".format(proj_style or \"(default)\"))\nlog.append(\"Suprimir dialogos best-effort: {}\".format(suppress_dl))\nlog.append(\"Archivo temp: {}\".format(tmp_file))\n\n\n# ============================================================================\n# Helpers\n# ============================================================================\n\ndef get_object_id(wrapper):\n    \"\"\"Misma pauta que en los otros .dyn del proyecto.\"\"\"\n    for attr in (\"InternalDBObject\", \"InternalObject\", \"InternalAlignment\"):\n        if hasattr(wrapper, attr):\n            obj = getattr(wrapper, attr)\n            if obj is not None and hasattr(obj, \"ObjectId\"):\n                return obj.ObjectId\n    if hasattr(wrapper, \"InternalObjectId\"):\n        return wrapper.InternalObjectId\n    return None\n\n\ndef find_alignment_by_name(cdoc, tr, name):\n    \"\"\"Busca un alignment por nombre. Misma pauta que en otros scripts.\"\"\"\n    try:\n        ids = cdoc.GetAlignmentIds()\n        for i in range(ids.Count):\n            try:\n                aid = ids.get_Item(i)\n            except Exception:\n                try:\n                    aid = ids[i]\n                except Exception:\n                    continue\n            try:\n                a = tr.GetObject(aid, OpenMode.ForRead)\n                try:\n                    if a.Name == name:\n                        return aid, a\n                except Exception:\n                    pass\n            except Exception:\n                pass\n    except Exception:\n        pass\n    return None, None\n\n\ndef resolve_alignment(item, cdoc, tr):\n    \"\"\"Recibe un item de IN[0]. Si es string, busca por nombre. Si es\n    wrapper Dynamo, extrae ObjectId. Devuelve (alignment_id, alignment_obj,\n    display_name) o (None, None, display_name).\n    \"\"\"\n    # Caso 1: string con nombre de alignment\n    if isinstance(item, str):\n        aid, a = find_alignment_by_name(cdoc, tr, item)\n        return aid, a, item\n    # Caso 2: wrapper\n    try:\n        aid = get_object_id(item)\n        if aid is not None:\n            a = tr.GetObject(aid, OpenMode.ForRead)\n            try:\n                name = a.Name\n            except Exception:\n                name = \"<unnamed>\"\n            return aid, a, name\n    except Exception:\n        pass\n    return None, None, str(item)[:40]\n\n\ndef point_to_segment_distance(px, py, ax, ay, bx, by):\n    \"\"\"Distancia perpendicular 2D de P a la recta que pasa por A-B.\n    Si la proyeccion cae fuera del segmento, devuelve la distancia al\n    extremo mas cercano.\n    \"\"\"\n    dx = bx - ax\n    dy = by - ay\n    if dx * dx + dy * dy < 1e-12:\n        ddx = px - ax\n        ddy = py - ay\n        return (ddx * ddx + ddy * ddy) ** 0.5\n    t = ((px - ax) * dx + (py - ay) * dy) / (dx * dx + dy * dy)\n    if t < 0.0:\n        t = 0.0\n    elif t > 1.0:\n        t = 1.0\n    qx = ax + t * dx\n    qy = ay + t * dy\n    ddx = px - qx\n    ddy = py - qy\n    return (ddx * ddx + ddy * ddy) ** 0.5\n\n\ndef alignment_xy_at_station(alignment, station, diag=None):\n    \"\"\"Devuelve (x, y) en la estacion. Prueba 4 metodos (mismo patron\n    que PerfilesRasantesCorredores.dyn). Si diag no es None apunta ahi\n    los errores para diagnostico.\n    \"\"\"\n    import System\n    from System import Double\n    errors = []\n\n    # Metodo A: out params vuelven como tupla (CPython3 pythonnet default)\n    try:\n        result = alignment.PointLocation(float(station), 0.0)\n        if isinstance(result, (tuple, list)):\n            if len(result) >= 2:\n                return float(result[0]), float(result[1])\n            errors.append(\"A: tupla con {} elems\".format(len(result)))\n        elif result is None:\n            errors.append(\"A: returno None\")\n        else:\n            errors.append(\"A: tipo={}\".format(type(result).__name__))\n    except Exception as e:\n        errors.append(\"A: \" + str(e)[:100])\n\n    # Metodo B: clr.Reference[Double]\n    try:\n        e_ref = clr.Reference[Double](0.0)\n        n_ref = clr.Reference[Double](0.0)\n        alignment.PointLocation(float(station), 0.0, e_ref, n_ref)\n        return float(e_ref.Value), float(n_ref.Value)\n    except Exception as e:\n        errors.append(\"B: \" + str(e)[:100])\n\n    # Metodo C: StrongBox\n    try:\n        from System.Runtime.CompilerServices import StrongBox\n        e_box = StrongBox[Double](0.0)\n        n_box = StrongBox[Double](0.0)\n        alignment.PointLocation(float(station), 0.0, e_box, n_box)\n        return float(e_box.Value), float(n_box.Value)\n    except Exception as e:\n        errors.append(\"C: \" + str(e)[:100])\n\n    # Metodo D: reflexion para llamar con System.Double refs\n    try:\n        ct = clr.GetClrType(alignment.GetType())\n        for m in ct.GetMethods():\n            if m.Name == \"PointLocation\":\n                ps = m.GetParameters()\n                if len(ps) == 4:\n                    args = System.Array[System.Object]([\n                        float(station), 0.0, 0.0, 0.0])\n                    m.Invoke(alignment, args)\n                    return float(args[2]), float(args[3])\n    except Exception as e:\n        errors.append(\"D: \" + str(e)[:100])\n\n    if diag is not None:\n        diag.extend(errors)\n    return None, None\n\n\ndef align_vertices_2d(alignment, log=None, diagnose=False):\n    \"\"\"Devuelve vertices 2D (x,y) del alignment.\n    Muestrea cada ~10m; con alineaciones casi-rectas de tracker basta.\n    Si diagnose=True, captura errores de la 1a muestra en log.\n    \"\"\"\n    pts = []\n    try:\n        start = alignment.StartingStation\n        end   = alignment.EndingStation\n    except Exception as ex:\n        if log is not None:\n            log.append(\"  align Station error: \" + str(ex)[:100])\n        return pts\n\n    length = end - start\n    if length <= 0:\n        return pts\n    step = max(1.0, min(10.0, length / 15.0))\n\n    first_diag = [] if diagnose else None\n    s = start\n    idx = 0\n    while s <= end + 1e-6:\n        diag = first_diag if (diagnose and idx == 0) else None\n        x, y = alignment_xy_at_station(alignment, s, diag)\n        if x is not None:\n            pts.append((x, y))\n        s += step\n        idx += 1\n    # Incluir extremo final\n    try:\n        x, y = alignment_xy_at_station(alignment, end, None)\n        if x is not None:\n            if not pts or (abs(pts[-1][0] - x) > 0.01 or\n                           abs(pts[-1][1] - y) > 0.01):\n                pts.append((x, y))\n    except Exception:\n        pass\n\n    if diagnose and log is not None and first_diag:\n        log.append(\"  [DIAG 1a muestra] \" + \" | \".join(first_diag))\n\n    return pts\n\n\ndef min_distance_point_to_polyline(px, py, poly_pts):\n    \"\"\"Distancia minima de (px,py) a la polyline formada por poly_pts.\"\"\"\n    if len(poly_pts) < 2:\n        return float(\"inf\")\n    dmin = float(\"inf\")\n    for i in range(len(poly_pts) - 1):\n        ax, ay = poly_pts[i]\n        bx, by = poly_pts[i + 1]\n        d = point_to_segment_distance(px, py, ax, ay, bx, by)\n        if d < dmin:\n            dmin = d\n    return dmin\n\n\ndef get_name_safe(obj):\n    try:\n        return obj.Name\n    except Exception:\n        return None\n\n\ndef find_pv_for_alignment_id(cdoc, tr, db, alignment_id, alignment_obj,\n                             align_name, log):\n    \"\"\"Busca la ProfileView asociada al alignment.\n    Devuelve (pv_handle_str, pv_objectid, pv_name) o (None, None, None).\n    Mismo patron que en PerfilesRasantesCorredores / Trackers...dyn.\n    \"\"\"\n    # Metodo 1: GetProfileViewIds\n    try:\n        pv_ids = alignment_obj.GetProfileViewIds()\n        for i in range(pv_ids.Count):\n            try:\n                pvid = pv_ids.get_Item(i)\n            except Exception:\n                try:\n                    pvid = pv_ids[i]\n                except Exception:\n                    continue\n            try:\n                pv = tr.GetObject(pvid, OpenMode.ForRead)\n                pv_name = get_name_safe(pv)\n                handle_str = pv.Handle.ToString()\n                return handle_str, pvid, pv_name\n            except Exception:\n                pass\n    except Exception:\n        pass\n\n    # Metodo 2: iterar BlockTable (ModelSpace + Layouts)\n    try:\n        bt = tr.GetObject(db.BlockTableId, OpenMode.ForRead)\n        for btr_id in bt:\n            try:\n                btr = tr.GetObject(btr_id, OpenMode.ForRead)\n                for oid in btr:\n                    try:\n                        obj = tr.GetObject(oid, OpenMode.ForRead)\n                        if isinstance(obj, ProfileView):\n                            try:\n                                if obj.AlignmentId == alignment_id:\n                                    pv_name = get_name_safe(obj)\n                                    handle_str = obj.Handle.ToString()\n                                    return handle_str, oid, pv_name\n                            except Exception:\n                                pass\n                    except Exception:\n                        pass\n            except Exception:\n                pass\n    except Exception as ex:\n        log.append(\"  [{}] scan PV: {}\".format(align_name, str(ex)[:120]))\n\n    return None, None, None\n\n\n# ============================================================================\n# Main\n# ============================================================================\n\ndoc = Application.DocumentManager.MdiActiveDocument\ndb  = doc.Database\n\n# Recolectar datos: mapping pv_handle -> (pv_name, align_name, [fl_handles])\nmapping = []   # list of (pv_handle, pv_name, align_name, [fl_handles])\nn_fl_total = 0\nn_fl_matched = 0\nn_pv_with_fls = 0\n\nlck = doc.LockDocument()\ntr  = db.TransactionManager.StartTransaction()\ntry:\n    cdoc = CivilApplication.ActiveDocument\n\n    # -----------------------------------------------------------------------\n    # 1. Recolectar todas las FeatureLines cuyo NOMBRE matchee los patrones\n    # -----------------------------------------------------------------------\n    # FeatureLines pueden estar en Sites (no siempre en ModelSpace directo).\n    # Barremos BlockTable y tambien GetFeatureLineIds() de cada Site.\n    # Filtrado SOLO por nombre — la capa depende del CLAYER activo cuando\n    # se crearon y puede variar; el nombre es determinista (lo pone el\n    # pipeline: FL_Txx, FL_Cxx).\n    fl_info = []   # list of (handle_str, midx, midy, dirx, diry, name)\n    fl_layer_stats = {}   # layer_name -> count (para diagnostico)\n    fl_name_samples = {}  # layer_name -> set(ejemplos de nombres)\n\n    # Contadores de diagnostico para cada fase de la ingesta\n    _counters = {\n        \"total_fls_seen\": 0,\n        \"name_matched\":   0,\n        \"geom_ok\":        0,\n        \"geom_fail\":      0,\n    }\n    _first_geom_err = [None]   # usar lista para poder asignar desde inner fn\n\n    def get_fl_polyline_2d(fl):\n        \"\"\"Devuelve [(x,y),(x,y),...] con al menos 2 puntos, o None + error.\n        Intenta 5 metodos distintos porque la firma de GetPoints varia entre\n        versiones de Civil 3D y pythonnet no siempre unifica los enums.\n        \"\"\"\n        errors = []\n\n        # Metodo 1: StartPoint / EndPoint (propiedades, siempre presentes)\n        try:\n            sp = fl.StartPoint\n            ep = fl.EndPoint\n            return [(float(sp.X), float(sp.Y)),\n                    (float(ep.X), float(ep.Y))], None\n        except Exception as e:\n            errors.append(\"StartPoint/EndPoint: \" + str(e)[:100])\n\n        # Metodo 2: GetPoints() sin argumentos\n        try:\n            pts_raw = fl.GetPoints()\n            pts = [(float(p.X), float(p.Y)) for p in pts_raw]\n            if len(pts) >= 2:\n                return pts, None\n            errors.append(\"GetPoints(): solo {} pts\".format(len(pts)))\n        except Exception as e:\n            errors.append(\"GetPoints(): \" + str(e)[:100])\n\n        # Metodo 3: GetPoints(FeatureLinePointType.AllPoints)\n        try:\n            from Autodesk.Civil import FeatureLinePointType\n            pts_raw = fl.GetPoints(FeatureLinePointType.AllPoints)\n            pts = [(float(p.X), float(p.Y)) for p in pts_raw]\n            if len(pts) >= 2:\n                return pts, None\n            errors.append(\"GetPoints(AllPoints): solo {} pts\".format(\n                len(pts)))\n        except Exception as e:\n            errors.append(\"GetPoints(AllPoints): \" + str(e)[:100])\n\n        # Metodo 4: GetPoints(FeatureLinePointType.PIPoint)\n        try:\n            from Autodesk.Civil import FeatureLinePointType\n            pts_raw = fl.GetPoints(FeatureLinePointType.PIPoint)\n            pts = [(float(p.X), float(p.Y)) for p in pts_raw]\n            if len(pts) >= 2:\n                return pts, None\n        except Exception as e:\n            errors.append(\"GetPoints(PIPoint): \" + str(e)[:100])\n\n        # Metodo 5: reflexion para descubrir la firma real\n        try:\n            ct = clr.GetClrType(fl.GetType())\n            sigs = []\n            for m in ct.GetMethods():\n                if m.Name == \"GetPoints\":\n                    ps = m.GetParameters()\n                    sigs.append(\"GetPoints({})\".format(\n                        \",\".join(p.ParameterType.Name for p in ps)))\n            errors.append(\"reflexion: \" + \" | \".join(sigs[:3]))\n        except Exception:\n            pass\n\n        return None, \" || \".join(errors)\n\n    def ingest_fl_object(fl):\n        _counters[\"total_fls_seen\"] += 1\n        try:\n            actual_layer = fl.Layer\n        except Exception:\n            actual_layer = \"<?>\"\n        try:\n            fl_name = fl.Name\n        except Exception:\n            fl_name = None\n        fl_layer_stats[actual_layer] = fl_layer_stats.get(actual_layer, 0) + 1\n        if fl_name:\n            samples = fl_name_samples.setdefault(actual_layer, set())\n            if len(samples) < 3:\n                samples.add(fl_name)\n        # Debug: grabar los primeros N casos de match check\n        matched = _fl_name_matches(fl_name)\n        if len(_match_debug) < _MATCH_DEBUG_N:\n            _match_debug.append((repr(fl_name), matched))\n        if not matched:\n            return\n        _counters[\"name_matched\"] += 1\n\n        # Extraer geometria\n        pts, err = get_fl_polyline_2d(fl)\n        if pts is None or len(pts) < 2:\n            _counters[\"geom_fail\"] += 1\n            if _first_geom_err[0] is None and err:\n                _first_geom_err[0] = err\n            return\n\n        try:\n            xs = [p[0] for p in pts]\n            ys = [p[1] for p in pts]\n            midx = (xs[0] + xs[-1]) / 2.0\n            midy = (ys[0] + ys[-1]) / 2.0\n            dx   = xs[-1] - xs[0]\n            dy   = ys[-1] - ys[0]\n            length = (dx * dx + dy * dy) ** 0.5\n            if length < 1e-6:\n                _counters[\"geom_fail\"] += 1\n                if _first_geom_err[0] is None:\n                    _first_geom_err[0] = \"length~0\"\n                return\n            handle = fl.Handle.ToString()\n            fl_info.append((handle, midx, midy, dx / length, dy / length,\n                            fl_name))\n            _counters[\"geom_ok\"] += 1\n        except Exception as e:\n            _counters[\"geom_fail\"] += 1\n            if _first_geom_err[0] is None:\n                _first_geom_err[0] = \"post-geom: \" + str(e)[:120]\n\n    # 1a. ModelSpace + todos los BlockTableRecords (por si FLs estan en sites)\n    try:\n        bt = tr.GetObject(db.BlockTableId, OpenMode.ForRead)\n        for btr_id in bt:\n            try:\n                btr = tr.GetObject(btr_id, OpenMode.ForRead)\n                for oid in btr:\n                    try:\n                        obj = tr.GetObject(oid, OpenMode.ForRead)\n                        if isinstance(obj, FeatureLine):\n                            ingest_fl_object(obj)\n                    except Exception:\n                        pass\n            except Exception:\n                pass\n    except Exception as ex:\n        log.append(\"WARN: scan BlockTable: {}\".format(str(ex)[:120]))\n\n    # 1b. Sites (algunas FeatureLines estan asociadas a Site y no aparecen\n    #     en ModelSpace durante el iterate). Buscar tambien via Sites.\n    try:\n        site_ids = cdoc.GetSiteIds()\n        for i in range(site_ids.Count):\n            try:\n                sid = site_ids.get_Item(i)\n            except Exception:\n                try:\n                    sid = site_ids[i]\n                except Exception:\n                    continue\n            try:\n                site = tr.GetObject(sid, OpenMode.ForRead)\n                fl_coll = site.GetFeatureLineIds()\n                for j in range(fl_coll.Count):\n                    try:\n                        fid = fl_coll.get_Item(j)\n                    except Exception:\n                        try:\n                            fid = fl_coll[j]\n                        except Exception:\n                            continue\n                    try:\n                        fl = tr.GetObject(fid, OpenMode.ForRead)\n                        if isinstance(fl, FeatureLine):\n                            # Evitar duplicados: comprobamos que no este ya\n                            h = fl.Handle.ToString()\n                            if not any(x[0] == h for x in fl_info):\n                                ingest_fl_object(fl)\n                    except Exception:\n                        pass\n            except Exception:\n                pass\n    except Exception:\n        pass\n\n    n_fl_total = len(fl_info)\n    log.append(\"FeatureLines que matchean patron(es) {}: {}\".format(\n        _pat_list, n_fl_total))\n\n    # Contadores por fase\n    log.append(\"  FLs totales vistas:         {}\".format(\n        _counters[\"total_fls_seen\"]))\n    log.append(\"  FLs que matchean nombre:    {}\".format(\n        _counters[\"name_matched\"]))\n    log.append(\"  FLs con geometria OK:       {}\".format(\n        _counters[\"geom_ok\"]))\n    log.append(\"  FLs con geometria FAIL:     {}\".format(\n        _counters[\"geom_fail\"]))\n    if _first_geom_err[0]:\n        log.append(\"  Primer error geometria:   {}\".format(\n            _first_geom_err[0]))\n\n    # Debug de match: para las primeras 5 FLs, mostrar el nombre tal cual se\n    # leyo y si paso el filtro. Permite localizar bugs de encoding / closures.\n    if _match_debug:\n        log.append(\"\")\n        log.append(\"DEBUG match (primeras {} FLs):\".format(len(_match_debug)))\n        for rep, m in _match_debug:\n            log.append(\"  name={}  -> match={}\".format(rep, m))\n\n    # Mostrar SIEMPRE las capas donde hay FLs + ejemplos de nombres.\n    # Asi, aunque el match haya funcionado, el usuario ve que hay otras FLs\n    # y puede decidir si extender el patron.\n    if fl_layer_stats:\n        log.append(\"\")\n        log.append(\"Inventario de FLs en el dibujo:\")\n        for lyr, cnt in sorted(fl_layer_stats.items(), key=lambda kv: -kv[1]):\n            samples = fl_name_samples.get(lyr, set())\n            ejemplos = \", \".join(sorted(samples)) if samples else \"(sin nombre)\"\n            log.append(\"  capa '{}': {} FL(s) | ej. nombres: {}\".format(\n                lyr, cnt, ejemplos))\n\n    if n_fl_total == 0:\n        log.append(\"\")\n        log.append(\"ABORT: ninguna FL matchea el patron. Ajusta IN[1].\")\n\n    # -----------------------------------------------------------------------\n    # 2. Iteramos PERFIL VIEWS (no alignments): cada item en IN[0] es un\n    #    NOMBRE DE PROFILE VIEW. Para cada PV sacamos su alignment via\n    #    pv.AlignmentId -- eso evita unwrappear wrappers y da la relacion\n    #    1:1 PV-alignment garantizada por Civil 3D.\n    # -----------------------------------------------------------------------\n    matched_fl_handles = set()  # evitar proyectar la misma FL en varias PVs\n    first_diag_iter = True\n\n    # Construir un indice PV-by-name una sola vez para no iterar BT N veces\n    # Guardamos tambien el PUNTO DE INSERCION (pv.Location) — el origen\n    # geometrico de la rejilla. Ese punto es EXCLUSIVO de la PV (no solapa\n    # con MDT, etiquetas, otros objetos), y por tanto es el candidato\n    # ideal para el \"click sintetico\" que le hacemos al comando LISP.\n    pv_by_name = {}   # name -> (pv_obj, pv_handle_str, alignment_id, loc_xy)\n    pv_loc_debug = []  # primeras 3 muestras para log\n    try:\n        bt = tr.GetObject(db.BlockTableId, OpenMode.ForRead)\n        for btr_id in bt:\n            try:\n                btr = tr.GetObject(btr_id, OpenMode.ForRead)\n                for oid in btr:\n                    try:\n                        obj = tr.GetObject(oid, OpenMode.ForRead)\n                        if isinstance(obj, ProfileView):\n                            try:\n                                pname = obj.Name\n                                phandle = obj.Handle.ToString()\n                                paid = obj.AlignmentId\n                                # Extraer punto de insercion. La propiedad\n                                # varia: algunas versiones lo llaman Location,\n                                # otras LocationPoint. Probamos en cadena.\n                                loc_xy = None\n                                for prop_name in (\"Location\",\n                                                  \"LocationPoint\"):\n                                    try:\n                                        pt = getattr(obj, prop_name)\n                                        loc_xy = (float(pt.X), float(pt.Y))\n                                        break\n                                    except Exception:\n                                        continue\n                                pv_by_name[pname] = (obj, phandle, paid,\n                                                     loc_xy)\n                                if len(pv_loc_debug) < 3 and loc_xy:\n                                    pv_loc_debug.append(\n                                        (pname, loc_xy))\n                            except Exception:\n                                pass\n                    except Exception:\n                        pass\n            except Exception:\n                pass\n    except Exception as ex:\n        log.append(\"WARN: index PVs: {}\".format(str(ex)[:120]))\n\n    log.append(\"\")\n    log.append(\"PVs indexadas: {}\".format(len(pv_by_name)))\n    if pv_loc_debug:\n        log.append(\"  Puntos de insercion (muestras):\")\n        for nm, xy in pv_loc_debug:\n            log.append(\"    {} -> X={:.3f} Y={:.3f}\".format(\n                nm, xy[0], xy[1]))\n\n    for idx, item in enumerate(alignments):\n        # En el merged pipeline, `item` es un nombre de PV (p.ej. 'PV_C01_01').\n        # Tambien podriamos haber recibido un wrapper — intentar extraer .Name.\n        pv_name = None\n        if isinstance(item, str):\n            pv_name = item.strip()\n        else:\n            # Probar atributo Name\n            try:\n                pv_name = str(item.Name)\n            except Exception:\n                pv_name = None\n\n        if not pv_name:\n            log.append(\"[{}] item sin nombre legible ({}), skip\".format(\n                idx, type(item).__name__))\n            continue\n\n        if pv_name not in pv_by_name:\n            log.append(\"[{}] PV '{}' no localizada en el dibujo, skip\".format(\n                idx, pv_name))\n            continue\n\n        pv_obj, pv_handle, aid, pv_loc = pv_by_name[pv_name]\n        # Obtener alignment\n        try:\n            align = tr.GetObject(aid, OpenMode.ForRead)\n            aname = align.Name\n        except Exception as ex:\n            log.append(\"[{}] PV '{}': no puedo abrir alignment: {}\".format(\n                idx, pv_name, str(ex)[:120]))\n            continue\n\n        # Muestrear vertices del alignment (diag detallado solo la 1a vez)\n        poly_pts = align_vertices_2d(\n            align, log=log, diagnose=first_diag_iter)\n        first_diag_iter = False\n        if len(poly_pts) < 2:\n            log.append(\"[{}] PV '{}' align '{}': PointLocation fallo \"\n                       \"({} vertices), skip\".format(\n                           idx, pv_name, aname, len(poly_pts)))\n            continue\n\n        # Buscar FLs cercanas al alignment\n        fl_hs_matched = []\n        for (h, midx, midy, dx, dy, fname) in fl_info:\n            if h in matched_fl_handles:\n                continue\n            d = min_distance_point_to_polyline(midx, midy, poly_pts)\n            if d <= tolerance:\n                fl_hs_matched.append(h)\n                matched_fl_handles.add(h)\n\n        if fl_hs_matched:\n            mapping.append((pv_handle, pv_name, aname, fl_hs_matched,\n                            pv_loc))\n            n_fl_matched += len(fl_hs_matched)\n            n_pv_with_fls += 1\n            log.append(\"[{}] PV '{}' <- {} FLs (align '{}')\".format(\n                idx, pv_name, len(fl_hs_matched), aname))\n        else:\n            log.append(\"[{}] PV '{}' sin FLs dentro de tolerancia \"\n                       \"(align '{}')\".format(idx, pv_name, aname))\n\n    tr.Commit()\nexcept Exception:\n    log.append(\"ERROR matching: \" + traceback.format_exc())\n    try:\n        tr.Abort()\n    except Exception:\n        pass\nfinally:\n    try:\n        tr.Dispose()\n    except Exception:\n        pass\n    try:\n        lck.Dispose()\n    except Exception:\n        pass\n\n\nlog.append(\"\")\nlog.append(\"=== RESUMEN MATCHING ===\")\nlog.append(\"PVs con FLs matched: {}\".format(n_pv_with_fls))\nlog.append(\"Total FLs matched:  {}\".format(n_fl_matched))\nlog.append(\"FLs sin match:      {}\".format(n_fl_total - n_fl_matched))\n\n\n# ============================================================================\n# 3. Escribir archivo temporal con el mapping\n# ============================================================================\n# Formato:\n#   pv_handle|fl_handle1,fl_handle2,...\n#\n# Una linea por PV.\n# ============================================================================\ncmd_preview = \"\"\ntry:\n    if mapping:\n        with open(tmp_file, \"w\") as f:\n            for (pv_h, pv_n, aname, fl_hs, pv_loc) in mapping:\n                if pv_loc is None:\n                    # No debe pasar, pero nos protegemos\n                    log.append(\"WARN: PV {} sin pv_loc, se omite\".format(pv_h))\n                    continue\n                # Formato: handle|X|Y|fl_h1,fl_h2,...\n                f.write(\"{}|{}|{}|{}\\n\".format(\n                    pv_h, pv_loc[0], pv_loc[1],\n                    \",\".join(fl_hs)))\n        log.append(\"\")\n        log.append(\"Archivo temp escrito: {} ({} lineas)\".format(\n            tmp_file, len(mapping)))\n    else:\n        log.append(\"Sin mapping, no se envia LISP.\")\nexcept Exception as ex:\n    log.append(\"ERROR escribir temp: \" + str(ex))\n\n\n# ============================================================================\n# 4. Construir y enviar LISP\n# ============================================================================\n# El LISP:\n#   1. Opcional: FILEDIA/CMDDIA=0 (best effort, NO suele funcionar).\n#   2. Opcional: (initcommandversion 2) para forzar la ultima version.\n#   3. Por cada linea del archivo:\n#      a. Parsea pv_handle y fl_handles.\n#      b. Construye SelectionSet con los FL (via handent).\n#      c. Obtiene ename del PV (via handent).\n#      d. Llama (command \"_.AECCPROJECTOBJECTSTOPROF\" ss \"\" pv_ent \"\").\n#      e. El dialogo modal aparecera -- pulsar OK.\n# ============================================================================\n\nif mapping:\n    lisp_path = tmp_file.replace(\".txt\", \".lsp\")\n    tmp_file_lisp = tmp_file.replace(\"\\\\\", \"/\")   # LISP prefiere forward slashes\n    lisp_path_fwd = lisp_path.replace(\"\\\\\", \"/\")\n\n    # Construir LISP. Lo escribimos a un archivo y cargamos con (load ...)\n    # para evitar problemas de escape en SendStringToExecute.\n\n    lisp_code = '''(defun PROYECTAR-FL-A-PERFILES ( / f ln pos pos2 pv_h fl_str fl_list ss pv_e h ename nfl n_ok n_fail res1 res2 err_msg)\n  ;; --- IMPORTANTE: funcion SIN prefijo c: para que NO sea un comando ---\n  ;; Asi al invocarla con (PROYECTAR-FL-A-PERFILES) AutoCAD la evalua como\n  ;; expresion LISP, CMDACTIVE=0, y (command ...) anidado funciona.\n  (setvar \"CMDECHO\" 1)\n  (setq n_ok 0 n_fail 0)\n  (setq f (open \"__TMP_FILE__\" \"r\"))\n  (if (null f)\n    (progn (princ \"\\\\nERROR: no abro archivo __TMP_FILE__\") (princ))\n    (progn\n      (while (setq ln (read-line f))\n        ;; Linea: pv_handle|X|Y|fl_h1,fl_h2,...\n        ;; Los 4 campos se separan por \"|\" (ascii 124).\n        (setq pv_h nil x_str nil y_str nil fl_str nil)\n        (setq p1 (vl-string-position 124 ln))\n        (if p1\n          (progn\n            (setq pv_h (substr ln 1 p1))\n            (setq rest1 (substr ln (+ p1 2)))\n            (setq p2 (vl-string-position 124 rest1))\n            (if p2\n              (progn\n                (setq x_str (substr rest1 1 p2))\n                (setq rest2 (substr rest1 (+ p2 2)))\n                (setq p3 (vl-string-position 124 rest2))\n                (if p3\n                  (progn\n                    (setq y_str (substr rest2 1 p3))\n                    (setq fl_str (substr rest2 (+ p3 2))))))))\n)\n        (if (and pv_h x_str y_str fl_str)\n          (progn\n            ;; Parsear X e Y a numeros reales\n            (setq pv_pt (list (atof x_str) (atof y_str) 0.0))\n\n            ;; Split fl_str por \",\" (ascii 44)\n            (setq fl_list (list))\n            (while (setq pos2 (vl-string-position 44 fl_str))\n              (setq fl_list (cons (substr fl_str 1 pos2) fl_list))\n              (setq fl_str (substr fl_str (+ pos2 2))))\n            (if (> (strlen fl_str) 0)\n              (setq fl_list (cons fl_str fl_list)))\n            (setq fl_list (reverse fl_list))\n\n            ;; Construir SelectionSet con las FeatureLines\n            (setq ss (ssadd))\n            (setq nfl 0)\n            (foreach h fl_list\n              (setq ename (handent h))\n              (if ename\n                (progn (ssadd ename ss) (setq nfl (1+ nfl)))))\n\n            ;; Obtener entity del PV (para zoom a su bbox)\n            (setq pv_e (handent pv_h))\n\n            (if (and pv_e (> nfl 0))\n              (progn\n                (princ (strcat \"\\\\n>>> PV \" pv_h\n                               \" pt=(\" x_str \",\" y_str \")\"\n                               \" <- \" (itoa nfl) \" FLs ... \"))\n\n                ;; 1. Zoom a la PV (segun bbox del objeto) para que el\n                ;;    punto caiga dentro del viewport visible.\n                (vl-catch-all-apply\n                  '(lambda ()\n                     (setq bb_obj (vlax-ename->vla-object pv_e))\n                     (setq minpt (vlax-make-safearray vlax-vbDouble '(0 . 2)))\n                     (setq maxpt (vlax-make-safearray vlax-vbDouble '(0 . 2)))\n                     (vla-GetBoundingBox bb_obj 'minpt 'maxpt)\n                     (setq mn (vlax-safearray->list minpt))\n                     (setq mx (vlax-safearray->list maxpt))\n                     (setq w (- (nth 0 mx) (nth 0 mn)))\n                     (setq hh (- (nth 1 mx) (nth 1 mn)))\n                     (setq mar_x (* w 0.15))\n                     (setq mar_y (* hh 0.15))\n                     (vl-cmdf \"_.ZOOM\" \"_W\"\n                       (list (- (nth 0 mn) mar_x) (- (nth 1 mn) mar_y))\n                       (list (+ (nth 0 mx) mar_x) (+ (nth 1 mx) mar_y)))))\n\n                ;; 2. Preseleccion + comando con el PUNTO DE INSERCION\n                ;;    que Python calculo (propiedad Location de la PV).\n                ;;    Ese punto es el origen de la rejilla — cae siempre\n                ;;    sobre la PV y solo sobre la PV.\n                (sssetfirst nil ss)\n                (setq res1\n                  (vl-catch-all-apply 'vl-cmdf\n                    (list \"_.AECCPROJECTOBJECTSTOPROF\" pv_pt \"\")))\n                (if (not (vl-catch-all-error-p res1))\n                  (progn\n                    (princ \"OK\")\n                    (setq n_ok (1+ n_ok)))\n                  (progn\n                    (princ (strcat \"FAIL err=\"\n                                   (vl-catch-all-error-message res1)))\n                    (setq n_fail (1+ n_fail))))\n                (sssetfirst nil nil))\n              (progn\n                (princ (strcat \"\\\\n    SKIP: PV=\" pv_h\n                               \" FL count=\" (itoa nfl)))\n                (setq n_fail (1+ n_fail)))))))\n      (close f)))\n  (princ (strcat \"\\\\n\\\\n=== PROYECTAR-FL: OK=\" (itoa n_ok)\n                 \" FAIL=\" (itoa n_fail) \" ===\"))\n  (princ)\n)\n'''.replace(\"__TMP_FILE__\", tmp_file_lisp)\n\n    # Escribir el LISP\n    try:\n        with open(lisp_path, \"w\") as f:\n            f.write(lisp_code)\n        log.append(\"LISP escrito: {}\".format(lisp_path))\n    except Exception as ex:\n        log.append(\"ERROR escribir LISP: \" + str(ex))\n        mapping = []   # impedir el SendStringToExecute\n\nif mapping:\n    # ========================================================================\n    # AUTO-OK: lanzar PowerShell en paralelo para pulsar Enter en cada dialogo\n    # ========================================================================\n    # Se ejecuta ANTES del SendStringToExecute del LISP, como proceso\n    # detached, para que ya este monitorizando cuando el LISP empiece a\n    # disparar comandos.\n    # ========================================================================\n    if auto_ok:\n        ps_path = tmp_file.replace(\".txt\", \"_auto_ok.ps1\")\n        n_dialogs = len(mapping)   # maximo de Enter a enviar\n        ps_code = r\"\"\"# Auto-OK v4: Win32 nativo para dialogos MFC de Civil 3D.\n# El dialogo Project Objects To Profile View es un dialogo MFC clasico:\n# sus botones son CButton de Win32, no elementos WPF/UIA. Por eso el\n# walker UIAutomation los ve vacios. Solucion: localizar los hijos con\n# EnumChildWindows y hacerles BM_CLICK directamente via Win32.\n\nparam(\n    [int]$MaxPresses = __MAXPRESSES__,\n    [int]$TimeoutSec = 600\n)\n\n$ErrorActionPreference = \"SilentlyContinue\"\n$logPath = \"__LOG_PATH__\"\n\nfunction Write-Log {\n    param([string]$msg)\n    \"[$(Get-Date -Format HH:mm:ss.fff)] $msg\" |\n        Out-File -FilePath $logPath -Encoding UTF8 -Append\n}\n\n\"\" | Out-File -FilePath $logPath -Encoding UTF8\nWrite-Log \"Auto-OK v4 (Win32 nativo) iniciado. MaxPresses=$MaxPresses\"\n\n$winapi = @'\nusing System;\nusing System.Collections.Generic;\nusing System.Runtime.InteropServices;\nusing System.Text;\npublic class Win {\n    public delegate bool EnumWindowsProc(IntPtr hWnd, IntPtr lParam);\n    [DllImport(\"user32.dll\")]\n    public static extern bool EnumWindows(EnumWindowsProc callback, IntPtr lParam);\n    [DllImport(\"user32.dll\")]\n    public static extern bool EnumChildWindows(IntPtr hWndParent, EnumWindowsProc callback, IntPtr lParam);\n    [DllImport(\"user32.dll\", CharSet = CharSet.Auto)]\n    public static extern int GetWindowText(IntPtr hWnd, StringBuilder text, int count);\n    [DllImport(\"user32.dll\", CharSet = CharSet.Auto)]\n    public static extern int GetClassName(IntPtr hWnd, StringBuilder text, int count);\n    [DllImport(\"user32.dll\")]\n    public static extern bool IsWindowVisible(IntPtr hWnd);\n    [DllImport(\"user32.dll\")]\n    public static extern bool IsWindowEnabled(IntPtr hWnd);\n    [DllImport(\"user32.dll\")]\n    public static extern int GetDlgCtrlID(IntPtr hwndCtl);\n    [DllImport(\"user32.dll\", CharSet = CharSet.Auto)]\n    public static extern IntPtr SendMessage(IntPtr hWnd, uint Msg, IntPtr wParam, IntPtr lParam);\n    [DllImport(\"user32.dll\")]\n    public static extern bool PostMessage(IntPtr hWnd, uint Msg, IntPtr wParam, IntPtr lParam);\n\n    public const uint BM_CLICK   = 0x00F5;\n    public const uint WM_COMMAND = 0x0111;\n\n    public static List<IntPtr> topHwnds = new List<IntPtr>();\n    public static List<IntPtr> ListVisible() {\n        topHwnds.Clear();\n        EnumWindows(new EnumWindowsProc(EnumTopCallback), IntPtr.Zero);\n        return topHwnds;\n    }\n    private static bool EnumTopCallback(IntPtr hWnd, IntPtr lParam) {\n        if (IsWindowVisible(hWnd)) {\n            StringBuilder sb = new StringBuilder(512);\n            GetWindowText(hWnd, sb, 512);\n            if (sb.Length > 0) {\n                topHwnds.Add(hWnd);\n            }\n        }\n        return true;\n    }\n\n    public static List<IntPtr> childHwnds = new List<IntPtr>();\n    public static List<IntPtr> ListChildren(IntPtr parent) {\n        childHwnds.Clear();\n        EnumChildWindows(parent, new EnumWindowsProc(EnumChildCallback), IntPtr.Zero);\n        return childHwnds;\n    }\n    private static bool EnumChildCallback(IntPtr hWnd, IntPtr lParam) {\n        childHwnds.Add(hWnd);\n        return true;\n    }\n\n    public static string GetTitle(IntPtr hWnd) {\n        StringBuilder sb = new StringBuilder(512);\n        GetWindowText(hWnd, sb, 512);\n        return sb.ToString();\n    }\n    public static string GetClass(IntPtr hWnd) {\n        StringBuilder sb = new StringBuilder(256);\n        GetClassName(hWnd, sb, 256);\n        return sb.ToString();\n    }\n}\n'@\ntry {\n    Add-Type -TypeDefinition $winapi\n    Write-Log \"WinAPI wrapper cargado\"\n} catch {\n    Write-Log \"ERROR cargando WinAPI: $($_.Exception.Message)\"\n    exit 1\n}\n\n$titlePatterns = @(\n    \"Project Objects\",\n    \"Proyectar objetos\",\n    \"proyectar objetos\"\n)\n$okLabels = @(\"OK\", \"Ok\", \"Aceptar\", \"Accept\", \"&OK\", \"&Aceptar\")\n\n$endTime = (Get-Date).AddSeconds($TimeoutSec)\n$pressCount = 0\n$lastHwnd = [IntPtr]::Zero\n$noDialogStreak = 0\n$firstDump = $true\n\nfunction Find-DialogHwnd {\n    $hwnds = [Win]::ListVisible()\n    foreach ($h in $hwnds) {\n        $t = [Win]::GetTitle($h)\n        if ($t) {\n            foreach ($pat in $titlePatterns) {\n                if ($t.ToLower().Contains($pat.ToLower())) {\n                    return @{ Hwnd = $h; Title = $t }\n                }\n            }\n        }\n    }\n    return $null\n}\n\nfunction Find-OK-Child {\n    param($dialogHwnd, [bool]$dumpAll = $false)\n    $children = [Win]::ListChildren($dialogHwnd)\n    $buttons = @()\n    foreach ($c in $children) {\n        $cls = [Win]::GetClass($c)\n        $vis = [Win]::IsWindowVisible($c)\n        $ena = [Win]::IsWindowEnabled($c)\n        $txt = [Win]::GetTitle($c)\n        $id  = [Win]::GetDlgCtrlID($c)\n        if ($cls -eq \"Button\" -and $vis -and $ena) {\n            $buttons += @{ Hwnd = $c; Class = $cls; Text = $txt; Id = $id }\n        }\n    }\n    if ($dumpAll) {\n        Write-Log \"    Botones ENABLED del dialogo ($($buttons.Count)):\"\n        foreach ($b in $buttons) {\n            Write-Log (\"      hwnd=0x{0:X} id={1} text='{2}'\" -f\n                       $b.Hwnd.ToInt64(), $b.Id, $b.Text)\n        }\n    }\n\n    # Estrategia 1: texto exacto OK/Aceptar/...\n    foreach ($lbl in $okLabels) {\n        foreach ($b in $buttons) {\n            if ($b.Text -eq $lbl) { return $b }\n        }\n    }\n    # Estrategia 2: normalizar (quitar &) y comparar\n    foreach ($b in $buttons) {\n        $t = $b.Text\n        if (-not $t) { continue }\n        $normalized = $t.Replace(\"&\", \"\").ToLower()\n        if ($normalized -eq \"ok\" -or $normalized -eq \"aceptar\" -or\n            $normalized -eq \"accept\") { return $b }\n    }\n    # Estrategia 3: dlg ctrl id == 1 (IDOK clasico)\n    foreach ($b in $buttons) {\n        if ($b.Id -eq 1) { return $b }\n    }\n    return $null\n}\n\nfunction Click-Via-Win32 {\n    param($dialogHwnd, $btn)\n    # Metodo A: BM_CLICK directo al boton\n    try {\n        [Win]::SendMessage($btn.Hwnd, [Win]::BM_CLICK,\n                           [IntPtr]::Zero, [IntPtr]::Zero) | Out-Null\n        return \"BM_CLICK\"\n    } catch {\n        Write-Log \"    BM_CLICK fallo: $($_.Exception.Message)\"\n    }\n    # Metodo B: WM_COMMAND al padre con el ID del boton en wParam\n    try {\n        $wp = [IntPtr]::new($btn.Id)\n        [Win]::SendMessage($dialogHwnd, [Win]::WM_COMMAND,\n                           $wp, $btn.Hwnd) | Out-Null\n        return \"WM_COMMAND\"\n    } catch {\n        Write-Log \"    WM_COMMAND fallo: $($_.Exception.Message)\"\n    }\n    return $null\n}\n\nwhile ((Get-Date) -lt $endTime -and $pressCount -lt $MaxPresses) {\n    $found = Find-DialogHwnd\n    if ($found -eq $null) {\n        $noDialogStreak++\n        Start-Sleep -Milliseconds 120\n        if ($pressCount -gt 0 -and $noDialogStreak -gt 170) {\n            Write-Log \"Sin dialogos por 20s tras $pressCount OKs. Salida.\"\n            break\n        }\n        continue\n    }\n    $noDialogStreak = 0\n    $hwnd = $found.Hwnd\n\n    if ($hwnd -eq $lastHwnd) {\n        Start-Sleep -Milliseconds 80\n        continue\n    }\n\n    $dump = $firstDump\n    $btn = Find-OK-Child -dialogHwnd $hwnd -dumpAll $dump\n    $firstDump = $false\n\n    if ($btn -eq $null) {\n        Write-Log (\"DIALOGO hwnd=0x{0:X} titulo='{1}' -> sin boton OK identificable\" -f\n                   $hwnd.ToInt64(), $found.Title)\n        Start-Sleep -Milliseconds 200\n        $firstDump = $true\n        continue\n    }\n\n    Write-Log (\"DIALOGO hwnd=0x{0:X} titulo='{1}' btn hwnd=0x{2:X} text='{3}' id={4}\" -f\n               $hwnd.ToInt64(), $found.Title,\n               $btn.Hwnd.ToInt64(), $btn.Text, $btn.Id)\n\n    $method = Click-Via-Win32 $hwnd $btn\n    if ($method -ne $null) {\n        $pressCount++\n        $lastHwnd = $hwnd\n        Write-Log \"  OK #$pressCount via $method\"\n        Start-Sleep -Milliseconds 400\n        $lastHwnd = [IntPtr]::Zero\n    } else {\n        Write-Log \"  no pude invocar OK\"\n        Start-Sleep -Milliseconds 200\n    }\n}\n\nWrite-Log \"Auto-OK terminado. Total presses=$pressCount\"\n\"\"\".replace(\"__MAXPRESSES__\", str(n_dialogs)) \\\n   .replace(\"__LOG_PATH__\",\n            ps_path.replace(\".ps1\", \"_log.txt\").replace(\"\\\\\", \"\\\\\\\\\"))\n\n        # Estrategia robusta de escritura y lanzamiento del PS1.\n        # Hasta 3 ubicaciones por si la principal esta bloqueada (archivo\n        # abierto por sesion anterior, permisos de C:\\Temp, etc).\n        import os as _os\n        import tempfile as _tempfile\n        import subprocess\n        import time as _time\n\n        # Generamos un nombre unico con timestamp + PID para no colisionar\n        _stamp = _time.strftime(\"%Y%m%d_%H%M%S\")\n        _pid = _os.getpid()\n        _unique_suffix = \"_{}_{}\".format(_stamp, _pid)\n\n        candidate_paths = []\n        # 1) Junto al tmp_file pero con sufijo unico\n        _base = tmp_file.replace(\".txt\", \"\")\n        candidate_paths.append(_base + _unique_suffix + \"_auto_ok.ps1\")\n        # 2) Directorio temp de usuario (siempre escribible)\n        candidate_paths.append(_os.path.join(\n            _tempfile.gettempdir(),\n            \"proyeccion_fl{}_auto_ok.ps1\".format(_unique_suffix)))\n        # 3) ProgramData como ultimo recurso\n        candidate_paths.append(_os.path.join(\n            _os.environ.get(\"PROGRAMDATA\", r\"C:\\ProgramData\"),\n            \"proyeccion_fl{}_auto_ok.ps1\".format(_unique_suffix)))\n\n        ps_path = None\n        _write_error = None\n        for _cand in candidate_paths:\n            try:\n                _cand_dir = _os.path.dirname(_cand)\n                if _cand_dir and not _os.path.isdir(_cand_dir):\n                    _os.makedirs(_cand_dir)\n                # Regenerar ps_code con log path correcto para este cand\n                _log_path = _cand.replace(\".ps1\", \"_log.txt\")\n                _ps_code_resolved = ps_code.replace(\n                    tmp_file.replace(\".txt\", \"_auto_ok_log.txt\").replace(\n                        \"\\\\\", \"\\\\\\\\\"),\n                    _log_path.replace(\"\\\\\", \"\\\\\\\\\"))\n                with open(_cand, \"w\", encoding=\"utf-8\") as _f:\n                    _f.write(_ps_code_resolved)\n                ps_path = _cand\n                break\n            except Exception as _ex:\n                _write_error = _ex\n\n        if ps_path is None:\n            log.append(\"WARN: no pude escribir Auto-OK PS en NINGUNA ruta. \"\n                       \"Ultimo error: {}\".format(_write_error))\n            log.append(\"  -> deberas pulsar OK manualmente en los dialogos\")\n        else:\n            log.append(\"Script Auto-OK escrito: {}\".format(ps_path))\n            try:\n                CREATE_NO_WINDOW = 0x08000000\n                # -ExecutionPolicy Bypass por si el sistema tiene restringido.\n                # -NoProfile acelera arranque y evita efectos de $PROFILE.\n                _proc = subprocess.Popen(\n                    [\"powershell\",\n                     \"-NoProfile\",\n                     \"-ExecutionPolicy\", \"Bypass\",\n                     \"-WindowStyle\", \"Hidden\",\n                     \"-File\", ps_path],\n                    creationflags=CREATE_NO_WINDOW,\n                    close_fds=True)\n                log.append(\">>> PowerShell auto-OK lanzado en paralelo \"\n                           \"(max {} Enters, timeout 600s)\".format(\n                               n_dialogs))\n                log.append(\">>> Log Auto-OK en: {}\".format(\n                    ps_path.replace(\".ps1\", \"_log.txt\")))\n                log.append(\">>> PowerShell PID: {}\".format(_proc.pid))\n\n                # Dar ~1.5s para que arranque y escriba la primera linea\n                # en el log. Permite diagnosticar errores tempranos de\n                # carga de UIAutomation.\n                _time.sleep(1.5)\n                _ps_log = ps_path.replace(\".ps1\", \"_log.txt\")\n                try:\n                    if _os.path.isfile(_ps_log):\n                        with open(_ps_log, \"r\", encoding=\"utf-8\") as _lf:\n                            _early = _lf.read().strip()\n                        if _early:\n                            log.append(\n                                \">>> PowerShell log (arranque):\\n    {}\"\n                                .format(_early.replace(\"\\n\", \"\\n    \")))\n                    else:\n                        log.append(\">>> Log aun no generado tras 1.5s — \"\n                                   \"si al final tampoco lo ves, es que \"\n                                   \"PowerShell fallo al arrancar.\")\n                except Exception as _lex:\n                    log.append(\">>> No pude leer log PS: {}\".format(_lex))\n\n                # Comprobar que el proceso sigue vivo (no se cayo nada mas\n                # arrancar). poll() == None significa vivo.\n                _pr = _proc.poll()\n                if _pr is not None:\n                    log.append(\">>> ALERTA: PowerShell termino ya con \"\n                               \"codigo {}. Posible fallo al cargar \"\n                               \"UIAutomation. Revisa el log.\".format(_pr))\n                else:\n                    log.append(\">>> PowerShell corriendo OK (esperando \"\n                               \"dialogos)\")\n            except Exception as ex:\n                log.append(\"WARN: no pude LANZAR Auto-OK PS: \" + str(ex))\n                log.append(\"  -> deberas pulsar OK manualmente \"\n                           \"en los dialogos\")\n\n    # Construir el comando que se envia a Civil 3D.\n    # Nota: SendStringToExecute se ejecuta DESPUES de que Dynamo termine.\n    # IMPORTANTE: la funcion se invoca SIN el prefijo c: porque no es un\n    # comando, es una funcion LISP normal. Asi evitamos el error\n    # \"bad order function: COMMAND\" que sale al anidar (command ...) dentro\n    # de una funcion c: (comando-dentro-de-comando).\n    full_cmd = '(load \"{}\")\\n(PROYECTAR-FL-A-PERFILES)\\n'.format(\n        lisp_path_fwd)\n\n    cmd_preview = full_cmd\n\n    try:\n        doc.SendStringToExecute(full_cmd, True, False, False)\n        log.append(\"\")\n        log.append(\">>> LISP encolado en AutoCAD.\")\n        log.append(\">>> Se ejecutara al cerrarse Dynamo.\")\n        log.append(\">>> AVISO: aparecera el dialogo 'Project Objects To\")\n        log.append(\">>>        Profile View' por cada PV. Configura el\")\n        log.append(\">>>        estilo de proyeccion la primera vez y luego\")\n        log.append(\">>>        pulsa Enter repetidamente para acelerar.\")\n    except Exception as ex:\n        log.append(\"ERROR SendStringToExecute: \" + str(ex))\n\n\nOUT = [\"\\n\".join(log), cmd_preview]\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
