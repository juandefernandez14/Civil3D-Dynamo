    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
      "Id": "e429ebaf8c7543ab8b2557675f0e21be",
      "NodeType": "FunctionNode",
      "Inputs": [
        {
          "Id": "c3f5c38ffe564de48dade4f53f0f4a34",
          "Name": "name",
          "Description": "The Alignment name. If the names is alredy used it returns the existing Alignment.\n\nstring",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "43cc102216aa403ba08c7f7cc4eb5482",
          "Name": "polyline",
          "Description": "The Polyline used for the alignment\n\nPolyline",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "afe137ed52c0416087f894aa31c0c4e7",
          "Name": "site",
          "Description": "The Site name\n\nstring\nDefault value : \"\" (disabled)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "833c7054650648c88b48b7a9a216f8af",
          "Name": "layer",
          "Description": "The layer name\n\nstring\nDefault value : \"0\" (disabled)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "5ddc109ad6054aad9f6a2e3a3aa599ef",
          "Name": "style",
          "Description": "The Alignment style name\n\nstring\nDefault value : \"\" (disabled)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "429bffd63fa74a98b768116c79691a79",
          "Name": "labelSet",
          "Description": "The label set\n\nstring\nDefault value : \"\" (disabled)",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
