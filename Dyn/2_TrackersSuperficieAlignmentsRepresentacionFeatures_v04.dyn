    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# IN[8]: BARRERA de sincronizacion del nodo NORMALIZAR (contenido ignorado).\n# -*- coding: utf-8 -*-\n# =============================================================================\n# Tracker_Alignments_Merged.dyn - Python1 (Fase 1)  --  UNIFICADO NS / EO\n# Crea polilineas helper en la capa de ejes a partir de contornos y trackers.\n# Mantiene los contornos. Borra los trackers originales al terminar. Borra\n# tambien los ejes previos de la capa de ejes para permitir re-ejecutar limpio.\n#\n# ORIENTACION (IN[7]):\n#   \"NS\" -> mesas verticales. Agrupa por COLUMNAS (X). Eje N->S\n#           (estacionamiento crece de norte a sur). Contornos ordenados\n#           izquierda->derecha (por X minimo).\n#   \"EO\" -> mesas horizontales. Agrupa por FILAS (Y). Eje O->E\n#           (estacionamiento crece de oeste a este). Contornos ordenados\n#           norte->sur (por Y maximo). Filas numeradas norte->sur.\n#   En ambos casos el nombre es AL_Cxx_yy (xx = contorno, yy = grupo).\n#\n# Sin comprobaciones defensivas de \"fuera de contorno\" o \"coincidencia con\n# dos contornos\": el layout lo valida un tecnico antes de ejecutar.\n#\n# Inputs:\n#   IN[0] : str    capa de contornos\n#   IN[1] : str    capa de trackers\n#   IN[2] : str    capa de ejes (e.g. \"EJES\")\n#   IN[3] : float  tolerancia agrupacion (m) -- en NS aplica a X, en EO a Y\n#   IN[4] : float  extension extremos (m)\n#   IN[5] : Document  Dynamo Document (para forzar orden de ejecucion)\n#   IN[6] : any    trigger de orden (Tracker_Surface debe correr antes)\n#   IN[7] : str    orientacion: \"NS\" o \"EO\"\n#\n# Output:\n#   OUT : Document (passthrough)\n# =============================================================================\n\nimport clr\nimport sys\nimport traceback\n\nclr.AddReference('AcMgd')\nclr.AddReference('AcCoreMgd')\nclr.AddReference('AcDbMgd')\n\nfrom Autodesk.AutoCAD.ApplicationServices import Application as AcadApp\nfrom Autodesk.AutoCAD.DatabaseServices import (\n    OpenMode, Polyline, Line, SymbolUtilityServices, ObjectId,\n    LayerTableRecord\n)\nfrom Autodesk.AutoCAD.Geometry import Point2d\n\ncontour_layer = str(IN[0])\ntracker_layer = str(IN[1])\naxis_layer    = str(IN[2])\ngroup_tol     = float(IN[3])\next_m         = float(IN[4])\ndyn_doc_in    = IN[5]\n_surface_trigger = IN[6]   # trigger de orden: Tracker_Surface debe correr antes\norientation   = str(IN[7]).strip().upper() if (len(IN) > 7 and IN[7] is not None) else \"NS\"\n\nlog = []\n\ndef pip(px, py, poly):\n    inside = False\n    n = len(poly)\n    if n < 3:\n        return False\n    j = n - 1\n    for i in range(n):\n        xi, yi = poly[i]\n        xj, yj = poly[j]\n        if ((yi > py) != (yj > py)) and \\\n           (px < (xj - xi) * (py - yi) / ((yj - yi) if (yj - yi) != 0 else 1e-12) + xi):\n            inside = not inside\n        j = i\n    return inside\n\ndef vertical_intersections(xv, poly):\n    # Recta vertical en x=xv: devuelve los Y donde corta el contorno (modo NS).\n    ys = []\n    n = len(poly)\n    for i in range(n):\n        x1, y1 = poly[i]\n        x2, y2 = poly[(i + 1) % n]\n        if x1 == x2:\n            continue\n        if xv < min(x1, x2) or xv > max(x1, x2):\n            continue\n        t = (xv - x1) / (x2 - x1)\n        if 0.0 <= t <= 1.0:\n            ys.append(y1 + t * (y2 - y1))\n    return ys\n\ndef horizontal_intersections(yv, poly):\n    # Recta horizontal en y=yv: devuelve los X donde corta el contorno (modo EO).\n    xs = []\n    n = len(poly)\n    for i in range(n):\n        x1, y1 = poly[i]\n        x2, y2 = poly[(i + 1) % n]\n        if y1 == y2:\n            continue\n        if yv < min(y1, y2) or yv > max(y1, y2):\n            continue\n        t = (yv - y1) / (y2 - y1)\n        if 0.0 <= t <= 1.0:\n            xs.append(x1 + t * (x2 - x1))\n    return xs\n\nnames_in_order = []\nhandles_in_order = []\n\ntry:\n    if orientation not in (\"NS\", \"EO\"):\n        raise Exception(\"Orientacion invalida '{}'. Usa 'NS' o 'EO'.\".format(orientation))\n\n    doc = AcadApp.DocumentManager.MdiActiveDocument\n    db  = doc.Database\n\n    dlock = doc.LockDocument()\n    try:\n        tr = db.TransactionManager.StartTransaction()\n        try:\n            ms_id = SymbolUtilityServices.GetBlockModelSpaceId(db)\n            btr   = tr.GetObject(ms_id, OpenMode.ForWrite)\n\n            contours = []\n            trackers = []\n            old_axis_oids = []\n\n            # v03: los trackers pueden ser LWPOLYLINE (primer y ultimo\n            # vertice) o LINE (StartPoint/EndPoint). Los ejes helper que crea\n            # este mismo script siguen siendo polilineas y se borran igual.\n            censo = {}\n            n_trk_pl = 0\n            n_trk_ln = 0\n            for oid in btr:\n                obj = tr.GetObject(oid, OpenMode.ForRead)\n                es_pl = isinstance(obj, Polyline)\n                es_ln = isinstance(obj, Line)\n                lay = obj.Layer\n                if lay == contour_layer or lay == tracker_layer:\n                    try:\n                        tipo_obj = obj.GetType().Name\n                    except Exception:\n                        tipo_obj = type(obj).__name__\n                    clave = (lay, tipo_obj)\n                    censo[clave] = censo.get(clave, 0) + 1\n                if not (es_pl or es_ln):\n                    continue\n                if es_pl:\n                    n = obj.NumberOfVertices\n                    if lay == axis_layer:\n                        old_axis_oids.append(oid)\n                        continue\n                    if lay == contour_layer and n >= 3:\n                        pts = []\n                        for i in range(n):\n                            p = obj.GetPoint2dAt(i)\n                            pts.append((p.X, p.Y))\n                        contours.append(pts)\n                    elif lay == tracker_layer and n >= 2:\n                        p1 = obj.GetPoint2dAt(0)\n                        p2 = obj.GetPoint2dAt(n - 1)\n                        xmid = (p1.X + p2.X) / 2.0\n                        ymid = (p1.Y + p2.Y) / 2.0\n                        trackers.append({\"xmid\": xmid, \"ymid\": ymid, \"oid\": oid})\n                        n_trk_pl += 1\n                elif lay == tracker_layer:\n                    p1 = obj.StartPoint\n                    p2 = obj.EndPoint\n                    xmid = (p1.X + p2.X) / 2.0\n                    ymid = (p1.Y + p2.Y) / 2.0\n                    trackers.append({\"xmid\": xmid, \"ymid\": ymid, \"oid\": oid})\n                    n_trk_ln += 1\n\n            def _censo_txt(capa):\n                filas = [\"{} x {}\".format(v, k[1]) for k, v in censo.items()\n                         if k[0] == capa]\n                return \", \".join(sorted(filas)) if filas else \"ningun objeto\"\n\n            if not contours:\n                raise Exception(\n                    \"No hay polilineas (LWPOLYLINE, >=3 vertices) en la capa \"\n                    \"'{}'. En esa capa hay: {}.\"\n                    .format(contour_layer, _censo_txt(contour_layer)))\n            if not trackers:\n                raise Exception(\n                    \"No hay trackers (LWPOLYLINE o LINE) en la capa '{}'. \"\n                    \"En esa capa hay: {}. Comprueba nombre exacto de capa, \"\n                    \"que no esten en un bloque/XREF, y el tipo de objeto.\"\n                    .format(tracker_layer, _censo_txt(tracker_layer)))\n\n            log.append(\"Orientacion: {}\".format(orientation))\n            log.append(\"Contornos: {}\".format(len(contours)))\n            log.append(\"Trackers:  {}  (polilineas {}, lineas {})\"\n                       .format(len(trackers), n_trk_pl, n_trk_ln))\n\n            # Borrar ejes previos (helpers de ejecuciones anteriores)\n            n_old_axis = 0\n            for oid in old_axis_oids:\n                try:\n                    o = tr.GetObject(oid, OpenMode.ForWrite)\n                    o.Erase()\n                    n_old_axis += 1\n                except:\n                    pass\n            if n_old_axis:\n                log.append(\"Ejes previos borrados: {}\".format(n_old_axis))\n\n            # Asegurar capa ejes\n            lt = tr.GetObject(db.LayerTableId, OpenMode.ForRead)\n            axis_layer_id = ObjectId.Null\n            if lt.Has(axis_layer):\n                try:\n                    axis_layer_id = lt.get_Item(axis_layer)\n                except:\n                    for lid in lt:\n                        lrec = tr.GetObject(lid, OpenMode.ForRead)\n                        if lrec.Name == axis_layer:\n                            axis_layer_id = lid\n                            break\n            else:\n                lt.UpgradeOpen()\n                ltr = LayerTableRecord()\n                ltr.Name = axis_layer\n                axis_layer_id = lt.Add(ltr)\n                tr.AddNewlyCreatedDBObject(ltr, True)\n                log.append(\"Capa '{}' creada.\".format(axis_layer))\n\n            # ----------------------------------------------------------------\n            # Ordenacion de contornos segun orientacion\n            # ----------------------------------------------------------------\n            if orientation == \"NS\":\n                # izquierda -> derecha por X minimo\n                contours_sorted = sorted(contours, key=lambda c: min(p[0] for p in c))\n                unidad = \"columnas\"\n            else:  # EO\n                # norte -> sur por Y maximo\n                contours_sorted = sorted(contours, key=lambda c: -max(p[1] for p in c))\n                unidad = \"filas\"\n\n            # ----------------------------------------------------------------\n            # AGRUPACION POR CONTORNO. axes_to_create guarda PUNTOS COMPLETOS\n            # (name, (x0,y0), (x1,y1)) para que el dibujo sea comun a ambos modos.\n            # ----------------------------------------------------------------\n            axes_to_create = []\n            for c_idx, cont in enumerate(contours_sorted):\n                inside = [t for t in trackers if pip(t[\"xmid\"], t[\"ymid\"], cont)]\n                if not inside:\n                    log.append(\"Contorno C{:02d}: 0 trackers dentro\".format(c_idx + 1))\n                    continue\n\n                if orientation == \"NS\":\n                    # Agrupar por X (columnas), izquierda->derecha\n                    inside.sort(key=lambda t: t[\"xmid\"])\n                    groups = []\n                    cur = [inside[0]]\n                    for t in inside[1:]:\n                        if t[\"xmid\"] - cur[-1][\"xmid\"] <= group_tol:\n                            cur.append(t)\n                        else:\n                            groups.append(cur)\n                            cur = [t]\n                    groups.append(cur)\n                    log.append(\"Contorno C{:02d}: {} trackers -> {} {}\".format(\n                        c_idx + 1, len(inside), len(groups), unidad))\n                    for idx, grp in enumerate(groups):\n                        col_x = sum(tt[\"xmid\"] for tt in grp) / len(grp)\n                        ys = sorted(vertical_intersections(col_x, cont))\n                        if len(ys) < 2:\n                            log.append(\"  grupo[{}] C{:02d} sin interseccion (ys={}) -> saltado\".format(\n                                idx + 1, c_idx + 1, len(ys)))\n                            continue\n                        y_min = ys[0]\n                        y_max = ys[-1]\n                        name = \"AL_C{:02d}_{:02d}\".format(c_idx + 1, idx + 1)\n                        # N->S: vertice 0 arriba (norte), vertice 1 abajo (sur)\n                        axes_to_create.append(\n                            (name, (col_x, y_max + ext_m), (col_x, y_min - ext_m)))\n                else:  # EO\n                    # Agrupar por Y (filas), norte->sur (Y descendente)\n                    inside.sort(key=lambda t: -t[\"ymid\"])\n                    groups = []\n                    cur = [inside[0]]\n                    for t in inside[1:]:\n                        if cur[-1][\"ymid\"] - t[\"ymid\"] <= group_tol:\n                            cur.append(t)\n                        else:\n                            groups.append(cur)\n                            cur = [t]\n                    groups.append(cur)\n                    log.append(\"Contorno C{:02d}: {} trackers -> {} {}\".format(\n                        c_idx + 1, len(inside), len(groups), unidad))\n                    for idx, grp in enumerate(groups):\n                        row_y = sum(tt[\"ymid\"] for tt in grp) / len(grp)\n                        xs = sorted(horizontal_intersections(row_y, cont))\n                        if len(xs) < 2:\n                            log.append(\"  grupo[{}] C{:02d} sin interseccion (xs={}) -> saltado\".format(\n                                idx + 1, c_idx + 1, len(xs)))\n                            continue\n                        x_min = xs[0]\n                        x_max = xs[-1]\n                        name = \"AL_C{:02d}_{:02d}\".format(c_idx + 1, idx + 1)\n                        # O->E: vertice 0 al oeste, vertice 1 al este\n                        axes_to_create.append(\n                            (name, (x_min - ext_m, row_y), (x_max + ext_m, row_y)))\n\n            log.append(\"Ejes a crear: {}\".format(len(axes_to_create)))\n\n            # ----------------------------------------------------------------\n            # Crear polilineas helper (comun a ambos modos).\n            # vertice 0 = inicio, vertice 1 = fin. El sentido (N->S o O->E)\n            # ya viene codificado en el orden de los puntos.\n            # ----------------------------------------------------------------\n            for (name, p_start, p_end) in axes_to_create:\n                pl = Polyline()\n                pl.AddVertexAt(0, Point2d(p_start[0], p_start[1]), 0.0, 0.0, 0.0)\n                pl.AddVertexAt(1, Point2d(p_end[0],   p_end[1]),   0.0, 0.0, 0.0)\n                pl.LayerId = axis_layer_id\n                btr.AppendEntity(pl)\n                tr.AddNewlyCreatedDBObject(pl, True)\n                names_in_order.append(name)\n                try:\n                    h_str = pl.Handle.ToString()\n                except:\n                    try:\n                        h_str = pl.ObjectId.Handle.ToString()\n                    except:\n                        h_str = None\n                handles_in_order.append(h_str)\n\n            log.append(\"Polilineas helper creadas: {}\".format(len(names_in_order)))\n\n            # Borrar trackers originales (los contornos se mantienen)\n            n_t_erased = 0\n            for t in trackers:\n                try:\n                    tr.GetObject(t[\"oid\"], OpenMode.ForWrite).Erase()\n                    n_t_erased += 1\n                except:\n                    pass\n            log.append(\"Trackers originales borrados: {}\".format(n_t_erased))\n            log.append(\"Contornos originales: MANTENIDOS\")\n\n            tr.Commit()\n        finally:\n            tr.Dispose()\n    finally:\n        dlock.Dispose()\n\n    main_mod = sys.modules.get('__main__')\n    if main_mod is None:\n        import __main__ as main_mod\n    main_mod._tracker_align_names   = names_in_order\n    main_mod._tracker_align_handles = handles_in_order\n    main_mod._tracker_align_log     = \"\\n\".join(log)\n\n    OUT = dyn_doc_in\n\nexcept Exception as ex:\n    main_mod = sys.modules.get('__main__')\n    if main_mod is None:\n        import __main__ as main_mod\n    main_mod._tracker_align_names   = []\n    main_mod._tracker_align_handles = []\n    main_mod._tracker_align_log     = \"ERROR:\\n\" + str(ex) + \"\\n\\n\" + traceback.format_exc()\n    OUT = dyn_doc_in\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "de65b93b0ebc42bcab5f914bf17b9bb3",
