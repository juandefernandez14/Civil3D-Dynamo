      "FunctionSignature": "Autodesk.Civil.DynamoNodes.AlignmentExtensions.CreateAlignmentByPolyline@string,Autodesk.AutoCAD.DynamoNodes.Polyline,string,string,string,string,bool",
      "Replication": "Auto",
      "Description": "Creates an Alignment\n\nAlignmentExtensions.CreateAlignmentByPolyline (name: string, polyline: Polyline, site: string = \"\", layer: string = \"0\", style: string = \"\", labelSet: string = \"\", addCurves: bool = true): Alignment"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\n# Lee el log que Python1 dejo en globales y lo presenta.\n# IN[0] = lista de Alignments creados por el wrapper (solo para\n# forzar orden: Python_log corre despues del wrapper).\nimport sys\n_aligns = IN[0]\nmain_mod = sys.modules.get('__main__')\nif main_mod is None:\n    import __main__ as main_mod\nlog_text = getattr(main_mod, '_tracker_align_log', \"(sin log)\")\ntry:\n    n_al = len(list(_aligns)) if _aligns is not None else 0\nexcept:\n    n_al = \"?\"\nOUT = \"{}\\n\\nAlignments procesados por wrapper: {}\".format(log_text, n_al)\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "f9365af3ff994a9982e8d28493d491bb",
