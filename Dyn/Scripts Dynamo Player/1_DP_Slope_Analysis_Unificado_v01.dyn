    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\n# =============================================================================\n# NORMALIZAR GEOMETRIA v01  -  nodo previo comun a los scripts del pipeline\n# =============================================================================\n# Los scripts leen contornos, ejes y trackers como LWPOLYLINE. En la practica\n# esas capas llegan con LINE sueltas (layouts, DXF), POLYLINE 2D antiguas o\n# POLYLINE 3D. Este nodo las normaliza ANTES de que corra el script:\n#\n#   - LINE      : se encadenan por extremos (tolerancia de empalme TOL_EMPALME)\n#                 y cada cadena pasa a ser UNA LWPOLYLINE. Si la cadena cierra\n#                 sobre si misma (hueco <= TOL_CIERRE) se marca Closed.\n#                 Una LINE aislada -> LWPOLYLINE de 2 vertices.\n#   - POLYLINE2D / POLYLINE3D : se reescriben como LWPOLYLINE plana (Z ignorada),\n#                 conservando el flag Closed.\n#   - LWPOLYLINE: no se toca.\n#\n# Los originales NO se borran: se mueven a la capa '<capa>_ORIG' (se crea si\n# no existe y se deja apagada). Es reversible: mover de vuelta y borrar las\n# LWPOLYLINE nuevas.\n#\n# ENTRADAS (numero variable): IN[0..n-2] nombres de capa (str; vacios se\n#   ignoran; tambien acepta listas de str). El ULTIMO input IN[n-1] es\n#   APLICAR: True convierte; False solo informa (dry-run).\n# SALIDA: OUT = [log_str, n_convertidas]. Conectar OUT como barrera al primer\n#   nodo de trabajo del script para forzar que esto corra antes.\n# =============================================================================\nimport math\nimport time\nimport traceback\n\nimport clr\nclr.AddReference('AcMgd')\nclr.AddReference('AcCoreMgd')\nclr.AddReference('AcDbMgd')\n\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import (\n    OpenMode, Polyline, Polyline2d, Polyline3d, Line,\n    SymbolUtilityServices, LayerTableRecord, ObjectId)\nfrom Autodesk.AutoCAD.Geometry import Point2d\n\nTOL_EMPALME = 0.05   # m: dos extremos a menos de esto se consideran unidos\nTOL_CIERRE = 0.50    # m: regla del proyecto para contornos visualmente cerrados\n\n# [DYNAMO-DAG] todo dentro de run(): nunca SystemExit a nivel de modulo\ndef run():\n    # ------------------------------ entradas -----------------------------------\n    _ins = list(IN)\n    if not _ins:\n        return [\"NORMALIZAR: sin entradas\", 0]\n    _ap = _ins[-1]\n    if isinstance(_ap, str):\n        APLICAR = _ap.strip().upper() in (\"S\", \"SI\", \"TRUE\", \"1\", \"V\")\n    else:\n        APLICAR = bool(_ap)\n    capas = []\n    for v in _ins[:-1]:\n        if v is None:\n            continue\n        if isinstance(v, (list, tuple)):\n            for x in v:\n                if x is not None and str(x).strip():\n                    capas.append(str(x).strip())\n        elif str(v).strip():\n            capas.append(str(v).strip())\n    # dedup conservando orden\n    _vist = set()\n    capas = [c for c in capas if not (c in _vist or _vist.add(c))]\n\n    L = []\n\n\n    def w(s=\"\"):\n        L.append(str(s))\n\n\n    t_ini = time.perf_counter()\n    w(\"=\" * 72)\n    w(\" NORMALIZAR GEOMETRIA v01  -  {}\".format(\n        \"APLICAR (convierte)\" if APLICAR else \"DRY-RUN (solo informa)\"))\n    w(\"=\" * 72)\n    w(\"capas: {}\".format(\", \".join(capas) if capas else \"(ninguna)\"))\n    w(\"tolerancias: empalme {:.2f} m, cierre {:.2f} m\".format(TOL_EMPALME, TOL_CIERRE))\n\n    if not capas:\n        w(\"Nada que hacer.\")\n        w(\"\")\n        w(\"==== RESUMEN DE TIEMPOS ====\")\n        w(\"{:<27}{:>7.2f} s\".format(\"TOTAL\", time.perf_counter() - t_ini))\n        return [\"\\n\".join(L), 0]\n\n\n    def _key(p):\n        \"\"\"Celda de rejilla para agrupar extremos con tolerancia.\"\"\"\n        return (int(math.floor(p[0] / TOL_EMPALME)),\n                int(math.floor(p[1] / TOL_EMPALME)))\n\n\n    def _cerca(a, b):\n        return math.hypot(a[0] - b[0], a[1] - b[1]) <= TOL_EMPALME\n\n\n    def encadenar(segs):\n        \"\"\"segs: lista de (p_ini, p_fin) 2D. Devuelve lista de (pts, cerrada).\n        Recorre cada segmento una sola vez; en bifurcaciones toma el primer\n        vecino libre (suficiente para contornos y ejes; los nudos raros se\n        reportan como cadenas abiertas y el usuario los ve en el log).\"\"\"\n        n = len(segs)\n        usado = [False] * n\n        idx = {}\n        for i, (a, b) in enumerate(segs):\n            for p in (a, b):\n                k = _key(p)\n                for dx in (-1, 0, 1):\n                    for dy in (-1, 0, 1):\n                        idx.setdefault((k[0] + dx, k[1] + dy), []).append(i)\n        # dedup listas\n        for k in idx:\n            vist = set()\n            idx[k] = [i for i in idx[k] if not (i in vist or vist.add(i))]\n\n        def vecino_libre(p, excluir):\n            for j in idx.get(_key(p), []):\n                if usado[j] or j == excluir:\n                    continue\n                a, b = segs[j]\n                if _cerca(p, a):\n                    return j, b\n                if _cerca(p, b):\n                    return j, a\n            return None, None\n\n        cadenas = []\n        for i in range(n):\n            if usado[i]:\n                continue\n            usado[i] = True\n            a, b = segs[i]\n            pts = [a, b]\n            # extender por el final\n            cur = b\n            last = i\n            while True:\n                j, nxt = vecino_libre(cur, last)\n                if j is None:\n                    break\n                usado[j] = True\n                pts.append(nxt)\n                cur = nxt\n                last = j\n                if _cerca(cur, pts[0]) and len(pts) > 3:\n                    break\n            # extender por el principio (si no cerro)\n            if not _cerca(pts[-1], pts[0]):\n                cur = pts[0]\n                last = i\n                while True:\n                    j, nxt = vecino_libre(cur, last)\n                    if j is None:\n                        break\n                    usado[j] = True\n                    pts.insert(0, nxt)\n                    cur = nxt\n                    last = j\n                    if _cerca(pts[0], pts[-1]) and len(pts) > 3:\n                        break\n            cerrada = False\n            if len(pts) >= 4 and math.hypot(pts[0][0] - pts[-1][0],\n                                            pts[0][1] - pts[-1][1]) <= TOL_CIERRE:\n                cerrada = True\n                # si el ultimo punto duplica al primero, quitarlo\n                if _cerca(pts[0], pts[-1]):\n                    pts = pts[:-1]\n            cadenas.append((pts, cerrada))\n        return cadenas\n\n\n    def pts_polyline2d(ent, tr):\n        pts = []\n        try:\n            for vid in ent:\n                v = tr.GetObject(vid, OpenMode.ForRead)\n                p = v.Position\n                pts.append((p.X, p.Y))\n        except Exception:\n            pts = []\n        return pts\n\n\n    def pts_polyline3d(ent, tr):\n        pts = []\n        try:\n            for vid in ent:\n                v = tr.GetObject(vid, OpenMode.ForRead)\n                p = v.Position\n                pts.append((p.X, p.Y))\n        except Exception:\n            pts = []\n        return pts\n\n\n    adoc = Application.DocumentManager.MdiActiveDocument\n    db = adoc.Database\n    n_total_conv = 0\n    tiempos = []\n\n    dlock = adoc.LockDocument()\n    try:\n        tr = db.TransactionManager.StartTransaction()\n        try:\n            ms_id = SymbolUtilityServices.GetBlockModelSpaceId(db)\n            ms = tr.GetObject(ms_id, OpenMode.ForWrite if APLICAR else OpenMode.ForRead)\n            lt = tr.GetObject(db.LayerTableId, OpenMode.ForRead)\n\n            # ---- inventario por capa -----------------------------------------\n            t0 = time.perf_counter()\n            por_capa = {c: {\"lw\": 0, \"line\": [], \"p2d\": [], \"p3d\": [], \"otros\": {}}\n                        for c in capas}\n            for oid in ms:\n                try:\n                    ent = tr.GetObject(oid, OpenMode.ForRead)\n                except Exception:\n                    continue\n                lay = ent.Layer\n                if lay not in por_capa:\n                    continue\n                d = por_capa[lay]\n                if isinstance(ent, Polyline):\n                    d[\"lw\"] += 1\n                elif isinstance(ent, Line):\n                    d[\"line\"].append(oid)\n                elif isinstance(ent, Polyline2d):\n                    d[\"p2d\"].append(oid)\n                elif isinstance(ent, Polyline3d):\n                    d[\"p3d\"].append(oid)\n                else:\n                    try:\n                        tn = ent.GetType().Name\n                    except Exception:\n                        tn = type(ent).__name__\n                    d[\"otros\"][tn] = d[\"otros\"].get(tn, 0) + 1\n            tiempos.append((\"inventario\", time.perf_counter() - t0))\n\n            w(\"\")\n            w(\"{:<28}{:>6}{:>7}{:>7}{:>7}  otros\".format(\n                \"capa\", \"LWPL\", \"LINE\", \"PL2D\", \"PL3D\"))\n            w(\"-\" * 72)\n            for c in capas:\n                d = por_capa[c]\n                otros = \", \".join(\"{} x {}\".format(v, k) for k, v in\n                                  sorted(d[\"otros\"].items())) or \"-\"\n                existe = lt.Has(c)\n                w(\"{:<28}{:>6}{:>7}{:>7}{:>7}  {}{}\".format(\n                    c[:28], d[\"lw\"], len(d[\"line\"]), len(d[\"p2d\"]),\n                    len(d[\"p3d\"]), otros, \"\" if existe else \"   !! CAPA NO EXISTE\"))\n\n            # ---- conversion ---------------------------------------------------\n            t0 = time.perf_counter()\n            for c in capas:\n                d = por_capa[c]\n                pendientes = len(d[\"line\"]) + len(d[\"p2d\"]) + len(d[\"p3d\"])\n                if pendientes == 0:\n                    continue\n                w(\"\")\n                w(\"[{}]\".format(c))\n\n                nuevas = []   # (pts, cerrada, origen)\n                # LINE -> cadenas\n                if d[\"line\"]:\n                    segs = []\n                    for oid in d[\"line\"]:\n                        ent = tr.GetObject(oid, OpenMode.ForRead)\n                        a = ent.StartPoint\n                        b = ent.EndPoint\n                        segs.append(((a.X, a.Y), (b.X, b.Y)))\n                    cadenas = encadenar(segs)\n                    n_cer = sum(1 for _, z in cadenas if z)\n                    w(\"  LINE: {} segmentos -> {} cadenas ({} cerradas, {} abiertas)\"\n                      .format(len(segs), len(cadenas), n_cer, len(cadenas) - n_cer))\n                    for pts, cerrada in cadenas:\n                        nuevas.append((pts, cerrada, \"LINE\"))\n                for oid in d[\"p2d\"]:\n                    ent = tr.GetObject(oid, OpenMode.ForRead)\n                    pts = pts_polyline2d(ent, tr)\n                    if len(pts) >= 2:\n                        nuevas.append((pts, bool(ent.Closed), \"PL2D\"))\n                    else:\n                        w(\"  PL2D handle {}: sin vertices legibles, se deja\".format(ent.Handle))\n                for oid in d[\"p3d\"]:\n                    ent = tr.GetObject(oid, OpenMode.ForRead)\n                    pts = pts_polyline3d(ent, tr)\n                    if len(pts) >= 2:\n                        nuevas.append((pts, bool(ent.Closed), \"PL3D\"))\n                    else:\n                        w(\"  PL3D handle {}: sin vertices legibles, se deja\".format(ent.Handle))\n\n                for pts, cerrada, origen in nuevas:\n                    w(\"  {} -> LWPOLYLINE {} vertices{}\".format(\n                        origen, len(pts), \" (cerrada)\" if cerrada else \"\"))\n\n                if not APLICAR:\n                    w(\"  dry-run: {} LWPOLYLINE se crearian; {} originales irian a '{}_ORIG'\"\n                      .format(len(nuevas), pendientes, c))\n                    continue\n\n                # capa destino de la geometria original\n                capa_orig = c + \"_ORIG\"\n                if lt.Has(capa_orig):\n                    id_orig = lt.get_Item(capa_orig)\n                else:\n                    lt.UpgradeOpen()\n                    ltr = LayerTableRecord()\n                    ltr.Name = capa_orig\n                    ltr.IsOff = True\n                    id_orig = lt.Add(ltr)\n                    tr.AddNewlyCreatedDBObject(ltr, True)\n                    lt.DowngradeOpen()\n                    w(\"  capa '{}' creada (apagada)\".format(capa_orig))\n                id_capa = lt.get_Item(c)\n\n                n_new = 0\n                for pts, cerrada, origen in nuevas:\n                    pl = Polyline()\n                    for i, (x, y) in enumerate(pts):\n                        pl.AddVertexAt(i, Point2d(x, y), 0.0, 0.0, 0.0)\n                    pl.Closed = cerrada\n                    pl.LayerId = id_capa\n                    ms.AppendEntity(pl)\n                    tr.AddNewlyCreatedDBObject(pl, True)\n                    n_new += 1\n                n_mov = 0\n                for oid in d[\"line\"] + d[\"p2d\"] + d[\"p3d\"]:\n                    try:\n                        ent = tr.GetObject(oid, OpenMode.ForWrite)\n                        ent.LayerId = id_orig\n                        n_mov += 1\n                    except Exception as ex:\n                        w(\"  KO moviendo handle: {}\".format(str(ex)[:80]))\n                w(\"  creadas {} LWPOLYLINE; {} originales movidas a '{}'\".format(\n                    n_new, n_mov, capa_orig))\n                n_total_conv += n_new\n            tiempos.append((\"conversion\", time.perf_counter() - t0))\n\n            if APLICAR:\n                tr.Commit()\n        finally:\n            tr.Dispose()\n    except Exception:\n        w(\"\")\n        w(\"!!!!!! EXCEPCION NO CONTROLADA\")\n        for linea in traceback.format_exc().split(\"\\n\"):\n            w(\"  \" + linea)\n    finally:\n        dlock.Dispose()\n\n    w(\"\")\n    w(\"RESULTADO: {} LWPOLYLINE {}\".format(\n        n_total_conv, \"creadas\" if APLICAR else \"se crearian (dry-run)\"))\n    w(\"\")\n    w(\"==== RESUMEN DE TIEMPOS ====\")\n    for et, sg in tiempos:\n        w(\"{:<27}{:>7.2f} s\".format(et, sg))\n    w(\"{:<27}{:>7.2f} s\".format(\"TOTAL\", time.perf_counter() - t_ini))\n\n    return [\"\\n\".join(L), n_total_conv]\n\n\nOUT = run()\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
