    {
      "ConcreteType": "CoreNodeModels.Input.BoolSelector, CoreNodeModels",
      "Id": "4c4fc8ba566d4710b69afec20764a64a",
      "NodeType": "BooleanInputNode",
      "InputValue": true,
      "Inputs": [],
      "Outputs": [
        {
          "Id": "b2bdfd72cb6b4531a9449d1044eee5a6",
          "Name": "",
          "Description": "Boolean",
