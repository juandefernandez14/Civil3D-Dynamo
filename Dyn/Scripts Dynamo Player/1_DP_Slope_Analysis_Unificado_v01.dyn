    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# IN[12]: BARRERA de sincronizacion del nodo NORMALIZAR (contenido ignorado).\n# -*- coding: utf-8 -*-\n# =============================================================================\n# 1_Slope_Analysis_Unificado.dyn  -  Nodo Python principal  (v1)\n# Civil 3D 2024 / Dynamo 2.19 / CPython3\n#\n# Unifica los dos analisis de pendientes (NS y EO) y los generaliza a\n# Trackers y Mesas. Hay 2 algoritmos y 4 casos:\n#\n#   AXIAL (a lo largo del eje)  -> Trackers+NS  y  Mesas+EO\n#   CROSS (entre filas/vecino)  -> Trackers+EO  y  Mesas+NS\n#\n# Regla: eje_estructura = \"NS\" si Trackers, \"EO\" si Mesas.\n#        mode = \"axial\" si Orientacion == eje_estructura, si no \"cross\".\n#\n# Normalizacion de extremos: Trackers A=Norte (mayor Y); Mesas A=Oeste (menor X).\n# CROSS:  Trackers -> vecino al ESTE (+X), solape en Y, proyeccion horizontal.\n#         Mesas    -> vecino al SUR  (-Y), solape en X, proyeccion vertical.\n#\n# AXIAL replica el script NS actual (estilo+rangos en la misma transaccion,\n#   sin max triangle length, usa Opcion puntos 1/2).\n# CROSS replica el script EO actual (2a transaccion aislada para estilo+rangos,\n#   MaximumTriangleLength = pitch_max*1.5, usa pitch_min/max e iteraciones).\n#\n# Entradas (puertos IN[0..11]):\n#   IN[0]  : str    nombre de la superficie a muestrear (MDT / definitiva)\n#   IN[1]  : str    capa del contorno (polilineas cerradas)\n#   IN[2]  : str    capa de los ejes (trackers o mesas, polilineas de 2 vert.)\n#   IN[3]  : str    Tipo: \"Trackers\" o \"Mesas\"\n#   IN[4]  : str    Orientacion medida: \"NS\" o \"EO\"\n#   IN[5]  : float  pendiente maxima admisible (%)  -> umbral rojo\n#   IN[6]  : float  pendiente de aviso (%)          -> umbral amarillo\n#   IN[7]  : str    nombre de la nueva superficie TIN de resultado\n#   IN[8]  : int    [solo AXIAL] opcion puntos (1=centroide, 2=extremos)\n#   IN[9]  : float  [solo CROSS] pitch minimo (m)\n#   IN[10] : float  [solo CROSS] pitch maximo (m)\n#   IN[11] : int    [solo CROSS] iteraciones de subdivision (n -> 2^n+1 puntos)\n#\n# Salida:\n#   OUT : str  log del analisis + desglose de tiempos\n# =============================================================================\n\nimport clr\nimport math\nimport time\nimport traceback\n\nclr.AddReference('AcMgd')\nclr.AddReference('AcCoreMgd')\nclr.AddReference('AcDbMgd')\nclr.AddReference('AecBaseMgd')\nclr.AddReference('AeccDbMgd')\n\nfrom Autodesk.AutoCAD.ApplicationServices import Application as AcadApp\nfrom Autodesk.AutoCAD.DatabaseServices import (\n    OpenMode, Polyline, Line, SymbolUtilityServices\n)\nfrom Autodesk.AutoCAD.Geometry import Point2d, Point3d, Point3dCollection\nfrom Autodesk.Civil import SurfaceBoundaryType\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import (\n    TinSurface, SurfaceAnalysisElevationData, SurfaceSlopeLabel\n)\n\nimport System\nfrom System import Array\nfrom Autodesk.AutoCAD.Colors import Color as AcadColor\n\n\ndef pip(px, py, poly):\n    \"\"\"Ray-casting point-in-polygon (poly = lista de (x,y), sin necesidad de cerrar).\"\"\"\n    inside = False\n    n = len(poly)\n    if n < 3:\n        return False\n    j = n - 1\n    for i in range(n):\n        xi, yi = poly[i]\n        xj, yj = poly[j]\n        if ((yi > py) != (yj > py)) and \\\n           (px < (xj - xi) * (py - yi) / ((yj - yi) if (yj - yi) != 0 else 1e-12) + xi):\n            inside = not inside\n        j = i\n    return inside\n\n\ndef build_color_ranges(z_min, z_max, warn, mx):\n    \"\"\"Rangos verde/amarillo/rojo dinamicos segun datos reales y umbrales.\n    El verde absorbe los extremos que caen dentro; solo se crean colas\n    amarillo/rojo si hay datos que las alcancen. Devuelve [(mn,mx,color),...].\"\"\"\n    green = AcadColor.FromRgb(80, 200, 80)\n    yellow = AcadColor.FromRgb(240, 220, 60)\n    red = AcadColor.FromRgb(220, 50, 50)\n\n    ranges = []\n    # lado negativo\n    if z_min < -mx:\n        ranges.append((z_min, -mx, red))\n        ranges.append((-mx, -warn, yellow))\n        green_lo = -warn\n    elif z_min < -warn:\n        ranges.append((z_min, -warn, yellow))\n        green_lo = -warn\n    else:\n        green_lo = z_min\n\n    # lado positivo\n    pos_tail = []\n    if z_max > mx:\n        green_hi = warn\n        pos_tail.append((warn, mx, yellow))\n        pos_tail.append((mx, z_max, red))\n    elif z_max > warn:\n        green_hi = warn\n        pos_tail.append((warn, z_max, yellow))\n    else:\n        green_hi = z_max\n\n    if green_lo >= green_hi:\n        green_hi = green_lo + 0.001\n    ranges.append((green_lo, green_hi, green))\n    ranges.extend(pos_tail)\n    return ranges\n\n\ndef assign_style_and_ranges(surf, cdoc, z_min, z_max, warn, mx, log):\n    \"\"\"Asigna estilo 'elevaciones' y aplica los rangos de color a una superficie\n    ya abierta ForWrite. Usado por AXIAL (en tr1) y por CROSS (en tr2).\"\"\"\n    # estilo\n    try:\n        ss = cdoc.Styles.SurfaceStyles\n        style_set = False\n        for name_try in [\"elevaciones\", \"Elevaciones\", \"ELEVACIONES\"]:\n            try:\n                surf.StyleId = ss.get_Item(name_try)\n                style_set = True\n                log.append(\"Estilo '{}' asignado.\".format(name_try))\n                break\n            except:\n                continue\n        if not style_set:\n            log.append(\"AVISO: estilo 'elevaciones' no encontrado. Asignalo a mano.\")\n    except Exception as ex_sty:\n        log.append(\"AVISO estilo: {}\".format(ex_sty))\n\n    # rangos de color\n    try:\n        ranges = build_color_ranges(z_min, z_max, warn, mx)\n        data_arr = [SurfaceAnalysisElevationData(mn, mxv, col)\n                    for (mn, mxv, col) in ranges]\n        surf.Analysis.SetElevationData(Array[SurfaceAnalysisElevationData](data_arr))\n        log.append(\"{} rangos de color aplicados ({:.2f} a {:.2f}).\".format(\n            len(ranges), z_min, z_max))\n    except Exception as ex_an:\n        log.append(\"AVISO analisis: {}\".format(ex_an))\n\n\ndef run():\n    log = []\n    T = {}\n    T[\"start\"] = time.perf_counter()\n\n    # --------------------------------------------------------------------- #\n    # Inputs (lectura tolerante)\n    # --------------------------------------------------------------------- #\n    def _s(i, default=\"\"):\n        try:\n            return str(IN[i]) if (len(IN) > i and IN[i] is not None) else default\n        except:\n            return default\n\n    def _f(i, default):\n        try:\n            return float(IN[i]) if (len(IN) > i and IN[i] is not None) else default\n        except:\n            return default\n\n    mdt_name = _s(0)\n    contour_layer = _s(1)\n    axis_layer = _s(2)\n    tipo_raw = _s(3, \"Trackers\")\n    orient_raw = _s(4, \"NS\")\n    max_slope_pct = _f(5, 4.0)\n    warn_slope_pct = _f(6, 3.0)\n    out_surf_name = _s(7, \"Slope_Analysis\")\n    opt_pts = int(_f(8, 2.0))\n    pitch_min = _f(9, 4.0)\n    pitch_max = _f(10, 15.0)\n    n_iter = int(_f(11, 2.0))\n\n    tipo = tipo_raw.strip().upper()\n    orient = orient_raw.strip().upper()\n\n    if tipo in (\"TRACKER\", \"TRACKERS\", \"SEGUIDOR\", \"SEGUIDORES\"):\n        tipo = \"TRACKERS\"\n    elif tipo in (\"MESA\", \"MESAS\", \"FIJA\", \"FIJAS\"):\n        tipo = \"MESAS\"\n    if tipo not in (\"TRACKERS\", \"MESAS\"):\n        raise Exception(\"Tipo invalido '{}'. Usa 'Trackers' o 'Mesas'.\".format(tipo_raw))\n    if orient not in (\"NS\", \"EO\"):\n        raise Exception(\"Orientacion invalida '{}'. Usa 'NS' o 'EO'.\".format(orient_raw))\n    if opt_pts not in (1, 2):\n        opt_pts = 1\n\n    axis_orient = \"NS\" if tipo == \"TRACKERS\" else \"EO\"   # eje de la estructura\n    axis_vertical = (axis_orient == \"NS\")                # Trackers vertical / Mesas horizontal\n    mode = \"axial\" if orient == axis_orient else \"cross\"\n\n    tipo_lbl = \"Trackers\" if tipo == \"TRACKERS\" else \"Mesas\"\n    log.append(\"=== SLOPE ANALYSIS UNIFICADO (v1) ===\")\n    log.append(\"Tipo: {}   Orientacion medida: {}   Eje estructura: {}\".format(\n        tipo_lbl, orient, axis_orient))\n    log.append(\"Caso: {} {}  ->  algoritmo '{}'\".format(\n        tipo_lbl, orient,\n        \"a lo largo del eje\" if mode == \"axial\" else \"entre filas\"))\n    log.append(\"Superficie muestreada: {}\".format(mdt_name))\n    if mode == \"axial\":\n        log.append(\"(Opcion puntos = {}  |  pitch/iteraciones IGNORADOS en este caso)\".format(opt_pts))\n    else:\n        log.append(\"(pitch=[{}, {}] m, iteraciones={}  |  Opcion puntos IGNORADA en este caso)\".format(\n            pitch_min, pitch_max, n_iter))\n\n    doc = AcadApp.DocumentManager.MdiActiveDocument\n    db = doc.Database\n    cdoc = CivilApplication.ActiveDocument\n\n    surf_points = []     # Point3d con Z = pendiente(%)\n    label_pairs = []     # [(Point2d_A, Point2d_B), ...]\n    z_min_surf = 0.0\n    z_max_surf = 0.0\n    n_ok = n_warn = n_ko = 0\n    n_err = 0\n\n    # --------------------------------------------------------------------- #\n    # FASE 1: lectura, calculo, superficie, (axial: estilo+rangos), etiquetas\n    # --------------------------------------------------------------------- #\n    dlock = doc.LockDocument()\n    try:\n        tr = db.TransactionManager.StartTransaction()\n        try:\n\n            # 1. Localizar la superficie por nombre\n            mdt_surf = None\n            mdt_surf_id = None\n            for sid in cdoc.GetSurfaceIds():\n                s = tr.GetObject(sid, OpenMode.ForRead)\n                if s.Name == mdt_name:\n                    mdt_surf = s\n                    mdt_surf_id = sid\n                    break\n            if mdt_surf is None:\n                raise Exception(\"No se ha encontrado la superficie '{}'. \"\n                                \"Comprueba el nombre / data shortcut.\".format(mdt_name))\n\n            # 2. Recorrer ModelSpace -> contornos + ejes normalizados\n            ms_id = SymbolUtilityServices.GetBlockModelSpaceId(db)\n            btr = tr.GetObject(ms_id, OpenMode.ForRead)\n\n            contours = []\n            axes = []\n            # v02: los ejes pueden ser LWPOLYLINE (primer y ultimo vertice) o\n            # LINE (StartPoint/EndPoint). Los contornos siguen siendo solo\n            # polilineas cerradas. Se lleva censo por capa/tipo para que, si\n            # no aparece nada, el log diga que hay en realidad en esa capa.\n            censo = {}\n            n_ejes_pl = 0\n            n_ejes_ln = 0\n            for oid in btr:\n                obj = tr.GetObject(oid, OpenMode.ForRead)\n                es_pl = isinstance(obj, Polyline)\n                es_ln = isinstance(obj, Line)\n                lay = obj.Layer\n                if lay == contour_layer or lay == axis_layer:\n                    try:\n                        tipo_obj = obj.GetType().Name\n                    except Exception:\n                        tipo_obj = type(obj).__name__\n                    clave = (lay, tipo_obj)\n                    censo[clave] = censo.get(clave, 0) + 1\n                if not (es_pl or es_ln):\n                    continue\n                p1 = None\n                p2 = None\n                if es_pl:\n                    nv = obj.NumberOfVertices\n                    if lay == contour_layer and nv >= 3:\n                        pts = []\n                        for i in range(nv):\n                            p = obj.GetPoint2dAt(i)\n                            pts.append((p.X, p.Y))\n                        contours.append(pts)\n                        continue\n                    if lay == axis_layer and nv >= 2:\n                        p1 = obj.GetPoint2dAt(0)\n                        p2 = obj.GetPoint2dAt(nv - 1)\n                        n_ejes_pl += 1\n                elif lay == axis_layer:\n                    p1 = obj.StartPoint\n                    p2 = obj.EndPoint\n                    n_ejes_ln += 1\n                if p1 is not None and p2 is not None:\n                    if axis_vertical:\n                        # A = Norte (mayor Y)\n                        if p1.Y >= p2.Y:\n                            ax, ay, bx, by = p1.X, p1.Y, p2.X, p2.Y\n                        else:\n                            ax, ay, bx, by = p2.X, p2.Y, p1.X, p1.Y\n                    else:\n                        # A = Oeste (menor X)\n                        if p1.X <= p2.X:\n                            ax, ay, bx, by = p1.X, p1.Y, p2.X, p2.Y\n                        else:\n                            ax, ay, bx, by = p2.X, p2.Y, p1.X, p1.Y\n                    axes.append({\n                        \"ax\": ax, \"ay\": ay, \"bx\": bx, \"by\": by,\n                        \"xmid\": (ax + bx) / 2.0, \"ymid\": (ay + by) / 2.0,\n                        \"xmin\": min(ax, bx), \"xmax\": max(ax, bx),\n                        \"ymin\": min(ay, by), \"ymax\": max(ay, by),\n                    })\n\n            def _censo_txt(capa):\n                filas = [\"{} x {}\".format(v, k[1]) for k, v in censo.items()\n                         if k[0] == capa]\n                return \", \".join(sorted(filas)) if filas else \"ningun objeto\"\n\n            if not contours:\n                raise Exception(\n                    \"No hay polilineas (LWPOLYLINE, >=3 vertices) en la capa \"\n                    \"de contorno '{}'. En esa capa hay: {}.\"\n                    .format(contour_layer, _censo_txt(contour_layer)))\n            if not axes:\n                raise Exception(\n                    \"No hay ejes (LWPOLYLINE o LINE) en la capa de ejes '{}'. \"\n                    \"En esa capa hay: {}. Comprueba nombre exacto de capa, \"\n                    \"que no esten en un bloque/XREF, y el tipo de objeto.\"\n                    .format(axis_layer, _censo_txt(axis_layer)))\n\n            log.append(\"Contornos encontrados: {}\".format(len(contours)))\n            log.append(\"Ejes encontrados:      {}  (polilineas {}, lineas {})\"\n                       .format(len(axes), n_ejes_pl, n_ejes_ln))\n            T[\"read\"] = time.perf_counter()\n\n            # 3. Filtro: ambos extremos dentro de algun contorno\n            inside_axes = []\n            n_out = 0\n            for a in axes:\n                inA = any(pip(a[\"ax\"], a[\"ay\"], c) for c in contours)\n                inB = any(pip(a[\"bx\"], a[\"by\"], c) for c in contours)\n                if inA and inB:\n                    inside_axes.append(a)\n                else:\n                    n_out += 1\n            if not inside_axes:\n                raise Exception(\"Ningun eje con ambos extremos dentro del contorno.\")\n            log.append(\"Ejes dentro del contorno: {}\".format(len(inside_axes)))\n            log.append(\"Ejes fuera del contorno:  {}\".format(n_out))\n            T[\"filter\"] = time.perf_counter()\n\n            # 4. Calculo de pendientes segun modo\n            if mode == \"axial\":\n                # pendiente entre los dos extremos de cada eje\n                for a in inside_axes:\n                    xa, ya, xb, yb = a[\"ax\"], a[\"ay\"], a[\"bx\"], a[\"by\"]\n                    try:\n                        za = mdt_surf.FindElevationAtXY(xa, ya)\n                        zb = mdt_surf.FindElevationAtXY(xb, yb)\n                    except:\n                        n_err += 1\n                        continue\n                    dx = xb - xa\n                    dy = yb - ya\n                    L = math.sqrt(dx * dx + dy * dy)\n                    if L < 1e-6:\n                        n_err += 1\n                        continue\n                    slope_pct = (zb - za) / L * 100.0\n                    if abs(slope_pct) > max_slope_pct:\n                        n_ko += 1\n                    elif abs(slope_pct) > warn_slope_pct:\n                        n_warn += 1\n                    else:\n                        n_ok += 1\n                    if opt_pts == 2:\n                        surf_points.append(Point3d(xa, ya, slope_pct))\n                        surf_points.append(Point3d(xb, yb, slope_pct))\n                    else:\n                        xm = (xa + xb) / 2.0\n                        ym = (ya + yb) / 2.0\n                        surf_points.append(Point3d(xm, ym, slope_pct))\n                    label_pairs.append((Point2d(xa, ya), Point2d(xb, yb)))\n\n            else:\n                # entre filas: emparejar con vecino perpendicular y densificar\n                if pitch_max <= 0 or pitch_min < 0 or pitch_min >= pitch_max:\n                    raise Exception(\"Pitch invalido: min={}, max={}. Debe cumplir 0<=min<max.\".format(\n                        pitch_min, pitch_max))\n\n                neighbor_dir = \"Este\" if axis_vertical else \"Sur\"\n\n                def find_neighbor(Tn, pool):\n                    cands = []\n                    for U in pool:\n                        if U is Tn:\n                            continue\n                        if axis_vertical:\n                            d = U[\"xmid\"] - Tn[\"xmid\"]            # vecino al Este (+X)\n                            if d <= 1e-6 or d < pitch_min or d > pitch_max:\n                                continue\n                            if min(Tn[\"ymax\"], U[\"ymax\"]) <= max(Tn[\"ymin\"], U[\"ymin\"]):\n                                continue                          # sin solape en Y\n                        else:\n                            d = Tn[\"ymid\"] - U[\"ymid\"]            # vecino al Sur (-Y)\n                            if d <= 1e-6 or d < pitch_min or d > pitch_max:\n                                continue\n                            if min(Tn[\"xmax\"], U[\"xmax\"]) <= max(Tn[\"xmin\"], U[\"xmin\"]):\n                                continue                          # sin solape en X\n                        cands.append((d, U))\n                    if not cands:\n                        return None\n                    cands.sort(key=lambda c: c[0])                # mas cercano dentro del rango\n                    return cands[0][1]\n\n                n_pts = (1 << max(0, n_iter)) + 1                 # 2^n + 1\n                if n_pts < 2:\n                    n_pts = 2\n                denom = float(n_pts - 1)\n                t_params = [i / denom for i in range(n_pts)]\n\n                pairs = []\n                n_no_neighbor = 0\n                for Tn in inside_axes:\n                    Nn = find_neighbor(Tn, inside_axes)\n                    if Nn is None:\n                        n_no_neighbor += 1\n                        continue\n                    pairs.append((Tn, Nn))\n                if not pairs:\n                    raise Exception(\"Ningun eje tiene vecino al {}. Revisa pitch/geometria.\".format(\n                        neighbor_dir))\n\n                for Tn, Nn in pairs:\n                    Tax, Tay, Tbx, Tby = Tn[\"ax\"], Tn[\"ay\"], Tn[\"bx\"], Tn[\"by\"]\n                    Nax, Nay, Nbx, Nby = Nn[\"ax\"], Nn[\"ay\"], Nn[\"bx\"], Nn[\"by\"]\n                    for tp in t_params:\n                        px = Tax + tp * (Tbx - Tax)\n                        py = Tay + tp * (Tby - Tay)\n                        if axis_vertical:\n                            # proyeccion horizontal: misma py, hallar nx sobre la recta de N\n                            if abs(Nay - Nby) < 1e-9:\n                                n_err += 1\n                                continue\n                            t_n = (Nay - py) / (Nay - Nby)\n                            nx = Nax + t_n * (Nbx - Nax)\n                            ny = py\n                        else:\n                            # proyeccion vertical: misma px, hallar ny sobre la recta de N\n                            if abs(Nax - Nbx) < 1e-9:\n                                n_err += 1\n                                continue\n                            t_n = (Nax - px) / (Nax - Nbx)\n                            ny = Nay + t_n * (Nby - Nay)\n                            nx = px\n                        dx = nx - px\n                        dy = ny - py\n                        L = math.sqrt(dx * dx + dy * dy)\n                        if L < 1e-6:\n                            n_err += 1\n                            continue\n                        try:\n                            zT = mdt_surf.FindElevationAtXY(px, py)\n                            zN = mdt_surf.FindElevationAtXY(nx, ny)\n                        except:\n                            n_err += 1\n                            continue\n                        slope_pct = (zN - zT) / L * 100.0\n                        if abs(slope_pct) > max_slope_pct:\n                            n_ko += 1\n                        elif abs(slope_pct) > warn_slope_pct:\n                            n_warn += 1\n                        else:\n                            n_ok += 1\n                        surf_points.append(Point3d(px, py, slope_pct))\n                        surf_points.append(Point3d(nx, ny, slope_pct))\n                        label_pairs.append((Point2d(px, py), Point2d(nx, ny)))\n\n                log.append(\"Parejas analizadas:     {}\".format(len(pairs)))\n                log.append(\"Ejes sin vecino al {}: {}\".format(neighbor_dir, n_no_neighbor))\n\n            if not surf_points:\n                raise Exception(\"No se han podido calcular pendientes (sin puntos validos).\")\n\n            z_min_surf = min(p.Z for p in surf_points)\n            z_max_surf = max(p.Z for p in surf_points)\n            T[\"calc\"] = time.perf_counter()\n\n            # 5. Crear superficie TIN (borrando la previa por nombre)\n            existing_id = None\n            for sid in cdoc.GetSurfaceIds():\n                s = tr.GetObject(sid, OpenMode.ForRead)\n                if s.Name == out_surf_name:\n                    existing_id = sid\n                    break\n            if existing_id is not None:\n                tr.GetObject(existing_id, OpenMode.ForWrite).Erase()\n                log.append(\"Superficie previa '{}' borrada.\".format(out_surf_name))\n\n            new_surf_id = TinSurface.Create(db, out_surf_name)\n            new_surf = tr.GetObject(new_surf_id, OpenMode.ForWrite)\n            for p in surf_points:\n                new_surf.AddVertex(p)\n\n            # 6. Contornos: el primero como Outer, los demas como Show\n            firstb = True\n            for c in contours:\n                pc = Point3dCollection()\n                for (x, y) in c:\n                    pc.Add(Point3d(x, y, 0.0))\n                if (c[0][0], c[0][1]) != (c[-1][0], c[-1][1]):\n                    pc.Add(Point3d(c[0][0], c[0][1], 0.0))\n                btype = SurfaceBoundaryType.Outer if firstb else SurfaceBoundaryType.Show\n                new_surf.BoundariesDefinition.AddBoundaries(pc, 1.0, btype, True)\n                firstb = False\n\n            # 6b. (solo CROSS) longitud maxima de triangulo -> corta puentes\n            if mode == \"cross\":\n                max_tri = pitch_max * 1.5\n                try:\n                    bops = new_surf.BuildOptions\n                    bops.UseMaximumTriangleLength = True\n                    bops.MaximumTriangleLength = max_tri\n                    log.append(\"Max triangle side aplicado: {:.2f} m\".format(max_tri))\n                except Exception as ex_bo:\n                    log.append(\"AVISO: max triangle side no aplicado por API ({}). \"\n                               \"Configuralo a mano (= {:.2f} m).\".format(ex_bo, max_tri))\n\n            # 7. (solo AXIAL) estilo + rangos en ESTA misma transaccion\n            if mode == \"axial\":\n                assign_style_and_ranges(new_surf, cdoc, z_min_surf, z_max_surf,\n                                        warn_slope_pct, max_slope_pct, log)\n            T[\"surface\"] = time.perf_counter()\n\n            # 8. Etiquetas de pendiente \"Two points\" sobre el MDT muestreado\n            #    Firma C3D 2024: SurfaceSlopeLabel.Create(surfaceId, P2d, P2d, styleId)\n            slope_style_id = None\n            try:\n                lss = cdoc.Styles.LabelStyles.SurfaceLabelStyles.SlopeLabelStyles\n                for stid in lss:\n                    slope_style_id = stid\n                    break\n            except Exception as ex_ss:\n                log.append(\"AVISO: no se pudo leer SlopeLabelStyles: {}\".format(ex_ss))\n\n            n_labels = 0\n            n_label_err = 0\n            first_err = None\n            for pA, pB in label_pairs:\n                try:\n                    if slope_style_id is not None:\n                        SurfaceSlopeLabel.Create(mdt_surf_id, pA, pB, slope_style_id)\n                    else:\n                        SurfaceSlopeLabel.Create(mdt_surf_id, pA, pB)\n                    n_labels += 1\n                except Exception as ex_lb:\n                    n_label_err += 1\n                    if first_err is None:\n                        first_err = str(ex_lb)\n            log.append(\"Etiquetas de pendiente creadas: {}\".format(n_labels))\n            if n_label_err > 0:\n                log.append(\"Etiquetas con error: {} (primer error: {})\".format(n_label_err, first_err))\n            T[\"labels\"] = time.perf_counter()\n\n            tr.Commit()\n        finally:\n            tr.Dispose()\n    finally:\n        dlock.Dispose()\n\n    # --------------------------------------------------------------------- #\n    # FASE 2 (solo CROSS): estilo + rangos en transaccion aislada.\n    # Si falla, la superficie/contornos/etiquetas siguen intactos.\n    # --------------------------------------------------------------------- #\n    if mode == \"cross\":\n        dlock2 = doc.LockDocument()\n        try:\n            tr2 = db.TransactionManager.StartTransaction()\n            try:\n                target = None\n                for sid in cdoc.GetSurfaceIds():\n                    s = tr2.GetObject(sid, OpenMode.ForRead)\n                    if s.Name == out_surf_name:\n                        target = tr2.GetObject(sid, OpenMode.ForWrite)\n                        break\n                if target is None:\n                    log.append(\"AVISO: superficie no localizada para estilo/analisis (fase 2).\")\n                else:\n                    assign_style_and_ranges(target, cdoc, z_min_surf, z_max_surf,\n                                            warn_slope_pct, max_slope_pct, log)\n                tr2.Commit()\n            finally:\n                tr2.Dispose()\n        finally:\n            dlock2.Dispose()\n        T[\"style2\"] = time.perf_counter()\n\n    # --------------------------------------------------------------------- #\n    # Resumen\n    # --------------------------------------------------------------------- #\n    log.append(\"\")\n    log.append(\"=== RESUMEN ===\")\n    log.append(\"Puntos clasificados (dentro):    {}\".format(n_ok + n_warn + n_ko))\n    log.append(\"  Verde   (|p| <= {} %):         {}\".format(warn_slope_pct, n_ok))\n    log.append(\"  Amarillo({} - {} %):           {}\".format(warn_slope_pct, max_slope_pct, n_warn))\n    log.append(\"  Rojo    (|p| > {} %):          {}\".format(max_slope_pct, n_ko))\n    log.append(\"Puntos con error de muestreo:    {}\".format(n_err))\n    log.append(\"Rango pendiente:                 {:.2f} % a {:.2f} %\".format(z_min_surf, z_max_surf))\n    log.append(\"Superficie creada:               {}\".format(out_surf_name))\n\n    # --------------------------------------------------------------------- #\n    # Tiempos\n    # --------------------------------------------------------------------- #\n    T[\"end\"] = time.perf_counter()\n\n    def tl(lbl, k1, k2):\n        if k1 in T and k2 in T:\n            log.append(\"  {:<27}{:>7.2f} s\".format(lbl, T[k2] - T[k1]))\n\n    log.append(\"\")\n    log.append(\"=== TIEMPOS ===\")\n    tl(\"Lectura geometria:\", \"start\", \"read\")\n    tl(\"Filtrado contorno:\", \"read\", \"filter\")\n    tl(\"Calculo pendientes:\", \"filter\", \"calc\")\n    tl(\"Creacion superficie:\", \"calc\", \"surface\")\n    if mode == \"axial\":\n        tl(\"Etiquetas:\", \"surface\", \"labels\")\n    else:\n        tl(\"Etiquetas:\", \"surface\", \"labels\")\n        tl(\"Estilo + rangos (fase 2):\", \"labels\", \"style2\")\n    log.append(\"  \" + \"-\" * 34)\n    log.append(\"  {:<27}{:>7.2f} s\".format(\"TOTAL:\", T[\"end\"] - T[\"start\"]))\n\n    return \"\\n\".join(log)\n\n\ntry:\n    OUT = run()\nexcept Exception as ex:\n    OUT = \"ERROR:\\n\" + str(ex) + \"\\n\\n\" + traceback.format_exc()\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "f6e75bdf2e4a4c27a2d70b6c9f53e8c9",
      "NodeType": "PythonScriptNode",
