      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\n# Compone la subfase: base + orientacion + objetivo\n# (\"1\"+\"NS\"+TERRENO -> \"1NS\"; \"1\"+\"NS\"+TRACKERS -> \"1NST\")\nbase = str(IN[0]).strip()\nori = str(IN[1]).strip().upper() if IN[1] is not None else \"\"\nobj = str(IN[2]).strip().upper() if IN[2] is not None else \"TERRENO\"\nsuf = \"NS\" if \"NS\" in ori else (\"EO\" if \"EO\" in ori else \"\")\nt = \"T\" if obj.startswith(\"TRACK\") else \"\"\nOUT = base + suf + t\n",
