    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\n# NODO CONFIG (modo sombra: valida y muestra la config, pero\n# los parametros del script siguen viniendo de los inputs de siempre)\nimport os\nimport sys\nimport importlib\n\n# Localizador de pipeline.py sin rutas fijas. Orden:\n#   1) instalado con instalar.bat (site-packages del Python de Dynamo)\n#   2) variable de entorno PIPELINE_HOME\n#   3) carpeta del proyecto (hasta 3 niveles sobre el DWG activo)\ndef _cargar_pipeline():\n    probadas = []\n    try:\n        import pipeline as _m\n        importlib.reload(_m)\n        return _m, \"pipeline.py: importado desde \" + str(\n            getattr(_m, \"__file__\", \"?\"))\n    except ImportError:\n        probadas.append(\"import directo (site-packages de Dynamo)\")\n    candidatas = []\n    ph = os.environ.get(\"PIPELINE_HOME\", \"\")\n    if ph:\n        candidatas.append(ph)\n    try:\n        import clr\n        clr.AddReference(\"AcMgd\")\n        from Autodesk.AutoCAD.ApplicationServices import (\n            Application as _A)\n        _doc = _A.DocumentManager.MdiActiveDocument\n        if _doc is not None:\n            _c = os.path.dirname(os.path.abspath(str(_doc.Name)))\n            for _ in range(3):\n                candidatas.append(_c)\n                _p = os.path.dirname(_c)\n                if _p == _c:\n                    break\n                _c = _p\n    except Exception as ex:\n        probadas.append(\"DWG activo no disponible: \" + str(ex)[:80])\n    for _r in candidatas:\n        probadas.append(_r)\n        if _r and os.path.exists(os.path.join(_r, \"pipeline.py\")):\n            if _r not in sys.path:\n                sys.path.insert(0, _r)\n            import pipeline as _m\n            importlib.reload(_m)\n            return _m, \"pipeline.py: cargado desde \" + _r\n    log = [\"KO: no se encontro pipeline.py. Rutas probadas:\"]\n    log += [\"  - \" + p for p in probadas]\n    log.append(\"Solucion: doble clic en instalar.bat, o copia pipeline.py \"\n               \"a la carpeta del proyecto (junto a config_proyecto.xlsx), \"\n               \"o define la variable de entorno PIPELINE_HOME.\")\n    return None, \"\\n\".join(log)\n\n\npipeline, _msg_carga = _cargar_pipeline()\n\nif pipeline is None:\n    OUT = [False, _msg_carga, \"\", \"\"]\nelse:\n    OUT = pipeline.nodo_config(str(IN[0]))\n    try:\n        OUT[1] = _msg_carga + \"\\n\" + OUT[1]\n    except Exception:\n        pass\n",
