    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\n# =============================================================================\n# Volumen_MDT.dyn  -  Nodo 2: tablas de leyenda de volumen  (VERSION FINAL v4)\n# Civil 3D 2024 / Dynamo / CPython3\n#\n# Recibe del nodo 1:\n#   IN[0] = [log, [(nombre, px, py, table_x, table_y), ...], APLICAR, t0, bbox]\n#\n# POR QUE ESTA VERSION (corrige \"[SKIP] en todas las zonas\"):\n#   La version anterior comprobaba con ssget si habia superficie en el punto,\n#   filtrando por el tipo \"AECC_TIN_VOLUME_SURFACE\". Ese filtro NO casa con las\n#   superficies de volumen en este Civil 3D -> ssget devolvia nil siempre ->\n#   todas las zonas se saltaban -> 0 tablas.\n#\n#   Solucion: se ELIMINA la comprobacion ssget y se vuelve al PICADO DIRECTO\n#   por coordenada (el metodo que creo las 9 tablas en su dia), anadiendo lo\n#   que si ayuda y no depende de ssget:\n#     - ZOOM a la zona + REGEN antes de picar (superficies dibujadas y en vista;\n#       el picado por coordenada necesita el punto en pantalla).\n#     - Envios cortos (cada SendStringToExecute < ~120 chars) -> sin truncado.\n#     - ZOOM Extents al final para que se vean las tablas creadas.\n#   El punto de picado interior (calculado por el nodo 1) ya acierta en las 9\n#   zonas. Tras crear las tablas, restaura el estilo 'elevaciones'.\n#\n#   NOTA C3D 2024: ADDSURFACELEGENDTABLE no respeta la preseleccion -> se pica.\n#\n# Al final, anade al log el TIEMPO total de ejecucion del grafo.\n# APLICAR=False -> dry-run: NO envia nada; vuelca al log todas las lineas.\n# =============================================================================\n\nimport clr\nimport traceback\nimport time\n\nclr.AddReference('AcMgd')\nclr.AddReference('AcCoreMgd')\nclr.AddReference('AcDbMgd')\n\nfrom Autodesk.AutoCAD.ApplicationServices import Application as AcadApp\n\n\ndef _get(seq, i, default):\n    try:\n        return seq[i]\n    except Exception:\n        return default\n\n\n_in = IN[0]\nif isinstance(_in, (list, tuple)):\n    log_prev   = _get(_in, 0, [])\n    table_info = _get(_in, 1, [])\n    aplicar    = _get(_in, 2, True)\n    t0         = _get(_in, 3, None)\n    bbox       = _get(_in, 4, None)\nelse:\n    log_prev, table_info, aplicar, t0, bbox = [\"(entrada inesperada al nodo de tablas)\"], [], True, None, None\n\nlog = list(log_prev)\nlog.append(\"\")\nlog.append(\"=== Nodo 2: tablas de leyenda (picado directo, sin ssget) ===\")\n\n\ndef lq(s):\n    return s.replace(\"\\\\\", \"\\\\\\\\\").replace('\"', '\\\\\"')\n\n\ndef fn(v):\n    return \"{:.4f}\".format(float(v))\n\n\n# Restaura el estilo 'elevaciones' de una superficie por nombre (definir 1 vez)\nDEF_VT = ('(defun _vt (nm / d) (setq d (vla-get-surfaces (vla-get-civildocument '\n          '(vla-get-application (vla-get-activedocument (vlax-get-acad-object)))))) '\n          '(vl-catch-all-apply (function (lambda () '\n          '(vla-put-style (vla-item d nm) \"elevaciones\")))))')\n\ntry:\n    if not table_info:\n        log.append(\"Sin tablas que crear.\")\n    else:\n        doc = AcadApp.DocumentManager.MdiActiveDocument\n\n        sends = []   # cada elemento = una cadena para un SendStringToExecute\n\n        # 1) Zoom a la zona de los contornos + regen (para que el picado acierte)\n        if bbox:\n            minx, miny, maxx, maxy = bbox\n            m = max((maxx - minx), (maxy - miny)) * 0.15 + 5.0\n            sends.append(\"_.ZOOM\\n_W\\n{},{}\\n{},{}\\n\".format(\n                fn(minx - m), fn(miny - m), fn(maxx + m), fn(maxy + m)))\n        sends.append(\"_.REGEN\\n\")\n\n        # 2) Una tabla por zona: PICADO directo (texto de comando, lo que funciona)\n        names = []\n        for row in table_info:\n            if len(row) < 5:\n                log.append(\"  AVISO: fila sin punto de picado, salto: {}\".format(row))\n                continue\n            name, px, py, tx, ty = row[0], row[1], row[2], row[3], row[4]\n            names.append(name)\n            sends.append(\n                \"_.ADDSURFACELEGENDTABLE\\n\"\n                \"{},{}\\n\"   # pick: selecciona la superficie de volumen\n                \"E\\n\"       # tipo Elevation\n                \"D\\n\"       # Dynamic\n                \"{},{}\\n\".format(fn(px), fn(py), fn(tx), fn(ty)))\n            log.append(\"  {} : pick ({:.2f}, {:.2f}) -> tabla ({:.1f}, {:.1f})\".format(\n                name, px, py, tx, ty))\n\n        # 3) Restaurar estilo 'elevaciones' (despues de crear todas las tablas)\n        sends.append(\"(vl-load-com)\\n\")\n        sends.append(DEF_VT + \"\\n\")\n        for name in names:\n            sends.append('(_vt \"{}\")\\n'.format(lq(name)))\n\n        # 4) Zoom extents al final para que se vean las tablas\n        sends.append(\"_.ZOOM\\n_E\\n\")\n\n        max_len = max(len(s) for s in sends)\n        log.append(\"  (envios: {} | mas largo: {} chars)\".format(len(sends), max_len))\n\n        if aplicar:\n            for s in sends:\n                doc.SendStringToExecute(s, True, False, False)\n            log.append(\"\")\n            log.append(\">>> {} tablas enviadas por picado directo en {} llamadas cortas.\".format(\n                len(names), len(sends)))\n            log.append(\">>> Al terminar, AutoCAD hara ZOOM Extents: las tablas estaran a la derecha de las zonas.\")\n        else:\n            log.append(\"\")\n            log.append(\"SIMULACION: NO se ha enviado nada. Lineas que se enviarian:\")\n            log.append(\"-\" * 60)\n            for s in sends:\n                log.append(repr(s))\n            log.append(\"-\" * 60)\n\n    if t0 is not None:\n        log.append(\"\")\n        log.append(\"Tiempo de ejecucion (grafo Dynamo): {:.1f} s\".format(time.time() - t0))\n        log.append(\"(NO incluye el dibujado de tablas: AutoCAD lo ejecuta despues, al quedar libre)\")\n\n    OUT = \"\\n\".join(log)\n\nexcept Exception as ex:\n    log.append(\"ERROR: {}\".format(ex))\n    log.append(traceback.format_exc())\n    if t0 is not None:\n        log.append(\"Tiempo de ejecucion (grafo Dynamo): {:.1f} s\".format(time.time() - t0))\n    OUT = \"\\n\".join(log)\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "e36b1e7b32634b3fa669cbf9d22b406d",
      "NodeType": "PythonScriptNode",
