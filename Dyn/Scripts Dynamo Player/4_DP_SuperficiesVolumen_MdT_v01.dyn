    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\n# CONFIG: parametro 'superficie_trackers' desde config (indice 4).\n# Si la config es KO, BLOQUEA este parametro e incrusta la causa\n# (las lineas KO/AVISO del log de config) en el propio error.\nres = IN[0]\nif ((not isinstance(res, list)) or len(res) <= 4\n        or res[0] is not True):\n    detalle = \"el nodo de config no devolvio datos\"\n    try:\n        lineas = str(res[1]).splitlines()\n        malas = [l.strip() for l in lineas\n                 if \"KO\" in l or \"AVISO\" in l]\n        if malas:\n            detalle = \" | \".join(malas[-4:])\n        elif lineas:\n            detalle = \" | \".join(\n                l.strip() for l in lineas[-3:])\n    except Exception:\n        pass\n    raise Exception(\"CONFIG KO -> \" + detalle[:400])\nOUT = res[4]\n",
      "Engine": "CPython3",
