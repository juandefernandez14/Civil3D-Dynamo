      "Description": "Creates a string",
      "InputValue": "_contornos"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# IN[5]: BARRERA de sincronizacion del nodo NORMALIZAR (contenido ignorado).\n# -*- coding: utf-8 -*-\n# =============================================================================\n# Volumen_MDT.dyn  -  Nodo 1: superficies de volumen por zona  (VERSION FINAL v2)\n# Civil 3D 2024 / Dynamo / CPython3\n#\n# Por cada contorno cerrado en la capa indicada crea una TIN Volume Surface\n# (base = trackers, comparacion = MDT) con analisis de elevaciones, y deja la\n# informacion para que el nodo 2 genere su tabla de leyenda.\n#\n# Caracteristicas:\n#   - Re-ejecutable: borra los volumenes previos con el mismo prefijo.\n#   - Un unico barrido de superficies (base + comparacion + a-borrar).\n#   - Logging de avisos por zona (sin 'except: pass' silenciosos) [LOG-DISCIPLINA].\n#   - Modo APLICAR (dry-run): con False no escribe nada, solo informa.\n#   - Calcula un punto de PICADO interior GARANTIZADO por zona (no el\n#     centroide, que en zonas concavas se sale). El nodo 2 lo usa para\n#     seleccionar la superficie al crear la tabla. NOTA C3D 2024:\n#     ADDSURFACELEGENDTABLE NO respeta la preseleccion por nombre\n#     (sssetfirst/ssget) -> hay que seleccionar PICANDO.\n#\n# RENDIMIENTO: el coste dominante es TinVolumeSurface.Create contra el MDT.\n# Para acelerar con MDT grande, pasar en IN[1] el MDT recortado a la huella\n# (p.ej. '<MDT>_CROPPED'). No requiere tocar codigo.\n#\n# IN[0] : str    superficie base (trackers)\n# IN[1] : str    superficie comparacion (MDT; usar version recortada)\n# IN[2] : float  rugosidad en mm\n# IN[3] : str    prefijo del nombre volumen (ej: Volumen_MDT)\n# IN[4] : str    nombre de la capa de contornos\n#\n# OUT   : [log_lista, [(nombre, px, py, table_x, table_y), ...], APLICAR, t0, bbox]\n# =============================================================================\n\n# --- INTERRUPTOR DE SIMULACION ---------------------------------------------\n# True  = ejecuta de verdad (borra y crea superficies)\n# False = simulacion: NO escribe nada, solo informa zonas y tablas previstas\nAPLICAR = True\n# ---------------------------------------------------------------------------\n\nimport clr\nimport traceback\nimport time\n\nclr.AddReference('AcMgd')\nclr.AddReference('AcCoreMgd')\nclr.AddReference('AcDbMgd')\nclr.AddReference('AecBaseMgd')\nclr.AddReference('AeccDbMgd')\n\nfrom Autodesk.AutoCAD.ApplicationServices import Application as AcadApp\nfrom Autodesk.AutoCAD.DatabaseServices import (\n    OpenMode, ObjectId, Polyline, SymbolUtilityServices\n)\nfrom Autodesk.AutoCAD.Geometry import Point3d, Point3dCollection\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import (\n    TinVolumeSurface, SurfaceAnalysisElevationData\n)\nfrom Autodesk.Civil import SurfaceBoundaryType\nfrom Autodesk.AutoCAD.Colors import Color as AcadColor\n\nimport System\nfrom System import Array\n\n\ndef interior_point(poly):\n    \"\"\"Punto garantizado DENTRO del poligono (poly = [(x,y),...], abierto).\n    Metodo scanline: a varias alturas, intersecta con los bordes, empareja\n    en tramos interiores y devuelve el punto medio del tramo MAS ancho\n    (bien adentro, lejos de bordes). Cae dentro incluso en zonas concavas\n    donde el centroide se saldria. Fallback: centroide.\"\"\"\n    n = len(poly)\n    if n < 3:\n        return (sum(p[0] for p in poly) / n, sum(p[1] for p in poly) / n)\n    ys = [p[1] for p in poly]\n    ymin = min(ys); ymax = max(ys); h = ymax - ymin\n    best = None  # (ancho, x, y)\n    for frac in (0.5, 0.45, 0.55, 0.4, 0.6, 0.35, 0.65):\n        yc = ymin + frac * h\n        xs = []\n        for i in range(n):\n            x1, y1 = poly[i]\n            x2, y2 = poly[(i + 1) % n]\n            if (y1 <= yc < y2) or (y2 <= yc < y1):\n                t = (yc - y1) / (y2 - y1)\n                xs.append(x1 + t * (x2 - x1))\n        xs.sort()\n        k = 0\n        while k + 1 < len(xs):\n            w = xs[k + 1] - xs[k]\n            if best is None or w > best[0]:\n                best = (w, 0.5 * (xs[k] + xs[k + 1]), yc)\n            k += 2\n    if best is not None:\n        return (best[1], best[2])\n    return (sum(p[0] for p in poly) / n, sum(p[1] for p in poly) / n)\n\nbase_surf_name = str(IN[0])\ncomp_surf_name = str(IN[1])\nrugosidad_mm   = float(IN[2])\nprefix         = str(IN[3])\ncontour_layer  = str(IN[4])\nrugosidad_m    = rugosidad_mm / 1000.0\n\n_t0  = time.time()\nbbox = None\n\nlog = []\nlog.append(\"=== Volumen MDT v32 (split) - Crea volumenes ===\")\nlog.append(\"MODO: {}\".format(\"APLICAR (escribe)\" if APLICAR else \"SIMULACION (no escribe)\"))\nlog.append(\"Base: {} | Comp: {} | Capa: {}\".format(\n    base_surf_name, comp_surf_name, contour_layer))\nlog.append(\"\")\n\ntable_rows = []   # [(zone_name, table_x, table_y), ...] para el nodo de tablas\n\ntry:\n    doc  = AcadApp.DocumentManager.MdiActiveDocument\n    db   = doc.Database\n    cdoc = CivilApplication.ActiveDocument\n\n    contours = []\n    created_info = []   # nombres de las zonas efectivamente creadas\n\n    green = AcadColor.FromRgb(80, 200, 80)\n    red   = AcadColor.FromRgb(220, 50, 50)\n\n    dlock = doc.LockDocument()\n    try:\n        base_id = None\n        comp_id = None\n        style_picking_id = None\n        vol_prefix = prefix + \"_Zona\"\n        to_erase = []\n\n        tr0 = db.TransactionManager.StartTransaction()\n        try:\n            # ---- UNA sola pasada: base, comp y volumenes previos ----\n            for sid in cdoc.GetSurfaceIds():\n                try:\n                    s = tr0.GetObject(sid, OpenMode.ForRead)\n                    sn = s.Name\n                except Exception as ex_n:\n                    log.append(\"  aviso: superficie ilegible: {}\".format(str(ex_n)[:80]))\n                    continue\n                if sn == base_surf_name:\n                    base_id = sid\n                elif sn == comp_surf_name:\n                    comp_id = sid\n                if sn.startswith(vol_prefix):\n                    to_erase.append(sid)\n\n            if base_id is None:\n                raise Exception(\"Base '{}' no encontrada.\".format(base_surf_name))\n            if comp_id is None:\n                raise Exception(\"Comp '{}' no encontrada.\".format(comp_surf_name))\n\n            # ---- Leer contornos ----\n            ms_id = SymbolUtilityServices.GetBlockModelSpaceId(db)\n            btr = tr0.GetObject(ms_id, OpenMode.ForRead)\n            for oid in btr:\n                obj = tr0.GetObject(oid, OpenMode.ForRead)\n                if not isinstance(obj, Polyline):\n                    continue\n                if obj.Layer != contour_layer:\n                    continue\n                n = obj.NumberOfVertices\n                if n < 3:\n                    continue\n                pts = []\n                for i in range(n):\n                    p = obj.GetPoint2dAt(i)\n                    pts.append((p.X, p.Y))\n                contours.append(pts)\n\n            if not contours:\n                raise Exception(\"Sin contornos en '{}'.\".format(contour_layer))\n            contours.sort(key=lambda c: min(p[0] for p in c))\n            log.append(\"Contornos encontrados: {}\".format(len(contours)))\n\n            # ---- Estilo full-coverage para que el comando de tabla seleccione ----\n            ss = cdoc.Styles.SurfaceStyles\n            for tv in [\"analisis de pendientes\",\n                       \"Analisis de pendientes\",\n                       \"Analisis de Pendientes\",\n                       \"ANALISIS DE PENDIENTES\",\n                       \"Contours 1m and 5m (Background)\",\n                       \"Standard\",\n                       \"Triangles\"]:\n                try:\n                    style_picking_id = ss.get_Item(tv)\n                    log.append(\"Estilo (full-coverage): '{}'\".format(tv))\n                    break\n                except:\n                    continue\n            if style_picking_id is None:\n                for sid_s in ss:\n                    try:\n                        s_obj = tr0.GetObject(sid_s, OpenMode.ForRead)\n                        nm = s_obj.Name\n                        if nm and not nm.startswith(\"_No\"):\n                            style_picking_id = sid_s\n                            log.append(\"Estilo (fallback): '{}'\".format(nm))\n                            break\n                    except:\n                        continue\n\n            # ---- Borrar volumenes previos (solo si APLICAR) ----\n            if APLICAR:\n                n_erased = 0\n                for sid in to_erase:\n                    try:\n                        tr0.GetObject(sid, OpenMode.ForWrite).Erase()\n                        n_erased += 1\n                    except Exception as ex_e:\n                        log.append(\"  aviso: no se pudo borrar previo: {}\".format(str(ex_e)[:80]))\n                log.append(\"Volumenes previos borrados: {}\".format(n_erased))\n            else:\n                log.append(\"SIMULACION: borraria {} volumenes previos.\".format(len(to_erase)))\n\n            tr0.Commit()\n        finally:\n            tr0.Dispose()\n\n        # ---- Geometria para colocar las tablas (igual layout que v31) ----\n        all_min_x = min(x for pts in contours for x, y in pts)\n        all_min_y = min(y for pts in contours for x, y in pts)\n        all_max_x = max(x for pts in contours for x, y in pts)\n        all_max_y = max(y for pts in contours for x, y in pts)\n        bbox = (all_min_x, all_min_y, all_max_x, all_max_y)\n        width = all_max_x - all_min_x\n        margin_x = max(width * 0.2, 100.0)\n        table_x = all_max_x + margin_x\n        table_spacing = 40.0\n\n        # ============================================================== #\n        # FASE 1: Crear volumenes (o simular)\n        # ============================================================== #\n        if APLICAR:\n            tr = db.TransactionManager.StartTransaction()\n            try:\n                for i, pts in enumerate(contours):\n                    zone_name = \"{}_Zona{:02d}\".format(prefix, i + 1)\n                    try:\n                        vol_id = TinVolumeSurface.Create(zone_name, base_id, comp_id)\n                        vol_surf = tr.GetObject(vol_id, OpenMode.ForWrite)\n\n                        if style_picking_id is not None:\n                            vol_surf.StyleId = style_picking_id\n\n                        pc = Point3dCollection()\n                        for (x, y) in pts:\n                            pc.Add(Point3d(x, y, 0.0))\n                        if (pts[0][0], pts[0][1]) != (pts[-1][0], pts[-1][1]):\n                            pc.Add(Point3d(pts[0][0], pts[0][1], 0.0))\n                        vol_surf.BoundariesDefinition.AddBoundaries(\n                            pc, 1.0, SurfaceBoundaryType.Outer, True)\n\n                        # min/max elevacion (diferencia) para las bandas de analisis\n                        min_e = -50.0; max_e = 50.0\n                        try:\n                            gp = vol_surf.GetGeneralProperties()\n                            gt = clr.GetClrType(type(gp))\n                            for p in gt.GetProperties():\n                                pn = p.Name.lower()\n                                if \"min\" in pn and \"elev\" in pn:\n                                    min_e = p.GetValue(gp)\n                                elif \"max\" in pn and \"elev\" in pn:\n                                    max_e = p.GetValue(gp)\n                        except Exception as ex_gp:\n                            log.append(\"    {} aviso props: {}\".format(zone_name, str(ex_gp)[:100]))\n\n                        try:\n                            d1 = SurfaceAnalysisElevationData(min_e, -rugosidad_m, green)\n                            d2 = SurfaceAnalysisElevationData(rugosidad_m, max_e, red)\n                            vol_surf.Analysis.SetElevationData(\n                                Array[SurfaceAnalysisElevationData]([d1, d2]))\n                        except Exception as ex_an:\n                            log.append(\"    {} aviso analisis: {}\".format(zone_name, str(ex_an)[:100]))\n\n                        try:\n                            vp = vol_surf.GetVolumeProperties()\n                            r = (vp.UnadjustedCutVolume / vp.UnadjustedFillVolume\n                                 if vp.UnadjustedFillVolume > 0 else 0)\n                            log.append(\"  {}: Corte {:.0f}  Relleno {:.0f}  ratio {:.2f}\".format(\n                                zone_name, vp.UnadjustedCutVolume, vp.UnadjustedFillVolume, r))\n                        except Exception as ex_vp:\n                            log.append(\"    {} aviso volumen: {}\".format(zone_name, str(ex_vp)[:100]))\n\n                        created_info.append(zone_name)\n                    except Exception as ex_v:\n                        log.append(\"  ERROR creando {}: {}\".format(zone_name, str(ex_v)[:160]))\n\n                tr.Commit()\n            finally:\n                tr.Dispose()\n            log.append(\"\")\n            log.append(\"{} volumenes creados de {} contornos.\".format(\n                len(created_info), len(contours)))\n        else:\n            for i, pts in enumerate(contours):\n                created_info.append(\"{}_Zona{:02d}\".format(prefix, i + 1))\n            log.append(\"\")\n            log.append(\"SIMULACION: crearia {} volumenes: {}\".format(\n                len(created_info), \", \".join(created_info)))\n\n        # ---- Tablas: solo para zonas REALMENTE creadas ----\n        # Punto de picado = interior garantizado de la zona (NO el centroide).\n        # zone_name \"..._Zona{n:02d}\" -> indice n-1 en contours (mismo orden).\n        for zone_name in created_info:\n            try:\n                zi = int(zone_name.split(\"Zona\")[-1]) - 1\n            except Exception:\n                zi = 0\n            pts = contours[zi]\n            px, py = interior_point(pts)\n            ty = all_max_y - zi * table_spacing\n            table_rows.append((zone_name, px, py, table_x, ty))\n            log.append(\"  tabla {} : pick interior ({:.2f}, {:.2f}) -> tabla ({:.1f}, {:.1f})\".format(\n                zone_name, px, py, table_x, ty))\n\n    finally:\n        dlock.Dispose()\n\n    log.append(\"\")\n    log.append(\"=== Volumenes OK, pasando al nodo de tablas ===\")\n    OUT = [log, table_rows, APLICAR, _t0, bbox]\n\nexcept Exception as ex:\n    log.append(\"ERROR: {}\".format(ex))\n    log.append(traceback.format_exc())\n    OUT = [log, [], APLICAR, _t0, bbox]\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "1443590f895a48dc8c2a30075facc5b3",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "f91f1158bc644a85b421ed6b0a25a8bd",
          "Name": "IN[0]",
          "Description": "Input #0",
