      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "bfbb8c110a8e4c058dd408d0f783e255",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "4009baf2b7f54134ad671c4f66d0a14a",
          "Name": "IN[0]",
          "Description": "Input #0",
