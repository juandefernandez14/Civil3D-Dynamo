    {
      "ConcreteType": "CoreNodeModels.Input.BoolSelector, CoreNodeModels",
      "Id": "3122d4837fe244fba53a1690524fb614",
      "NodeType": "BooleanInputNode",
      "InputValue": true,
      "Inputs": [],
      "Outputs": [
        {
          "Id": "03301ed15b604420b66a8ec3ed5b55c1",
          "Name": "",
          "Description": "Boolean",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
