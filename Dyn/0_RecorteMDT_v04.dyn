    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# IN[8]: BARRERA de sincronizacion del nodo NORMALIZAR (contenido ignorado).\n# -*- coding: utf-8 -*-\n# =============================================================================\n# 0_RecorteMDT_v07.dyn  -  Nodo Python\n# Civil 3D 2024 / Dynamo / CPython3\n#\n# QUE CAMBIA EN v07 (respecto a v06): CIERRE VIRTUAL de contornos.\n#   En produccion aparecen contornos \"cerrados a la vista\" pero con\n#   Closed=No y un mini-hueco entre ultimo y primer vertice (caso real:\n#   5 de 10 zonas ignoradas en MDT_Recortado_Casares III). v07 los acepta\n#   si el hueco es <= TOL_CIERRE (0.5 m), cerrandolos virtualmente y\n#   avisando en el log (handle + hueco). El offset se calcula sobre un\n#   CLON CERRADO EN MEMORIA construido desde los vertices, uniforme para\n#   todas las zonas (y se hace Dispose del clon). Huecos mayores siguen\n#   ignorandose, ahora informando del tamanyo del hueco.\n#\n# QUE CAMBIA EN v06 (respecto a v05): RECORTE CON HALO (contorno + offset).\n#\n#   CAUSA RAIZ que corrige: en v05 la superficie recortada terminaba\n#   EXACTAMENTE en la linea de contorno. Consultar cota SOBRE el borde de un\n#   TIN es fragil: en tramos rectos cae dentro, pero en las esquinas convexas\n#   el punto queda fuera por micras y FindElevationAtXY /\n#   AssignElevationsFromSurface fallan EN SILENCIO -> puntos a Z=0 en las\n#   FLs de contorno del Script 2 -> vertices a cota 0 en la superficie de\n#   trackers -> \"embudos\" -> volumenes fantasma de hasta ~250 m en Script 4.\n#\n#   SOLUCION (propuesta de Juande): recortar por el contorno DESFASADO\n#   'OFFSET_BORDE' m HACIA FUERA (defecto 1.0). Asi la linea de contorno\n#   original queda 1 m DENTRO de los datos en todo su recorrido, y cualquier\n#   consulta sobre ella (esquinas incluidas) es una consulta interior que no\n#   puede fallar por redondeo. Arregla el problema en el productor para\n#   todos los consumidores (Script 2, replanteo, futuros).\n#\n#   Detalles v06:\n#   - Offset hacia fuera con GetOffsetCurves(+/-d) eligiendo el de MAYOR\n#     area (tecnica del Script 5, invertida). Curvas en memoria: se leen y\n#     se hace Dispose, NO se anyaden al dibujo.\n#   - El boundary se pasa como Point3dCollection del contorno DESFASADO con\n#     COTA REAL del MDT original en cada punto (leccion aprendida: el corte\n#     exacto inyecta la Z de esos puntos en el TIN; inyectamos verdad, no 0).\n#     Si un punto no tiene cota (borde del MDT del cliente), hereda la del\n#     vecino bueno mas cercano y se cuenta en el log.\n#   - Ancla ADEMAS la linea de contorno ORIGINAL (vertices + muestreo cada\n#     'paso' m) con cota real: es la linea que consultaran los scripts de\n#     aguas abajo y queda clavada a datos verdaderos.\n#   - El margen de filtrado de vertices se auto-ajusta a >= OFFSET + margen\n#     pedido, para que haya datos del MDT hasta la nueva linea de corte.\n#   - Volumenes del Script 4: SIN CAMBIO (cada volumen sigue recortado por\n#     el contorno ORIGINAL; el halo queda fuera de la interseccion).\n#\n# Entradas:\n#   IN[0] : str    nombre del MDT original (del cliente)\n#   IN[1] : str    capa de zonas (polilineas cerradas)\n#   IN[2] : str    nombre de la superficie nueva\n#   IN[3] : float  margen extra de filtrado en metros (defecto 1.0)\n#   IN[4] : str    aplicar cambios: \"N\" = dry-run (defecto), \"S\" = crear\n#   IN[5] : str    muestrear/anclar contorno original con cota real: \"S\"/\"N\"\n#   IN[6] : float  paso de muestreo del borde en metros (defecto 5.0)\n#   IN[7] : float  OFFSET_BORDE hacia fuera en metros (defecto 1.0)\n#\n# Salida:\n#   OUT   : str    log\n# =============================================================================\n\nimport clr\nimport math\nimport time\nimport traceback\n\nclr.AddReference('AcMgd')\nclr.AddReference('AcCoreMgd')\nclr.AddReference('AcDbMgd')\nclr.AddReference('AecBaseMgd')\nclr.AddReference('AeccDbMgd')\n\nfrom Autodesk.AutoCAD.ApplicationServices import Application as AcadApp\nfrom Autodesk.AutoCAD.DatabaseServices import (\n    OpenMode, Polyline, SymbolUtilityServices\n)\nfrom Autodesk.AutoCAD.Geometry import Point2d, Point3d, Point3dCollection\nfrom Autodesk.Civil import SurfaceBoundaryType\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import TinSurface\n\n# --------------------------------------------------------------------------- #\n# Inputs\n# --------------------------------------------------------------------------- #\nmdt_name    = str(IN[0])\nzones_layer = str(IN[1])\nout_name    = str(IN[2])\nmargin_in   = float(IN[3]) if (len(IN) > 3 and IN[3] is not None) else 1.0\napply_raw   = str(IN[4]).strip().upper() if (len(IN) > 4 and IN[4] is not None) else \"N\"\ndo_apply    = apply_raw in (\"S\", \"SI\", \"Y\", \"YES\", \"1\", \"TRUE\")\nsamp_raw    = str(IN[5]).strip().upper() if (len(IN) > 5 and IN[5] is not None) else \"S\"\ndo_sample   = samp_raw in (\"S\", \"SI\", \"Y\", \"YES\", \"1\", \"TRUE\")\nsamp_step   = float(IN[6]) if (len(IN) > 6 and IN[6] is not None) else 5.0\nif samp_step <= 0.1:\n    samp_step = 0.1\noffset_b    = float(IN[7]) if (len(IN) > 7 and IN[7] is not None) else 1.0\nif offset_b < 0.0:\n    offset_b = 0.0\n\n# margen total de filtrado: datos hasta la linea de corte (offset) + margen\nmargin = offset_b + max(margin_in, 1.0)\n\n# hueco maximo (m) entre ultimo y primer vertice para cerrar virtualmente\nTOL_CIERRE = 0.50\n\nlog = []\ndef w(s):\n    log.append(str(s))\n\n_t0 = time.perf_counter()\n_tiempos = []\ndef _fase(etq, t_ini):\n    _tiempos.append((etq, time.perf_counter() - t_ini))\n\n# --------------------------------------------------------------------------- #\n# Geometria pura\n# --------------------------------------------------------------------------- #\ndef pip(px, py, poly):\n    inside = False\n    n = len(poly)\n    if n < 3:\n        return False\n    j = n - 1\n    for i in range(n):\n        xi, yi = poly[i]\n        xj, yj = poly[j]\n        if ((yi > py) != (yj > py)) and (px < (xj - xi) * (py - yi) / (yj - yi) + xi):\n            inside = not inside\n        j = i\n    return inside\n\ndef dist_pt_seg(px, py, ax, ay, bx, by):\n    dx = bx - ax\n    dy = by - ay\n    if dx == 0.0 and dy == 0.0:\n        return math.hypot(px - ax, py - ay)\n    t = ((px - ax) * dx + (py - ay) * dy) / (dx * dx + dy * dy)\n    if t < 0.0:\n        t = 0.0\n    elif t > 1.0:\n        t = 1.0\n    return math.hypot(px - (ax + t * dx), py - (ay + t * dy))\n\ndef min_dist_poly(px, py, poly):\n    n = len(poly)\n    best = 1e18\n    j = n - 1\n    for i in range(n):\n        d = dist_pt_seg(px, py, poly[j][0], poly[j][1], poly[i][0], poly[i][1])\n        if d < best:\n            best = d\n        j = i\n    return best\n\ndef in_zone(px, py, poly, bbox, marg):\n    if px < bbox[0] or px > bbox[2] or py < bbox[1] or py > bbox[3]:\n        return False\n    if pip(px, py, poly):\n        return True\n    return min_dist_poly(px, py, poly) <= marg\n\ndef ring_subdividido(pts_xy, paso):\n    \"\"\"Anillo ORDENADO: vertices originales + subdivisiones cada 'paso' m.\n    pts_xy abierto (sin repetir el primero). Incluye siempre cada vertice\n    (t=0 de cada segmento) -> las esquinas quedan exactas.\"\"\"\n    ring = []\n    n = len(pts_xy)\n    for i in range(n):\n        ax, ay = pts_xy[i]\n        bx, by = pts_xy[(i + 1) % n]\n        seg = math.hypot(bx - ax, by - ay)\n        nsub = max(1, int(seg / paso))\n        for s in range(nsub):\n            t = float(s) / float(nsub)\n            ring.append((ax + t * (bx - ax), ay + t * (by - ay)))\n    return ring\n\n# --------------------------------------------------------------------------- #\n# Offset hacia fuera (tecnica Script 5, invertida: MAYOR area)\n# --------------------------------------------------------------------------- #\ndef leer_polyline_xy(pl, paso):\n    \"\"\"Vertices XY de una Polyline en orden. Si tiene bulges, muestrea por\n    distancia (orden garantizado).\"\"\"\n    nv = pl.NumberOfVertices\n    tiene_bulge = False\n    for i in range(nv):\n        try:\n            if abs(pl.GetBulgeAt(i)) > 1e-9:\n                tiene_bulge = True\n                break\n        except Exception:\n            break\n    if not tiene_bulge:\n        pts = []\n        for i in range(nv):\n            p2 = pl.GetPoint2dAt(i)\n            pts.append((p2.X, p2.Y))\n        if len(pts) > 1 and abs(pts[0][0] - pts[-1][0]) < 1e-9 and abs(pts[0][1] - pts[-1][1]) < 1e-9:\n            pts.pop()\n        return pts\n    # con arcos: muestreo por distancia\n    pts = []\n    try:\n        L = float(pl.Length)\n        n = max(8, int(L / max(paso, 0.5)))\n        for k in range(n):\n            p = pl.GetPointAtDist(min(k * L / n, L - 1e-6))\n            pts.append((p.X, p.Y))\n    except Exception:\n        pass\n    return pts\n\ndef clon_cerrado(pts_xy):\n    \"\"\"Polyline CERRADA en memoria (no residente en BD) desde vertices XY.\n    Sirve para GetOffsetCurves con independencia del flag Closed y de los\n    mini-huecos de la polilinea original. El llamador debe hacer Dispose.\"\"\"\n    pl = Polyline()\n    for i, (x, y) in enumerate(pts_xy):\n        pl.AddVertexAt(i, Point2d(x, y), 0.0, 0.0, 0.0)\n    pl.Closed = True\n    return pl\n\n\ndef offset_hacia_fuera(pl, dist, paso, log, etiqueta):\n    \"\"\"Devuelve la lista XY (abierta) del contorno desfasado 'dist' m hacia\n    FUERA, o None si falla. Prueba +dist y -dist y elige la de MAYOR area.\n    Las curvas del offset son objetos en memoria: se leen y se Dispose.\"\"\"\n    if dist <= 0.0:\n        return None\n    try:\n        area_orig = abs(float(pl.Area))\n    except Exception:\n        area_orig = None\n    best_pts = None\n    best_area = -1.0\n    for sgn in (1.0, -1.0):\n        col = None\n        try:\n            col = pl.GetOffsetCurves(sgn * dist)\n        except Exception as ex_of:\n            w(\"  {} offset {}{:.2f} fallo: {}\".format(\n                etiqueta, \"+\" if sgn > 0 else \"-\", dist, str(ex_of)[:90]))\n            continue\n        try:\n            for obj in col:\n                try:\n                    if isinstance(obj, Polyline):\n                        a = None\n                        try:\n                            a = abs(float(obj.Area))\n                        except Exception:\n                            a = None\n                        pts = leer_polyline_xy(obj, paso)\n                        if a is None and len(pts) >= 3:\n                            s = 0.0\n                            m = len(pts)\n                            for i in range(m):\n                                x1, y1 = pts[i]\n                                x2, y2 = pts[(i + 1) % m]\n                                s += x1 * y2 - x2 * y1\n                            a = abs(s) * 0.5\n                        if a is not None and a > best_area and len(pts) >= 3:\n                            best_area = a\n                            best_pts = pts\n                finally:\n                    try:\n                        obj.Dispose()\n                    except Exception:\n                        pass\n        finally:\n            try:\n                col.Dispose()\n            except Exception:\n                pass\n    if best_pts is None:\n        return None\n    if area_orig is not None and best_area <= area_orig:\n        w(\"  {} AVISO: ningun offset AUMENTA el area (orig {:.1f}, mejor {:.1f})\".format(\n            etiqueta, area_orig, best_area))\n        return None\n    return best_pts\n\n# --------------------------------------------------------------------------- #\n# Documento\n# --------------------------------------------------------------------------- #\nadoc = AcadApp.DocumentManager.MdiActiveDocument\ndb = adoc.Database\ncivdoc = CivilApplication.ActiveDocument\n\nw(\"=== RECORTE MDT POR ZONAS v06 (halo = contorno + offset) ===\")\nw(\"MDT:          '\" + mdt_name + \"'\")\nw(\"zonas:        capa '\" + zones_layer + \"'\")\nw(\"nueva:        '\" + out_name + \"'\")\nw(\"OFFSET borde: %.2f m (corte por el contorno desfasado hacia fuera)\" % offset_b)\nw(\"margen filtrado total: %.2f m (offset + margen extra %.2f)\" % (margin, max(margin_in, 1.0)))\nw(\"modo:         \" + (\"APLICAR (escribe en el DWG)\" if do_apply else \"DRY-RUN (solo lectura)\"))\nw(\"\")\n\ndlock = adoc.LockDocument() if do_apply else None\ntr = db.TransactionManager.StartTransaction()\ntry:\n    # ---- 1) localizar el MDT ------------------------------------------------\n    t = time.perf_counter()\n    sids = civdoc.GetSurfaceIds()\n    src = None\n    available = []\n    for i in range(sids.Count):\n        o = tr.GetObject(sids[i], OpenMode.ForRead)\n        available.append(o.Name)\n        if o.Name == mdt_name:\n            src = o\n\n    if src is None:\n        w(\"ERROR: no existe la superficie '\" + mdt_name + \"'. Superficies:\")\n        for nm in available:\n            w(\"   \" + nm)\n        raise Exception(\"Superficie MDT '{}' no encontrada (lista arriba).\".format(mdt_name))\n    if not isinstance(src, TinSurface):\n        w(\"AVISO: '\" + mdt_name + \"' no es TinSurface; continuo con cautela.\")\n\n    def cota_src(x, y):\n        try:\n            return float(src.FindElevationAtXY(x, y))\n        except Exception:\n            return None\n\n    # ---- 2) zonas: polilineas cerradas de la capa ---------------------------\n    ms_id = SymbolUtilityServices.GetBlockModelSpaceId(db)\n    ms = tr.GetObject(ms_id, OpenMode.ForRead)\n    zonas = []            # (pts_orig_xy, bbox_ampliada, pts_offset_xy)\n    n_abiertas = 0\n    n_offset_ko = 0\n    zi = 0\n    for oid in ms:\n        ent = tr.GetObject(oid, OpenMode.ForRead)\n        if not isinstance(ent, Polyline):\n            continue\n        if ent.Layer != zones_layer:\n            continue\n        if ent.NumberOfVertices < 3:\n            continue\n        pts = leer_polyline_xy(ent, samp_step)\n        if len(pts) < 3:\n            continue\n        # clasificacion de cierre sobre los EXTREMOS CRUDOS de la entidad\n        p0 = ent.GetPoint2dAt(0)\n        pn = ent.GetPoint2dAt(ent.NumberOfVertices - 1)\n        hueco = math.hypot(pn.X - p0.X, pn.Y - p0.Y)\n        if ent.Closed or hueco <= 1e-6:\n            pass  # cerrada de verdad\n        elif hueco <= TOL_CIERRE:\n            w(\"  aviso: handle {} cerrada VIRTUALMENTE (hueco {:.3f} m)\".format(\n                ent.Handle, hueco))\n        else:\n            n_abiertas += 1\n            w(\"  aviso: polilinea ABIERTA ignorada (handle {}, hueco {:.3f} m > {:.2f})\".format(\n                ent.Handle, hueco, TOL_CIERRE))\n            continue\n        zi += 1\n        etiqueta = \"zona {:02d}\".format(zi)\n        pts_off = None\n        if offset_b > 0:\n            clon = None\n            try:\n                clon = clon_cerrado(pts)\n                pts_off = offset_hacia_fuera(clon, offset_b, samp_step, w, etiqueta)\n            except Exception as ex_cl:\n                w(\"  {} clon/offset fallo: {}\".format(etiqueta, str(ex_cl)[:90]))\n            finally:\n                if clon is not None:\n                    try:\n                        clon.Dispose()\n                    except Exception:\n                        pass\n        if offset_b > 0 and pts_off is None:\n            n_offset_ko += 1\n            w(\"  {} SIN offset valido -> usara el contorno ORIGINAL como corte\".format(etiqueta))\n        xs = [p[0] for p in pts]\n        ys = [p[1] for p in pts]\n        bbox = (min(xs) - margin, min(ys) - margin, max(xs) + margin, max(ys) + margin)\n        zonas.append((pts, bbox, pts_off))\n\n    w(\"zonas cerradas: {} | abiertas ignoradas: {} | offsets KO: {}\".format(\n        len(zonas), n_abiertas, n_offset_ko))\n    if not zonas:\n        raise Exception(\"La capa '{}' no tiene polilineas cerradas validas.\".format(zones_layer))\n    _fase(\"Zonas + offsets\", t)\n\n    # ---- 3) filtrar vertices del MDT (buffer = offset + margen) -------------\n    t = time.perf_counter()\n    verts = src.Vertices\n    total = 0\n    kept = 0\n    kept_pts = Point3dCollection()\n    for v in verts:\n        total += 1\n        loc = v.Location\n        x = loc.X\n        y = loc.Y\n        for (poly, bbox, _off) in zonas:\n            if in_zone(x, y, poly, bbox, margin):\n                kept += 1\n                if do_apply:\n                    kept_pts.Add(Point3d(x, y, loc.Z))\n                break\n    dropped = total - kept\n    pct = (100.0 * dropped / total) if total else 0.0\n    w(\"\")\n    w(\"vertices MDT total:          \" + str(total))\n    w(\"dentro de zonas (+%.2f m):   %d\" % (margin, kept))\n    w(\"descartados (ahorro):        %d  (%.1f%%)\" % (dropped, pct))\n    _fase(\"Filtrado vertices\", t)\n\n    # ---- 4) anclar el contorno ORIGINAL con cota real -----------------------\n    # (la linea que consultaran los scripts de aguas abajo)\n    t = time.perf_counter()\n    n_anc = 0\n    n_anc_ko = 0\n    if do_sample:\n        for (poly, _bb, _off) in zonas:\n            for (px, py) in ring_subdividido(poly, samp_step):\n                z = cota_src(px, py)\n                if z is None:\n                    n_anc_ko += 1\n                    continue\n                n_anc += 1\n                if do_apply:\n                    kept_pts.Add(Point3d(px, py, z))\n        w(\"anclaje contorno original (paso %.1f m): %d puntos con cota, %d sin cota\"\n          % (samp_step, n_anc, n_anc_ko))\n    else:\n        w(\"anclaje contorno original: NO solicitado (IN[5]='N').\")\n    _fase(\"Anclaje contorno\", t)\n\n    # ---- 5) preparar boundaries (linea offset con cota real) ----------------\n    t = time.perf_counter()\n    boundaries_pc = []     # (etiqueta, lista [(x,y,z)])\n    tot_b = 0\n    tot_b_heredada = 0\n    for k, (poly, _bb, poff) in enumerate(zonas):\n        linea = poff if poff is not None else poly\n        ring = ring_subdividido(linea, samp_step)\n        vals = []\n        for (px, py) in ring:\n            vals.append((px, py, cota_src(px, py)))\n        # rellenar huecos heredando el vecino bueno mas cercano (anillo)\n        buenos = [i for i in range(len(vals)) if vals[i][2] is not None]\n        if not buenos:\n            w(\"  zona {:02d}: SIN COTA en toda la linea de corte -> boundary OMITIDO\".format(k + 1))\n            continue\n        m = len(vals)\n        fill = []\n        for i in range(m):\n            x, y, z = vals[i]\n            if z is None:\n                dmin = None\n                for j in buenos:\n                    dd = min(abs(i - j), m - abs(i - j))\n                    if dmin is None or dd < dmin:\n                        dmin = dd\n                        z = vals[j][2]\n                tot_b_heredada += 1\n            fill.append((x, y, z))\n        tot_b += m\n        boundaries_pc.append((\"zona {:02d}\".format(k + 1), fill))\n    w(\"boundaries preparados: {} | puntos: {} (cota heredada en {})\".format(\n        len(boundaries_pc), tot_b, tot_b_heredada))\n    _fase(\"Preparar boundaries\", t)\n\n    if not do_apply:\n        w(\"\")\n        w(\"DRY-RUN: no se ha creado nada. Plan al aplicar:\")\n        w(\"  1) borrar '{}' previa si existe\".format(out_name))\n        w(\"  2) crear TIN con {} vertices MDT + {} anclas de contorno\".format(kept, n_anc))\n        w(\"  3) {} boundaries por la LINEA OFFSET (+{:.2f} m) con cota real\".format(\n            len(boundaries_pc), offset_b))\n        w(\"Si el recuento encaja, pon IN[4]='S' y re-ejecuta.\")\n        tr.Commit()\n    else:\n        # ---- 6) borrar previa + crear ---------------------------------------\n        t = time.perf_counter()\n        for i in range(sids.Count):\n            o = tr.GetObject(sids[i], OpenMode.ForRead)\n            if o.Name == out_name:\n                o.UpgradeOpen()\n                o.Erase()\n                w(\"superficie previa '{}' borrada (re-ejecucion).\".format(out_name))\n                break\n        new_id = None\n        try:\n            new_id = TinSurface.Create(db, out_name)\n        except Exception as e1:\n            try:\n                new_id = TinSurface.Create(out_name, src.StyleId)\n            except Exception as e2:\n                w(\"ERROR creando TinSurface: \" + str(e1)[:90] + \" | \" + str(e2)[:90])\n                raise\n        new_surf = tr.GetObject(new_id, OpenMode.ForWrite)\n\n        try:\n            new_surf.AddVertices(kept_pts)\n            w(\"vertices anyadidos (AddVertices): \" + str(kept_pts.Count))\n        except Exception as ex:\n            w(\"ERROR AddVertices: \" + str(ex)[:160])\n            raise\n        _fase(\"Crear superficie\", t)\n\n        # ---- 7) boundaries: linea OFFSET, 1 Outer + resto Show, cota real ---\n        t = time.perf_counter()\n        bdef = new_surf.BoundariesDefinition\n        n_out = 0\n        n_show = 0\n        n_bko = 0\n        first = True\n        for (etq, fill) in boundaries_pc:\n            pc = Point3dCollection()\n            for (x, y, z) in fill:\n                pc.Add(Point3d(x, y, z))\n            if (fill[0][0], fill[0][1]) != (fill[-1][0], fill[-1][1]):\n                pc.Add(Point3d(fill[0][0], fill[0][1], fill[0][2]))\n            btype = SurfaceBoundaryType.Outer if first else SurfaceBoundaryType.Show\n            try:\n                bdef.AddBoundaries(pc, 1.0, btype, True)\n                if first:\n                    n_out += 1\n                else:\n                    n_show += 1\n            except Exception as ex_bn:\n                n_bko += 1\n                w(\"  boundary {} fallo: {}\".format(etq, str(ex_bn)[:120]))\n            first = False\n        w(\"boundaries: {} Outer + {} Show ({} KO)\".format(n_out, n_show, n_bko))\n\n        try:\n            new_surf.Rebuild()\n        except Exception as ex_rb:\n            w(\"AVISO Rebuild final: \" + str(ex_rb)[:100])\n        try:\n            w(\"\")\n            w(\"superficie '{}' creada. vertices: {}\".format(out_name, new_surf.Vertices.Count))\n        except Exception as ex:\n            w(\"superficie creada; recuento final ilegible: \" + str(ex)[:80])\n        _fase(\"Boundaries + rebuild\", t)\n\n        tr.Commit()\n        w(\"HECHO. MDT del cliente intacto. La linea de contorno original queda\")\n        w(\"%.2f m DENTRO de los datos: consultas sobre ella ya no pueden fallar.\" % offset_b)\n\nexcept Exception as ex:\n    w(\"\")\n    w(\"ERROR general: \" + str(ex)[:200])\n    w(traceback.format_exc()[:800])\n    try:\n        tr.Abort()\n    except Exception:\n        pass\nfinally:\n    try:\n        tr.Dispose()\n    except Exception:\n        pass\n    if dlock is not None:\n        try:\n            dlock.Dispose()\n        except Exception:\n            pass\n\nw(\"\")\nw(\"==== RESUMEN DE TIEMPOS ====\")\nfor (etq, seg) in _tiempos:\n    w(\"{:<27}{:>7.2f} s\".format(etq, seg))\nw(\"{:<27}{:>7.2f} s\".format(\"TOTAL\", time.perf_counter() - _t0))\n\nOUT = \"\\n\".join(log)\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "32191459cdff4904b1daa0964b4f9ab6",
