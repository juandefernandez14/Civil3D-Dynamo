      "InputValue": "_contornos offset"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\n# =============================================================================\n# Volumen_MDT.dyn  v31 (split) - Solo superficies de volumen + tablas\n# Civil 3D 2024 / Dynamo / CPython3\n#\n# Crea por cada contorno cerrado en la capa indicada:\n#   - Volumen_MDT_ZonaXX : TIN Volume Surface con analysis y tabla\n#\n# Las superficies se dejan con estilo \"picking\" (todo visible) porque\n# asi el comando de tabla puede seleccionarlas correctamente.\n#\n# IN[0] : str    superficie base (trackers)\n# IN[1] : str    superficie comparacion (MDT original)\n# IN[2] : float  rugosidad en mm\n# IN[3] : str    prefijo del nombre volumen (ej: Volumen_MDT)\n# IN[4] : str    nombre de la capa de contornos\n# =============================================================================\n\nimport clr\nimport traceback\n\nclr.AddReference('AcMgd')\nclr.AddReference('AcCoreMgd')\nclr.AddReference('AcDbMgd')\nclr.AddReference('AecBaseMgd')\nclr.AddReference('AeccDbMgd')\n\nfrom Autodesk.AutoCAD.ApplicationServices import Application as AcadApp\nfrom Autodesk.AutoCAD.DatabaseServices import (\n    OpenMode, ObjectId, Polyline, SymbolUtilityServices\n)\nfrom Autodesk.AutoCAD.Geometry import Point3d, Point3dCollection\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import (\n    TinVolumeSurface, SurfaceAnalysisElevationData\n)\nfrom Autodesk.Civil import SurfaceBoundaryType\nfrom Autodesk.AutoCAD.Colors import Color as AcadColor\n\nimport System\nfrom System import Array\n\nbase_surf_name = str(IN[0])\ncomp_surf_name = str(IN[1])\nrugosidad_mm   = float(IN[2])\nprefix         = str(IN[3])\ncontour_layer  = str(IN[4])\nrugosidad_m    = rugosidad_mm / 1000.0\n\nlog = []\nlog.append(\"=== Volumen MDT v31 (split) - Crea volumenes ===\")\nlog.append(\"\")\n\ntry:\n    doc  = AcadApp.DocumentManager.MdiActiveDocument\n    db   = doc.Database\n    cdoc = CivilApplication.ActiveDocument\n\n    contours = []\n    created_info = []\n\n    green = AcadColor.FromRgb(80, 200, 80)\n    red   = AcadColor.FromRgb(220, 50, 50)\n\n    dlock = doc.LockDocument()\n    try:\n        base_id = None\n        comp_id = None\n        style_picking_id = None\n\n        tr0 = db.TransactionManager.StartTransaction()\n        try:\n            # Localizar superficies\n            for sid in cdoc.GetSurfaceIds():\n                s = tr0.GetObject(sid, OpenMode.ForRead)\n                try:\n                    sn = s.Name\n                except:\n                    continue\n                if sn == base_surf_name:\n                    base_id = sid\n                elif sn == comp_surf_name:\n                    comp_id = sid\n            if base_id is None:\n                raise Exception(\"Base '{}' no encontrada.\".format(\n                    base_surf_name))\n            if comp_id is None:\n                raise Exception(\"Comp '{}' no encontrada.\".format(\n                    comp_surf_name))\n\n            # Leer contornos\n            ms_id = SymbolUtilityServices.GetBlockModelSpaceId(db)\n            btr = tr0.GetObject(ms_id, OpenMode.ForRead)\n            for oid in btr:\n                obj = tr0.GetObject(oid, OpenMode.ForRead)\n                if not isinstance(obj, Polyline):\n                    continue\n                if obj.Layer != contour_layer:\n                    continue\n                n = obj.NumberOfVertices\n                if n < 3:\n                    continue\n                pts = []\n                for i in range(n):\n                    p = obj.GetPoint2dAt(i)\n                    pts.append((p.X, p.Y))\n                contours.append(pts)\n\n            if not contours:\n                raise Exception(\"Sin contornos en '{}'.\".format(\n                    contour_layer))\n            contours.sort(key=lambda c: min(p[0] for p in c))\n            log.append(\"Contornos: {}\".format(len(contours)))\n\n            # Eliminar volumenes anteriores con mismo prefijo\n            vol_prefix = prefix + \"_Zona\"\n            to_erase = []\n            for sid in cdoc.GetSurfaceIds():\n                s = tr0.GetObject(sid, OpenMode.ForRead)\n                try:\n                    sn = s.Name\n                except:\n                    continue\n                if sn.startswith(vol_prefix):\n                    to_erase.append(sid)\n            for sid in to_erase:\n                tr0.GetObject(sid, OpenMode.ForWrite).Erase()\n\n            # Buscar estilo para picking (todo visible)\n            ss = cdoc.Styles.SurfaceStyles\n            for tv in [\"analisis de pendientes\",\n                       \"Analisis de pendientes\",\n                       \"Analisis de Pendientes\",\n                       \"ANALISIS DE PENDIENTES\",\n                       \"Contours 1m and 5m (Background)\",\n                       \"Standard\",\n                       \"Triangles\"]:\n                try:\n                    style_picking_id = ss.get_Item(tv)\n                    log.append(\"Estilo picking: '{}'\".format(tv))\n                    break\n                except:\n                    continue\n\n            # Fallback\n            if style_picking_id is None:\n                for sid_s in ss:\n                    try:\n                        s_obj = tr0.GetObject(sid_s, OpenMode.ForRead)\n                        nm = s_obj.Name\n                        if nm and not nm.startswith(\"_No\"):\n                            style_picking_id = sid_s\n                            log.append(\"Picking (fallback): '{}'\".format(nm))\n                            break\n                    except:\n                        continue\n\n            tr0.Commit()\n        finally:\n            tr0.Dispose()\n\n        all_min_x = min(x for pts in contours for x, y in pts)\n        all_max_x = max(x for pts in contours for x, y in pts)\n        all_max_y = max(y for pts in contours for x, y in pts)\n        width = all_max_x - all_min_x\n        margin_x = max(width * 0.2, 100.0)\n        table_x = all_max_x + margin_x\n        table_spacing = 40.0\n\n        # ============================================================== #\n        # FASE 1: Crear volumenes\n        # ============================================================== #\n        tr = db.TransactionManager.StartTransaction()\n        try:\n            for i, pts in enumerate(contours):\n                zn = i + 1\n                zone_name = \"{}_Zona{:02d}\".format(prefix, zn)\n                try:\n                    vol_id = TinVolumeSurface.Create(\n                        zone_name, base_id, comp_id)\n                    vol_surf = tr.GetObject(vol_id, OpenMode.ForWrite)\n\n                    if style_picking_id is not None:\n                        vol_surf.StyleId = style_picking_id\n\n                    pc = Point3dCollection()\n                    for (x, y) in pts:\n                        pc.Add(Point3d(x, y, 0.0))\n                    if (pts[0][0], pts[0][1]) != (pts[-1][0], pts[-1][1]):\n                        pc.Add(Point3d(pts[0][0], pts[0][1], 0.0))\n                    vol_surf.BoundariesDefinition.AddBoundaries(\n                        pc, 1.0, SurfaceBoundaryType.Outer, True)\n\n                    min_e = -50.0; max_e = 50.0\n                    try:\n                        gp = vol_surf.GetGeneralProperties()\n                        gt = clr.GetClrType(type(gp))\n                        for p in gt.GetProperties():\n                            pn = p.Name\n                            if \"min\" in pn.lower() and \"elev\" in pn.lower():\n                                min_e = p.GetValue(gp)\n                            elif \"max\" in pn.lower() and \"elev\" in pn.lower():\n                                max_e = p.GetValue(gp)\n                    except:\n                        pass\n\n                    try:\n                        d1 = SurfaceAnalysisElevationData(\n                            min_e, -rugosidad_m, green)\n                        d2 = SurfaceAnalysisElevationData(\n                            rugosidad_m, max_e, red)\n                        vol_surf.Analysis.SetElevationData(\n                            Array[SurfaceAnalysisElevationData]([d1, d2]))\n                    except:\n                        pass\n\n                    try:\n                        vp = vol_surf.GetVolumeProperties()\n                        r = (vp.UnadjustedCutVolume /\n                             vp.UnadjustedFillVolume\n                             if vp.UnadjustedFillVolume > 0 else 0)\n                        log.append(\"  {}: C{:.0f} R{:.0f} r{:.2f}\".format(\n                            zone_name, vp.UnadjustedCutVolume,\n                            vp.UnadjustedFillVolume, r))\n                    except:\n                        pass\n\n                    cx = sum(p[0] for p in pts) / len(pts)\n                    cy = sum(p[1] for p in pts) / len(pts)\n                    created_info.append((zone_name, cx, cy))\n                except Exception as ex_v:\n                    log.append(\"  ERROR volumen: {}\".format(ex_v))\n\n            tr.Commit()\n        finally:\n            tr.Dispose()\n\n        log.append(\"\")\n        log.append(\"{} volumenes creados.\".format(len(created_info)))\n\n        # ============================================================== #\n        # FASE 2: Encolar tablas + LISP restaurar estilo \"elevaciones\"\n        # en UNA sola llamada SendStringToExecute para garantizar orden\n        # ============================================================== #\n        if created_info:\n            full_cmd = \"\"\n            for i, (zone_name, zcx, zcy) in enumerate(created_info):\n                table_y = all_max_y - i * table_spacing\n                full_cmd += (\n                    \"_.ADDSURFACELEGENDTABLE\\n\"\n                    \"{},{}\\n\"\n                    \"E\\n\"\n                    \"D\\n\"\n                    \"{},{}\\n\"\n                ).format(zcx, zcy, table_x, table_y)\n                log.append(\"Zona {:02d}: tabla en ({:.1f}, {:.1f})\".format(\n                    i + 1, table_x, table_y))\n\n            # LISP al final para restaurar \"elevaciones\"\n            full_cmd += \"(vl-load-com)\\n\"\n            lisp_body = \"(progn\"\n            for (zone_name, _, _) in created_info:\n                lisp_body += (\n                    \" (vl-catch-all-apply (function (lambda ()\"\n                    \" (vla-put-style\"\n                    \" (vla-item\"\n                    \" (vla-get-surfaces\"\n                    \" (vla-get-civildocument\"\n                    \" (vla-get-application\"\n                    \" (vla-get-activedocument\"\n                    \" (vlax-get-acad-object)))))\"\n                    \" \\\"{}\\\")\"\n                    \" \\\"elevaciones\\\"))))\"\n                ).format(zone_name)\n            lisp_body += \" (princ))\\n\"\n            full_cmd += lisp_body\n\n            doc.SendStringToExecute(full_cmd, True, False, False)\n            log.append(\"\")\n            log.append(\">>> {} tablas + restaurar estilo encolados.\".format(\n                len(created_info)))\n\n    finally:\n        dlock.Dispose()\n\n    log.append(\"\")\n    log.append(\"=== Volumenes listos, pasando a nodo de tablas ===\")\n    # OUT devuelve (log_string, lista_tablas) para el siguiente nodo\n    OUT = [log, table_info]\n\nexcept Exception as ex:\n    log.append(\"ERROR: {}\".format(ex))\n    log.append(traceback.format_exc())\n    OUT = [log, []]\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "1443590f895a48dc8c2a30075facc5b3",
