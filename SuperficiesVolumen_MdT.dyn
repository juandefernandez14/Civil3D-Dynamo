        }
      ],
      "Outputs": [
        {
          "Id": "73deb70ba0a14c20aa99fb47858534d0",
          "Name": "",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script.",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "Code": "# -*- coding: utf-8 -*-\n# =============================================================================\n# Nodo 2: Crea tablas de leyenda por NOMBRE de superficie\n#\n# Recibe: IN[0] = [log_lista, [(nombre, table_x, table_y), ...]]\n# Devuelve log agregado.\n#\n# Estrategia:\n#   Usa ssget con filtro por nombre para PRESELECCIONAR la superficie\n#   antes de lanzar el comando ADDSURFACELEGENDTABLE. Con la seleccion\n#   ya hecha, el comando no pide picking.\n# =============================================================================\n\nimport clr\nimport traceback\n\nclr.AddReference('AcMgd')\nclr.AddReference('AcCoreMgd')\nclr.AddReference('AcDbMgd')\n\nfrom Autodesk.AutoCAD.ApplicationServices import Application as AcadApp\n\nlog_prev, table_info = IN[0]\nlog = list(log_prev)\nlog.append(\"\")\nlog.append(\"=== Nodo 2: tablas de leyenda ===\")\n\ntry:\n    if not table_info:\n        log.append(\"Sin tablas que crear.\")\n        OUT = \"\\n\".join(log)\n    else:\n        doc = AcadApp.DocumentManager.MdiActiveDocument\n\n        # Construir UN unico string con TODOS los bloques preseleccion+tabla.\n        # Por cada tabla:\n        #   1. QSELECT via ssget con filtro DXF 2 (nombre) + 0 (tipo AECC_TIN_VOLUME_SURFACE)\n        #   2. Comando ADDSURFACELEGENDTABLE - usara la seleccion previa\n        #\n        # En AutoCAD / Civil 3D, preseleccion se hace con:\n        #   (sssetfirst nil (ssget \"_X\" '((0 . \"AECC_TIN_VOLUME_SURFACE\") (2 . \"nombre\"))))\n        # Despues el comando ve la seleccion en \"implied selection\" y\n        # salta el prompt de \"Select a surface\".\n\n        full_cmd = \"\"\n        for (name, tx, ty) in table_info:\n            # LISP para preseleccionar por nombre\n            full_cmd += (\n                \"(sssetfirst nil (ssget \\\"_X\\\" \"\n                \"(list (cons 0 \\\"AECC_TIN_VOLUME_SURFACE\\\") \"\n                \"(cons 2 \\\"{}\\\"))))\\n\"\n            ).format(name)\n            # Comando de tabla (con superficie ya preseleccionada)\n            full_cmd += (\n                \"_.ADDSURFACELEGENDTABLE\\n\"\n                \"E\\n\"\n                \"D\\n\"\n                \"{},{}\\n\"\n            ).format(tx, ty)\n            log.append(\"  {}: tabla en ({:.1f},{:.1f})\".format(\n                name, tx, ty))\n\n        doc.SendStringToExecute(full_cmd, True, False, False)\n        log.append(\"\")\n        log.append(\">>> {} tablas encoladas por NOMBRE.\".format(\n            len(table_info)))\n\n        OUT = \"\\n\".join(log)\n\nexcept Exception as ex:\n    log.append(\"ERROR: {}\".format(ex))\n    log.append(traceback.format_exc())\n    OUT = \"\\n\".join(log)\n"
    }
  ],
  "Connectors": [
    {
