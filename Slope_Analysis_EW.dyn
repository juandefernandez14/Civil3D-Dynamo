      "Value": "15",
      "NumberType": "Double",
      "Description": "Creates a number",
      "SelectedIndex": 0
    },
    {
      "Id": "a487ede75f3b4a65b30187f8840cfcd0",
      "Name": "Pendiente maxima admisible (%)",
      "Type": "number",
      "Type2": "number",
      "Value": "7",
