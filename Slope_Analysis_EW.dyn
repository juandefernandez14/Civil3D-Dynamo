      "SelectedIndex": 0
    },
    {
      "Id": "8e973865c2054ba9a9749f0fff3bab4a",
      "Name": "Pendiente de aviso (%)",
      "Type": "number",
      "Type2": "number",
      "Value": "5",
      "NumberType": "Double",
      "Description": "Creates a number",
      "SelectedIndex": 0
    },
    {
      "Id": "be509b92e8624aa482e37f3ca02a3ae3",
      "Name": "Nombre de la nueva superficie",
      "Type": "string",
      "Type2": "string",
      "Value": "Slope_Analysis_E-W",
      "Description": "Creates a string",
      "SelectedIndex": 0
    },
    {
      "Id": "5b36e57884d74152a8e0b95cdfc1866a",
      "Name": "Iteraciones de subdivision",
      "Type": "number",
      "Type2": "number",
      "Value": "3",
      "NumberType": "Double",
      "Description": "Creates a number",
      "SelectedIndex": 0
    }
  ],
  "Outputs": [
    {
      "Id": "3f3c43199a764b0e8437d7e6c5a2a3f4",
      "Name": "Log",
      "Type": "string",
      "InitialValue": "Contornos encontrados: 2\nTrackers encontrados:  228\nAVISO: no se pudo configurar max triangle side por API (property is read-only). Configuralo a mano en Surface Properties -> Definition -> Build -> Use maximum triangle length = 22.50 m.\n\n=== RESUMEN E-W ===\nRango de pitch: [3.0 m, 15.0 m]\nTrackers fuera del contorno:     0\nTrackers sin vecino al Este:     8\nParejas analizadas:              220\nPuntos calculados (9 por pareja):1980\n  Verde   (|p| <= 5.0 %):         958\n  Amarillo(5.0 - 7.0 %):           1004\n  Rojo    (|p| > 7.0 %):          18\nPuntos con error de muestreo:    0\nEtiquetas creadas:               1980\nSuperficie creada:               Slope_Analysis_E-W",
      "Description": "Visualizes a node's output"
    }
  ],
