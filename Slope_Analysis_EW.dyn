      "InputValue": 5.0
    },
    {
      "ConcreteType": "CoreNodeModels.Input.StringInput, CoreNodeModels",
      "Id": "be509b92e8624aa482e37f3ca02a3ae3",
      "NodeType": "StringInputNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "af43496bc6614be8b70a91a982735488",
          "Name": "",
          "Description": "String",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Creates a string",
      "InputValue": "Slope_Analysis_E-W"
    },
    {
      "ConcreteType": "CoreNodeModels.Input.DoubleInput, CoreNodeModels",
      "NumberType": "Double",
      "Id": "5b36e57884d74152a8e0b95cdfc1866a",
      "NodeType": "NumberInputNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "f853db8542c543a4b87e88d884b74c07",
          "Name": "",
          "Description": "Number",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Creates a number",
      "InputValue": 3.0
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\r\n# =============================================================================\r\n# Slope_Analysis_EW.dyn  -  Nodo Python principal\r\n# Civil 3D 2024 / Dynamo / CPython3\r\n#\r\n# Entradas (puertos IN[0..8]):\r\n#   IN[0] : str    nombre del MDT\r\n#   IN[1] : str    nombre de capa del contorno\r\n#   IN[2] : str    nombre de capa de los trackers\r\n#   IN[3] : float  pitch minimo (m)\r\n#   IN[4] : float  pitch maximo (m)\r\n#   IN[5] : float  pendiente maxima admisible (%)\r\n#   IN[6] : float  pendiente de aviso (%)\r\n#   IN[7] : str    nombre de la nueva superficie TIN\r\n#   IN[8] : int    iteraciones de subdivision (n -> 2^n+1 puntos por tracker)\r\n#                  0 = solo extremos (2 pts), 1 = 3, 2 = 5, 3 = 9, 4 = 17\r\n#\r\n# Salida:\r\n#   OUT   : str    log con el resumen del analisis\r\n# =============================================================================\r\n\r\nimport clr\r\nimport math\r\nimport traceback\r\n\r\nclr.AddReference('AcMgd')\r\nclr.AddReference('AcCoreMgd')\r\nclr.AddReference('AcDbMgd')\r\nclr.AddReference('AecBaseMgd')\r\nclr.AddReference('AeccDbMgd')\r\n\r\nfrom Autodesk.AutoCAD.ApplicationServices import Application as AcadApp\r\nfrom Autodesk.AutoCAD.DatabaseServices import (\r\n    Transaction, OpenMode, BlockTable, BlockTableRecord,\r\n    Polyline, SymbolUtilityServices\r\n)\r\nfrom Autodesk.AutoCAD.Geometry import Point2d, Point3d, Point3dCollection\r\nfrom Autodesk.Civil import SurfaceBoundaryType\r\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\r\nfrom Autodesk.Civil.DatabaseServices import (\r\n    TinSurface, SurfaceAnalysisElevationData, SurfaceSlopeLabel\r\n)\r\n\r\nimport System\r\nfrom System import Array\r\nfrom System.Drawing import Color\r\n\r\n# --------------------------------------------------------------------------- #\r\n# Inputs\r\n# --------------------------------------------------------------------------- #\r\nmdt_name       = str(IN[0])\r\ncontour_layer  = str(IN[1])\r\ntracker_layer  = str(IN[2])\r\npitch_min      = float(IN[3])\r\npitch_max      = float(IN[4])\r\nmax_slope_pct  = float(IN[5])\r\nwarn_slope_pct = float(IN[6])\r\nout_surf_name  = str(IN[7])\r\nn_iter         = int(IN[8]) if len(IN) > 8 and IN[8] is not None else 3\r\n\r\nlog = []\r\n\r\ndef pip(px, py, poly):\r\n    \"\"\"Ray-casting point-in-polygon.\"\"\"\r\n    inside = False\r\n    n = len(poly)\r\n    if n < 3:\r\n        return False\r\n    j = n - 1\r\n    for i in range(n):\r\n        xi, yi = poly[i]\r\n        xj, yj = poly[j]\r\n        if ((yi > py) != (yj > py)) and \\\r\n           (px < (xj - xi) * (py - yi) / ((yj - yi) if (yj - yi) != 0 else 1e-12) + xi):\r\n            inside = not inside\r\n        j = i\r\n    return inside\r\n\r\ntry:\r\n    doc  = AcadApp.DocumentManager.MdiActiveDocument\r\n    db   = doc.Database\r\n    cdoc = CivilApplication.ActiveDocument\r\n\r\n    dlock = doc.LockDocument()\r\n    try:\r\n        tr = db.TransactionManager.StartTransaction()\r\n        try:\r\n\r\n            # ---------------------------------------------------------------- #\r\n            # 1. MDT\r\n            # ---------------------------------------------------------------- #\r\n            mdt_surf = None\r\n            mdt_surf_id = None\r\n            for sid in cdoc.GetSurfaceIds():\r\n                s = tr.GetObject(sid, OpenMode.ForRead)\r\n                if s.Name == mdt_name:\r\n                    mdt_surf = s\r\n                    mdt_surf_id = sid\r\n                    break\r\n            if mdt_surf is None:\r\n                raise Exception(\"No se ha encontrado el MDT '{}'.\".format(mdt_name))\r\n\r\n            # ---------------------------------------------------------------- #\r\n            # 2. Recorrer ModelSpace\r\n            # ---------------------------------------------------------------- #\r\n            bt  = tr.GetObject(db.BlockTableId, OpenMode.ForRead)\r\n            ms_id = SymbolUtilityServices.GetBlockModelSpaceId(db)\r\n            btr = tr.GetObject(ms_id, OpenMode.ForRead)\r\n\r\n            contours = []\r\n            trackers = []   # lista de dicts con vertices A(N) y B(S)\r\n\r\n            for oid in btr:\r\n                obj = tr.GetObject(oid, OpenMode.ForRead)\r\n                if not isinstance(obj, Polyline):\r\n                    continue\r\n                lay = obj.Layer\r\n                n = obj.NumberOfVertices\r\n                if lay == contour_layer and n >= 3:\r\n                    pts = []\r\n                    for i in range(n):\r\n                        p = obj.GetPoint2dAt(i)\r\n                        pts.append((p.X, p.Y))\r\n                    contours.append(pts)\r\n                elif lay == tracker_layer and n >= 2:\r\n                    p1 = obj.GetPoint2dAt(0)\r\n                    p2 = obj.GetPoint2dAt(n - 1)\r\n                    # Forzar A = Norte (mayor Y)\r\n                    if p1.Y >= p2.Y:\r\n                        ax, ay, bx, by = p1.X, p1.Y, p2.X, p2.Y\r\n                    else:\r\n                        ax, ay, bx, by = p2.X, p2.Y, p1.X, p1.Y\r\n                    trackers.append({\r\n                        \"ax\": ax, \"ay\": ay,\r\n                        \"bx\": bx, \"by\": by,\r\n                        \"xmid\": (ax + bx) / 2.0,\r\n                        \"ymin\": min(ay, by),\r\n                        \"ymax\": max(ay, by),\r\n                        \"handle\": str(obj.Handle)\r\n                    })\r\n\r\n            if not contours:\r\n                raise Exception(\"No hay polilineas en la capa de contorno '{}'.\".format(contour_layer))\r\n            if not trackers:\r\n                raise Exception(\"No hay polilineas en la capa de trackers '{}'.\".format(tracker_layer))\r\n\r\n            log.append(\"Contornos encontrados: {}\".format(len(contours)))\r\n            log.append(\"Trackers encontrados:  {}\".format(len(trackers)))\r\n\r\n            # ---------------------------------------------------------------- #\r\n            # 3. Filtrar trackers con ambos vertices dentro del contorno\r\n            # ---------------------------------------------------------------- #\r\n            inside_trackers = []\r\n            n_out = 0\r\n            for t in trackers:\r\n                inA = any(pip(t[\"ax\"], t[\"ay\"], c) for c in contours)\r\n                inB = any(pip(t[\"bx\"], t[\"by\"], c) for c in contours)\r\n                if inA and inB:\r\n                    inside_trackers.append(t)\r\n                else:\r\n                    n_out += 1\r\n\r\n            if not inside_trackers:\r\n                raise Exception(\"Ningun tracker dentro del contorno.\")\r\n\r\n            # ---------------------------------------------------------------- #\r\n            # 4. Emparejamiento con vecino Este\r\n            # ---------------------------------------------------------------- #\r\n            def find_east_neighbor(T, pool, pmin, pmax):\r\n                candidates = []\r\n                for U in pool:\r\n                    if U is T:\r\n                        continue\r\n                    dx = U[\"xmid\"] - T[\"xmid\"]\r\n                    if dx <= 1e-6:\r\n                        continue\r\n                    if dx < pmin or dx > pmax:\r\n                        continue\r\n                    # Solape en Y\r\n                    if min(T[\"ymax\"], U[\"ymax\"]) <= max(T[\"ymin\"], U[\"ymin\"]):\r\n                        continue\r\n                    candidates.append((dx, U))\r\n                if not candidates:\r\n                    return None\r\n                candidates.sort(key=lambda c: c[0])   # mas cercano dentro del rango\r\n                return candidates[0][1]\r\n\r\n            pairs = []\r\n            n_no_neighbor = 0\r\n            for T in inside_trackers:\r\n                N = find_east_neighbor(T, inside_trackers, pitch_min, pitch_max)\r\n                if N is None:\r\n                    n_no_neighbor += 1\r\n                    continue\r\n                pairs.append((T, N))\r\n\r\n            if not pairs:\r\n                raise Exception(\"Ningun tracker tiene vecino al Este. \"\r\n                                \"Revisa el pitch o la geometria.\")\r\n\r\n            # ---------------------------------------------------------------- #\r\n            # 5. Densificar y calcular pendientes por pareja\r\n            # ---------------------------------------------------------------- #\r\n            # n_iter iteraciones de insercion de punto medio -> 2^n+1 puntos\r\n            n_pts = (1 << max(0, n_iter)) + 1   # 2^n + 1\r\n            if n_pts < 2:\r\n                n_pts = 2\r\n            denom = float(n_pts - 1)\r\n            t_params = [i / denom for i in range(n_pts)]\r\n\r\n            # Para cada pareja guardamos (T, N, [(pT_xy, pN_xy, slope), ...])\r\n            pair_data = []\r\n            label_pairs = []   # n_pts etiquetas por pareja (1 por vertice densificado)\r\n            n_ok = n_warn = n_ko = n_err = 0\r\n\r\n            # Tolerancia para considerar horizontal un tracker (en metros)\r\n            HORIZ_TOL = 0.1\r\n\r\n            for T, N in pairs:\r\n                Tax, Tay, Tbx, Tby = T[\"ax\"], T[\"ay\"], T[\"bx\"], T[\"by\"]\r\n                Nax, Nay, Nbx, Nby = N[\"ax\"], N[\"ay\"], N[\"bx\"], N[\"by\"]\r\n\r\n                pair_points = []\r\n\r\n                for tp in t_params:\r\n                    # Punto sobre T (equiespaciado)\r\n                    px = Tax + tp * (Tbx - Tax)\r\n                    py = Tay + tp * (Tby - Tay)\r\n\r\n                    # ---------------------------------------------------------\r\n                    # Proyección EXACTA horizontal sobre la recta del vecino N\r\n                    # (extrapolando si es necesario)\r\n                    # ---------------------------------------------------------\r\n                    if abs(Nay - Nby) < 1e-9:\r\n                        # N es horizontal: solo hay proyección si py está cerca de Nay\r\n                        if abs(py - Nay) > HORIZ_TOL:\r\n                            n_err += 1\r\n                            continue\r\n                        nx = px\r\n                        ny = Nay\r\n                    else:\r\n                        # N no horizontal: resolver t_n tal que y = py\r\n                        t_n = (py - Nay) / (Nby - Nay)\r\n                        nx = Nax + t_n * (Nbx - Nax)\r\n                        ny = py\r\n\r\n                    # Distancia horizontal (dy = 0)\r\n                    L = abs(nx - px)\r\n                    if L < 1e-6:\r\n                        n_err += 1\r\n                        continue\r\n\r\n                    try:\r\n                        zT = mdt_surf.FindElevationAtXY(px, py)\r\n                        zN = mdt_surf.FindElevationAtXY(nx, ny)\r\n                    except:\r\n                        n_err += 1\r\n                        continue\r\n\r\n                    slope_pct = (zN - zT) / L * 100.0\r\n\r\n                    if abs(slope_pct) > max_slope_pct:\r\n                        n_ko += 1\r\n                    elif abs(slope_pct) > warn_slope_pct:\r\n                        n_warn += 1\r\n                    else:\r\n                        n_ok += 1\r\n\r\n                    pair_points.append(((px, py), (nx, ny), slope_pct))\r\n\r\n                    # ---------------------------------------------------------\r\n                    # Etiqueta solo si AMBOS puntos están dentro de ALGÚN contorno\r\n                    # ---------------------------------------------------------\r\n                    if contours:\r\n                        inside_any = False\r\n                        for c in contours:\r\n                            if pip(px, py, c) and pip(nx, ny, c):\r\n                                inside_any = True\r\n                                break\r\n                        if inside_any:\r\n                            label_pairs.append((Point2d(px, py), Point2d(nx, ny)))\r\n\r\n                pair_data.append((T, N, pair_points))\r\n\r\n            # ---------------------------------------------------------------- #\r\n            # 5b. Construir puntos de la superficie\r\n            # ---------------------------------------------------------------- #\r\n            surf_points = []\r\n            for T, N, pp in pair_data:\r\n                for (px, py), (nx, ny), sl in pp:\r\n                    # Ambos puntos tienen la misma Y (horizontalidad garantizada)\r\n                    surf_points.append(Point3d(px, py, sl))\r\n                    surf_points.append(Point3d(nx, ny, sl))\r\n\r\n            if not surf_points:\r\n                raise Exception(\"No se han podido calcular pendientes.\")\r\n\r\n            # ---------------------------------------------------------------- #\r\n            # 6. Crear superficie TIN\r\n            # ---------------------------------------------------------------- #\r\n            existing_id = None\r\n            for sid in cdoc.GetSurfaceIds():\r\n                s = tr.GetObject(sid, OpenMode.ForRead)\r\n                if s.Name == out_surf_name:\r\n                    existing_id = sid\r\n                    break\r\n            if existing_id is not None:\r\n                sx = tr.GetObject(existing_id, OpenMode.ForWrite)\r\n                sx.Erase()\r\n\r\n            new_surf_id = TinSurface.Create(db, out_surf_name)\r\n            new_surf    = tr.GetObject(new_surf_id, OpenMode.ForWrite)\r\n\r\n            # Limitar longitud maxima de lado de triangulo\r\n            max_tri_side = pitch_max * 1.5\r\n            try:\r\n                bops = new_surf.BuildOptions\r\n                bops.UseMaximumTriangleLength = True\r\n                bops.MaximumTriangleLength = max_tri_side\r\n                new_surf.BuildOptions = bops\r\n                log.append(\"Max triangle side: {:.2f} m\".format(max_tri_side))\r\n            except Exception as ex_bo:\r\n                log.append(\"AVISO: no se pudo configurar max triangle side por API \"\r\n                           \"({}). Configuralo a mano en Surface Properties -> \"\r\n                           \"Definition -> Build -> Use maximum triangle length = \"\r\n                           \"{:.2f} m.\".format(ex_bo, max_tri_side))\r\n\r\n            for p in surf_points:\r\n                new_surf.AddVertex(p)\r\n\r\n            # ---------------------------------------------------------------- #\r\n            # 7. Contornos\r\n            # ---------------------------------------------------------------- #\r\n            first = True\r\n            for c in contours:\r\n                pc = Point3dCollection()\r\n                for (x, y) in c:\r\n                    pc.Add(Point3d(x, y, 0.0))\r\n                if (c[0][0], c[0][1]) != (c[-1][0], c[-1][1]):\r\n                    pc.Add(Point3d(c[0][0], c[0][1], 0.0))\r\n                btype = SurfaceBoundaryType.Outer if first else SurfaceBoundaryType.Show\r\n                new_surf.BoundariesDefinition.AddBoundaries(pc, 1.0, btype, True)\r\n                first = False\r\n\r\n            # ---------------------------------------------------------------- #\r\n            # 8. Etiquetas de pendiente \"Two points\" sobre el MDT\r\n            # ---------------------------------------------------------------- #\r\n            slope_style_id = None\r\n            try:\r\n                lss = cdoc.Styles.LabelStyles.SurfaceLabelStyles.SlopeLabelStyles\r\n                for stid in lss:\r\n                    slope_style_id = stid\r\n                    break\r\n            except Exception as ex_ss:\r\n                log.append(\"AVISO: no se pudo leer SlopeLabelStyles: {}\".format(ex_ss))\r\n\r\n            n_labels = 0\r\n            n_label_err = 0\r\n            first_err = None\r\n            for pA, pB in label_pairs:\r\n                try:\r\n                    if slope_style_id is not None:\r\n                        SurfaceSlopeLabel.Create(mdt_surf_id, pA, pB, slope_style_id)\r\n                    else:\r\n                        SurfaceSlopeLabel.Create(mdt_surf_id, pA, pB)\r\n                    n_labels += 1\r\n                except Exception as ex_lb:\r\n                    n_label_err += 1\r\n                    if first_err is None:\r\n                        first_err = str(ex_lb)\r\n\r\n            tr.Commit()\r\n        finally:\r\n            tr.Dispose()\r\n    finally:\r\n        dlock.Dispose()\r\n\r\n    log.append(\"\")\r\n    log.append(\"=== RESUMEN E-W ===\")\r\n    log.append(\"Rango de pitch: [{} m, {} m]\".format(pitch_min, pitch_max))\r\n    log.append(\"Trackers fuera del contorno:     {}\".format(n_out))\r\n    log.append(\"Trackers sin vecino al Este:     {}\".format(n_no_neighbor))\r\n    log.append(\"Parejas analizadas:              {}\".format(len(pairs)))\r\n    log.append(\"Puntos calculados ({} por pareja):{}\".format(n_pts, n_ok + n_warn + n_ko))\r\n    log.append(\"  Verde   (|p| <= {} %):         {}\".format(warn_slope_pct, n_ok))\r\n    log.append(\"  Amarillo({} - {} %):           {}\".format(warn_slope_pct, max_slope_pct, n_warn))\r\n    log.append(\"  Rojo    (|p| > {} %):          {}\".format(max_slope_pct, n_ko))\r\n    log.append(\"Puntos con error de muestreo:    {}\".format(n_err))\r\n    log.append(\"Etiquetas creadas:               {}\".format(n_labels))\r\n    if n_label_err > 0:\r\n        log.append(\"Etiquetas con error:             {}\".format(n_label_err))\r\n        log.append(\"Primer error: {}\".format(first_err))\r\n    log.append(\"Superficie creada:               {}\".format(out_surf_name))\r\n\r\n    OUT = \"\\n\".join(log)\r\n\r\nexcept Exception as ex:\r\n    OUT = \"ERROR:\\n\" + str(ex) + \"\\n\\n\" + traceback.format_exc()",
      "Engine": "CPython3",
      "EngineName": "CPython3",
