      "Value": "Trackers_Proyecto",
      "Description": "Creates a string",
      "SelectedIndex": 0
    },
    {
      "Id": "872a5a2447704069a818f0675d5bfc11",
      "Name": "Capa de contorno",
      "Type": "string",
      "Type2": "string",
      "Value": "_Contornos",
      "Description": "Creates a string",
      "SelectedIndex": 0
    },
    {
      "Id": "899a6669659648cb8f79c140559856a5",
      "Name": "Capa de trackers",
      "Type": "string",
      "Type2": "string",
      "Value": "_Lineas_Rotura",
      "Description": "Creates a string",
      "SelectedIndex": 0
    },
    {
      "Id": "7ac02558fef141f18e5a49ed6207119f",
      "Name": "Pitch minimo (m)",
      "Type": "number",
      "Type2": "number",
      "Value": "3",
      "NumberType": "Double",
      "Description": "Creates a number",
      "SelectedIndex": 0
    },
    {
      "Id": "497f378bcc574258b3391ae86ac6b121",
      "Name": "Pitch maximo (m)",
      "Type": "number",
