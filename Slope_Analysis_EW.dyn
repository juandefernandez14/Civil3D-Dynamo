{
  "Uuid": "eb9ad913-c2d2-4314-a5d0-419cc429416e",
  "IsCustomNode": false,
  "Description": "Analisis de pendientes E-W del terreno original para trackers 1P rigidos. Empareja cada tracker con su vecino Este y densifica 3 veces (9 puntos).",
  "Name": "Slope_Analysis_EW",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [
    {
      "Id": "f7c1ae10cd6445c2b60cf2ec4ff0e2c2",
      "Name": "Superficie a analizar",
      "Type": "string",
