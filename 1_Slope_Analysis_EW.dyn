    },
    {
      "ConcreteType": "CoreNodeModels.Input.DoubleInput, CoreNodeModels",
      "NumberType": "Double",
      "Id": "94feaf5e2c904331946ef25e9b6fcd44",
      "NodeType": "NumberInputNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "7a765fa1b82840f3abd6c89330fc17a9",
          "Name": "",
          "Description": "Number",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Creates a number",
      "InputValue": 2.0
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\n# =============================================================================\n# Slope_Analysis_EW.dyn  -  Nodo Python principal\n# Civil 3D 2024 / Dynamo / CPython3\n#\n# Entradas (puertos IN[0..8]):\n#   IN[0] : str    nombre del MDT\n#   IN[1] : str    nombre de capa del contorno\n#   IN[2] : str    nombre de capa de los trackers\n#   IN[3] : float  pitch minimo (m)\n#   IN[4] : float  pitch maximo (m)\n#   IN[5] : float  pendiente maxima admisible (%)\n#   IN[6] : float  pendiente de aviso (%)\n#   IN[7] : str    nombre de la nueva superficie TIN\n#   IN[8] : int    iteraciones de subdivision (n -> 2^n+1 puntos por tracker)\n#                  0 = solo extremos (2 pts), 1 = 3, 2 = 5, 3 = 9, 4 = 17\n#\n# Salida:\n#   OUT   : str    log con el resumen del analisis\n#\n# Algoritmo:\n#   - Normaliza vertices: A = Norte (Y mayor), B = Sur.\n#   - Filtra trackers con ambos vertices dentro del contorno.\n#   - Para cada tracker T busca su vecino al Este N:\n#       * candidato valido: dx en [pitch_min, pitch_max] y con solape en Y.\n#       * elige el de menor dx (el mas cercano dentro del rango).\n#   - Si T no tiene vecino Este, se ignora.\n#   - Densifica T en 9 puntos equiespaciados (3 iteraciones de punto medio).\n#   - Para cada punto pT_i proyecta horizontalmente sobre N (misma Y) → pN_i.\n#   - slope_i = (zN - zT) / dist_horizontal * 100  (positiva si N mas alto).\n#   - Anyade los 9 puntos pT_i con Z = slope_i a la superficie TIN.\n# =============================================================================\n\nimport clr\nimport math\nimport traceback\n\nclr.AddReference('AcMgd')\nclr.AddReference('AcCoreMgd')\nclr.AddReference('AcDbMgd')\nclr.AddReference('AecBaseMgd')\nclr.AddReference('AeccDbMgd')\n\nfrom Autodesk.AutoCAD.ApplicationServices import Application as AcadApp\nfrom Autodesk.AutoCAD.DatabaseServices import (\n    Transaction, OpenMode, BlockTable, BlockTableRecord,\n    Polyline, SymbolUtilityServices\n)\nfrom Autodesk.AutoCAD.Geometry import Point2d, Point3d, Point3dCollection\nfrom Autodesk.Civil import SurfaceBoundaryType\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import (\n    TinSurface, SurfaceSlopeLabel, SurfaceAnalysisElevationData\n)\n\nimport System\nfrom System import Array\nfrom Autodesk.AutoCAD.Colors import Color as AcadColor\n\n# --------------------------------------------------------------------------- #\n# Inputs\n# --------------------------------------------------------------------------- #\nmdt_name       = str(IN[0])\ncontour_layer  = str(IN[1])\ntracker_layer  = str(IN[2])\npitch_min      = float(IN[3])\npitch_max      = float(IN[4])\nmax_slope_pct  = float(IN[5])\nwarn_slope_pct = float(IN[6])\nout_surf_name  = str(IN[7])\nn_iter         = int(IN[8]) if len(IN) > 8 and IN[8] is not None else 3\n\nlog = []\n\ndef pip(px, py, poly):\n    \"\"\"Ray-casting point-in-polygon.\"\"\"\n    inside = False\n    n = len(poly)\n    if n < 3:\n        return False\n    j = n - 1\n    for i in range(n):\n        xi, yi = poly[i]\n        xj, yj = poly[j]\n        if ((yi > py) != (yj > py)) and \\\n           (px < (xj - xi) * (py - yi) / ((yj - yi) if (yj - yi) != 0 else 1e-12) + xi):\n            inside = not inside\n        j = i\n    return inside\n\ntry:\n    doc  = AcadApp.DocumentManager.MdiActiveDocument\n    db   = doc.Database\n    cdoc = CivilApplication.ActiveDocument\n\n    dlock = doc.LockDocument()\n    try:\n        tr = db.TransactionManager.StartTransaction()\n        try:\n\n            # ---------------------------------------------------------------- #\n            # 1. MDT\n            # ---------------------------------------------------------------- #\n            mdt_surf = None\n            mdt_surf_id = None\n            for sid in cdoc.GetSurfaceIds():\n                s = tr.GetObject(sid, OpenMode.ForRead)\n                if s.Name == mdt_name:\n                    mdt_surf = s\n                    mdt_surf_id = sid\n                    break\n            if mdt_surf is None:\n                raise Exception(\"No se ha encontrado el MDT '{}'.\".format(mdt_name))\n\n            # ---------------------------------------------------------------- #\n            # 2. Recorrer ModelSpace\n            # ---------------------------------------------------------------- #\n            bt  = tr.GetObject(db.BlockTableId, OpenMode.ForRead)\n            ms_id = SymbolUtilityServices.GetBlockModelSpaceId(db)\n            btr = tr.GetObject(ms_id, OpenMode.ForRead)\n\n            contours = []\n            trackers = []   # lista de dicts con vertices A(N) y B(S)\n\n            for oid in btr:\n                obj = tr.GetObject(oid, OpenMode.ForRead)\n                if not isinstance(obj, Polyline):\n                    continue\n                lay = obj.Layer\n                n = obj.NumberOfVertices\n                if lay == contour_layer and n >= 3:\n                    pts = []\n                    for i in range(n):\n                        p = obj.GetPoint2dAt(i)\n                        pts.append((p.X, p.Y))\n                    contours.append(pts)\n                elif lay == tracker_layer and n >= 2:\n                    p1 = obj.GetPoint2dAt(0)\n                    p2 = obj.GetPoint2dAt(n - 1)\n                    # Forzar A = Norte (mayor Y)\n                    if p1.Y >= p2.Y:\n                        ax, ay, bx, by = p1.X, p1.Y, p2.X, p2.Y\n                    else:\n                        ax, ay, bx, by = p2.X, p2.Y, p1.X, p1.Y\n                    trackers.append({\n                        \"ax\": ax, \"ay\": ay,\n                        \"bx\": bx, \"by\": by,\n                        \"xmid\": (ax + bx) / 2.0,\n                        \"ymin\": min(ay, by),\n                        \"ymax\": max(ay, by),\n                        \"handle\": str(obj.Handle)\n                    })\n\n            if not contours:\n                raise Exception(\"No hay polilineas en la capa de contorno '{}'.\".format(contour_layer))\n            if not trackers:\n                raise Exception(\"No hay polilineas en la capa de trackers '{}'.\".format(tracker_layer))\n\n            log.append(\"Contornos encontrados: {}\".format(len(contours)))\n            log.append(\"Trackers encontrados:  {}\".format(len(trackers)))\n\n            # ---------------------------------------------------------------- #\n            # 3. Filtrar trackers con ambos vertices dentro del contorno\n            # ---------------------------------------------------------------- #\n            inside_trackers = []\n            n_out = 0\n            for t in trackers:\n                inA = any(pip(t[\"ax\"], t[\"ay\"], c) for c in contours)\n                inB = any(pip(t[\"bx\"], t[\"by\"], c) for c in contours)\n                if inA and inB:\n                    inside_trackers.append(t)\n                else:\n                    n_out += 1\n\n            if not inside_trackers:\n                raise Exception(\"Ningun tracker dentro del contorno.\")\n\n            # ---------------------------------------------------------------- #\n            # 4. Emparejamiento con vecino Este\n            # ---------------------------------------------------------------- #\n            def find_east_neighbor(T, pool, pmin, pmax):\n                candidates = []\n                for U in pool:\n                    if U is T:\n                        continue\n                    dx = U[\"xmid\"] - T[\"xmid\"]\n                    if dx <= 1e-6:\n                        continue\n                    if dx < pmin or dx > pmax:\n                        continue\n                    # Solape en Y\n                    if min(T[\"ymax\"], U[\"ymax\"]) <= max(T[\"ymin\"], U[\"ymin\"]):\n                        continue\n                    candidates.append((dx, U))\n                if not candidates:\n                    return None\n                candidates.sort(key=lambda c: c[0])   # mas cercano dentro del rango\n                return candidates[0][1]\n\n            pairs = []\n            n_no_neighbor = 0\n            for T in inside_trackers:\n                N = find_east_neighbor(T, inside_trackers, pitch_min, pitch_max)\n                if N is None:\n                    n_no_neighbor += 1\n                    continue\n                pairs.append((T, N))\n\n            if not pairs:\n                raise Exception(\"Ningun tracker tiene vecino al Este. \"\n                                \"Revisa el pitch o la geometria.\")\n\n            # ---------------------------------------------------------------- #\n            # 5. Densificar y calcular pendientes por pareja\n            # ---------------------------------------------------------------- #\n            # n_iter iteraciones de insercion de punto medio -> 2^n+1 puntos\n            n_pts = (1 << max(0, n_iter)) + 1   # 2^n + 1\n            if n_pts < 2:\n                n_pts = 2\n            denom = float(n_pts - 1)\n            t_params = [i / denom for i in range(n_pts)]\n\n            # Para cada pareja guardamos (T, N, [(pT_xy, pN_xy, slope), ...])\n            pair_data = []\n            label_pairs = []   # n_pts etiquetas por pareja (1 por vertice densificado)\n            n_ok = n_warn = n_ko = n_err = 0\n\n            for T, N in pairs:\n                Tax, Tay, Tbx, Tby = T[\"ax\"], T[\"ay\"], T[\"bx\"], T[\"by\"]\n                Nax, Nay, Nbx, Nby = N[\"ax\"], N[\"ay\"], N[\"bx\"], N[\"by\"]\n\n                pair_points = []\n\n                for tp in t_params:\n                    # Punto sobre T (equiespaciado)\n                    px = Tax + tp * (Tbx - Tax)\n                    py = Tay + tp * (Tby - Tay)\n\n                    # Punto sobre la RECTA de N con la misma Y (ny = py).\n                    # No se limita al segmento: se permite extrapolar\n                    # linealmente para que siempre haya un punto horizontal\n                    # valido a la altura de py. Esto mantiene las\n                    # etiquetas estrictamente horizontales sin descartar\n                    # puntos cuando T sobresale un poco de N.\n                    if abs(Nay - Nby) < 1e-9:\n                        # N horizontal: caso degenerado\n                        n_err += 1\n                        continue\n                    t_n = (Nay - py) / (Nay - Nby)\n                    nx = Nax + t_n * (Nbx - Nax)\n                    ny = py\n\n                    dx = nx - px\n                    dy = ny - py\n                    L = math.sqrt(dx * dx + dy * dy)\n                    if L < 1e-6:\n                        n_err += 1\n                        continue\n\n                    try:\n                        zT = mdt_surf.FindElevationAtXY(px, py)\n                        zN = mdt_surf.FindElevationAtXY(nx, ny)\n                    except:\n                        n_err += 1\n                        continue\n\n                    slope_pct = (zN - zT) / L * 100.0\n\n                    if abs(slope_pct) > max_slope_pct:\n                        n_ko += 1\n                    elif abs(slope_pct) > warn_slope_pct:\n                        n_warn += 1\n                    else:\n                        n_ok += 1\n\n                    pair_points.append(((px, py), (nx, ny), slope_pct))\n                    # Una etiqueta por cada punto densificado\n                    label_pairs.append((Point2d(px, py), Point2d(nx, ny)))\n\n                pair_data.append((T, N, pair_points))\n\n            # ---------------------------------------------------------------- #\n            # 5b. Construir puntos de la superficie\n            # Para cada pareja (T, N) se ponen los 9 puntos tanto en la\n            # posicion de T como en la de N, con el mismo valor de pendiente.\n            # Asi se cubre la banda entre ambos trackers y el easternmost\n            # tambien recibe puntos (como N de la pareja penultimo-ultimo).\n            # ---------------------------------------------------------------- #\n            surf_points = []\n            for T, N, pp in pair_data:\n                for (px, py), (nx, ny), sl in pp:\n                    surf_points.append(Point3d(px, py, sl))\n                    surf_points.append(Point3d(nx, ny, sl))\n\n            if not surf_points:\n                raise Exception(\"No se han podido calcular pendientes.\")\n\n            # ---------------------------------------------------------------- #\n            # 6. Crear superficie TIN\n            # ---------------------------------------------------------------- #\n            existing_id = None\n            for sid in cdoc.GetSurfaceIds():\n                s = tr.GetObject(sid, OpenMode.ForRead)\n                if s.Name == out_surf_name:\n                    existing_id = sid\n                    break\n            if existing_id is not None:\n                sx = tr.GetObject(existing_id, OpenMode.ForWrite)\n                sx.Erase()\n\n            new_surf_id = TinSurface.Create(db, out_surf_name)\n            new_surf    = tr.GetObject(new_surf_id, OpenMode.ForWrite)\n\n            # Longitud maxima de lado de triangulo: pitch_max * 1.5\n            # Se configura despues de anyadir puntos/contornos con Rebuild().\n            max_tri_side = pitch_max * 1.5\n\n            for p in surf_points:\n                new_surf.AddVertex(p)\n\n            # ---------------------------------------------------------------- #\n            # 7. Contornos\n            # ---------------------------------------------------------------- #\n            first = True\n            for c in contours:\n                pc = Point3dCollection()\n                for (x, y) in c:\n                    pc.Add(Point3d(x, y, 0.0))\n                if (c[0][0], c[0][1]) != (c[-1][0], c[-1][1]):\n                    pc.Add(Point3d(c[0][0], c[0][1], 0.0))\n                btype = SurfaceBoundaryType.Outer if first else SurfaceBoundaryType.Show\n                new_surf.BoundariesDefinition.AddBoundaries(pc, 1.0, btype, True)\n                first = False\n\n            # ---------------------------------------------------------------- #\n            # 7b. Longitud maxima de triangulo (elimina puentes entre columnas)\n            # ---------------------------------------------------------------- #\n            try:\n                bops = new_surf.BuildOptions\n                bops.UseMaximumTriangleLength = True\n                bops.MaximumTriangleLength = max_tri_side\n                log.append(\"Max triangle side aplicado: {:.2f} m\".format(max_tri_side))\n            except Exception as ex_bo:\n                log.append(\"AVISO: max triangle side no aplicado por API \"\n                           \"({}). Configuralo a mano en Surface Properties \"\n                           \"-> Definition -> Build -> Use maximum triangle \"\n                           \"length = {:.2f} m.\".format(ex_bo, max_tri_side))\n\n            # ---------------------------------------------------------------- #\n            # 8. Etiquetas de pendiente \"Two points\" sobre el MDT\n            # Firma correcta en Civil 3D 2024:\n            #   SurfaceSlopeLabel.Create(surfaceId, Point2d, Point2d, styleId)\n            # ---------------------------------------------------------------- #\n            slope_style_id = None\n            try:\n                lss = cdoc.Styles.LabelStyles.SurfaceLabelStyles.SlopeLabelStyles\n                for stid in lss:\n                    slope_style_id = stid\n                    break\n            except Exception as ex_ss:\n                log.append(\"AVISO: no se pudo leer SlopeLabelStyles: {}\".format(ex_ss))\n\n            n_labels = 0\n            n_label_err = 0\n            first_err = None\n            for pA, pB in label_pairs:\n                try:\n                    if slope_style_id is not None:\n                        SurfaceSlopeLabel.Create(mdt_surf_id, pA, pB, slope_style_id)\n                    else:\n                        SurfaceSlopeLabel.Create(mdt_surf_id, pA, pB)\n                    n_labels += 1\n                except Exception as ex_lb:\n                    n_label_err += 1\n                    if first_err is None:\n                        first_err = str(ex_lb)\n\n            tr.Commit()\n        finally:\n            tr.Dispose()\n    finally:\n        dlock.Dispose()\n\n    # =========================================================================\n    # FASE 2 (aislada): asignar estilo \"elevaciones\" y rangos de analisis.\n    # Se hace en una transaccion independiente, despues de que la superficie\n    # este creada y comprometida. Si esta fase falla no afecta a nada de lo\n    # anterior (superficie, contornos y etiquetas siguen intactos).\n    # =========================================================================\n    z_min_surf = min(p.Z for p in surf_points)\n    z_max_surf = max(p.Z for p in surf_points)\n\n    dlock2 = doc.LockDocument()\n    try:\n        tr2 = db.TransactionManager.StartTransaction()\n        try:\n            # Relocalizar la superficie recien creada por nombre\n            target_surf = None\n            for sid in cdoc.GetSurfaceIds():\n                s = tr2.GetObject(sid, OpenMode.ForRead)\n                if s.Name == out_surf_name:\n                    target_surf = tr2.GetObject(sid, OpenMode.ForWrite)\n                    break\n\n            if target_surf is None:\n                log.append(\"AVISO: superficie no localizada para estilo/analisis.\")\n            else:\n                # --- Estilo \"elevaciones\" ---\n                style_set = False\n                try:\n                    ss = cdoc.Styles.SurfaceStyles\n                    for name_try in [\"elevaciones\", \"Elevaciones\", \"ELEVACIONES\"]:\n                        try:\n                            style_id = ss.get_Item(name_try)\n                            target_surf.StyleId = style_id\n                            style_set = True\n                            log.append(\"Estilo '{}' asignado.\".format(name_try))\n                            break\n                        except:\n                            continue\n                    if not style_set:\n                        log.append(\"AVISO: estilo 'elevaciones' no encontrado. \"\n                                   \"Asignalo a mano.\")\n                except Exception as ex_sty:\n                    log.append(\"AVISO estilo: {}\".format(ex_sty))\n\n                # --- Analisis de elevaciones (rangos dinamicos) ---\n                try:\n                    green  = AcadColor.FromRgb(80, 200, 80)\n                    yellow = AcadColor.FromRgb(240, 220, 60)\n                    red    = AcadColor.FromRgb(220, 50, 50)\n\n                    ranges = []\n                    # Lado negativo\n                    if z_min_surf < -max_slope_pct:\n                        ranges.append((z_min_surf,     -max_slope_pct, red))\n                        ranges.append((-max_slope_pct, -warn_slope_pct, yellow))\n                        green_lo = -warn_slope_pct\n                    elif z_min_surf < -warn_slope_pct:\n                        ranges.append((z_min_surf, -warn_slope_pct, yellow))\n                        green_lo = -warn_slope_pct\n                    else:\n                        green_lo = z_min_surf\n\n                    # Lado positivo\n                    pos_tail = []\n                    if z_max_surf > max_slope_pct:\n                        green_hi = warn_slope_pct\n                        pos_tail.append((warn_slope_pct, max_slope_pct, yellow))\n                        pos_tail.append((max_slope_pct,  z_max_surf,    red))\n                    elif z_max_surf > warn_slope_pct:\n                        green_hi = warn_slope_pct\n                        pos_tail.append((warn_slope_pct, z_max_surf, yellow))\n                    else:\n                        green_hi = z_max_surf\n\n                    if green_lo >= green_hi:\n                        green_hi = green_lo + 0.001\n                    ranges.append((green_lo, green_hi, green))\n                    ranges.extend(pos_tail)\n\n                    data_arr = [\n                        SurfaceAnalysisElevationData(mn, mx, col)\n                        for (mn, mx, col) in ranges\n                    ]\n                    arr = Array[SurfaceAnalysisElevationData](data_arr)\n                    target_surf.Analysis.SetElevationData(arr)\n                    log.append(\"{} rangos de color aplicados ({:.2f} a {:.2f}).\".format(\n                        len(ranges), z_min_surf, z_max_surf))\n                except Exception as ex_an:\n                    log.append(\"AVISO analisis: {}\".format(ex_an))\n\n            tr2.Commit()\n        finally:\n            tr2.Dispose()\n    finally:\n        dlock2.Dispose()\n\n    log.append(\"\")\n    log.append(\"=== RESUMEN E-W ===\")\n    log.append(\"Rango de pitch: [{} m, {} m]\".format(pitch_min, pitch_max))\n    log.append(\"Trackers fuera del contorno:     {}\".format(n_out))\n    log.append(\"Trackers sin vecino al Este:     {}\".format(n_no_neighbor))\n    log.append(\"Parejas analizadas:              {}\".format(len(pairs)))\n    log.append(\"Puntos calculados (9 por pareja):{}\".format(n_ok + n_warn + n_ko))\n    log.append(\"  Verde   (|p| <= {} %):         {}\".format(warn_slope_pct, n_ok))\n    log.append(\"  Amarillo({} - {} %):           {}\".format(warn_slope_pct, max_slope_pct, n_warn))\n    log.append(\"  Rojo    (|p| > {} %):          {}\".format(max_slope_pct, n_ko))\n    log.append(\"Puntos con error de muestreo:    {}\".format(n_err))\n    log.append(\"Etiquetas creadas:               {}\".format(n_labels))\n    if n_label_err > 0:\n        log.append(\"Etiquetas con error:             {}\".format(n_label_err))\n        log.append(\"Primer error: {}\".format(first_err))\n    log.append(\"Superficie creada:               {}\".format(out_surf_name))\n\n    OUT = \"\\n\".join(log)\n\nexcept Exception as ex:\n    OUT = \"ERROR:\\n\" + str(ex) + \"\\n\\n\" + traceback.format_exc()\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
