    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
      "Id": "505bfb94f4ff4ffd859a3c0706f95163",
      "NodeType": "FunctionNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "fe2a733689bb4c9f8e2f7f9bf78a53bc",
          "Name": "Document",
          "Description": "Document",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "FunctionSignature": "Autodesk.AutoCAD.DynamoNodes.Document.Current",
      "Replication": "Auto",
      "Description": "Get the current AutoCAD document.\n\nDocument.Current: Document"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\n# =============================================================================\n# Tracker_Alignments_Merged.dyn - Python1 (Fase 1)\n# Crea polilineas helper en la capa de ejes a partir de contornos y trackers.\n# Mantiene los contornos. Borra los trackers originales al terminar. Borra\n# tambien los ejes previos de la capa de ejes para permitir re-ejecutar limpio.\n#\n# Sentido del alignment: N->S (estacionamiento crece de norte a sur).\n#\n# AGRUPACION POR CONTORNO (fix del bug de ejes compartidos entre contornos):\n#   - Para cada contorno, se filtran los trackers cuyo centroide esta dentro.\n#   - Esos trackers (y solo esos) se agrupan en columnas usando col_tol.\n#   - Se ordenan y numeran 01, 02, ... de izquierda a derecha DENTRO del\n#     contorno. Cada contorno es totalmente independiente: no hay fugas de\n#     trackers del contorno vecino que desplacen col_x ni renumeren ejes.\n#   - col_x = media de los trackers de esa columna EN ESE contorno.\n#\n# Sin comprobaciones defensivas de \"fuera de contorno\" o \"coincidencia con\n# dos contornos\": el layout lo valida un tecnico antes de ejecutar.\n#\n# Inputs:\n#   IN[0] : str    capa de contornos\n#   IN[1] : str    capa de trackers\n#   IN[2] : str    capa de ejes (e.g. \"EJES\")\n#   IN[3] : float  tolerancia X agrupacion columnas (m)\n#   IN[4] : float  extension extremos (m)\n#   IN[5] : Document  Dynamo Document (para forzar orden de ejecucion)\n#\n# Output:\n#   OUT : Document (passthrough)\n# =============================================================================\n\nimport clr\nimport sys\nimport traceback\n\nclr.AddReference('AcMgd')\nclr.AddReference('AcCoreMgd')\nclr.AddReference('AcDbMgd')\n\nfrom Autodesk.AutoCAD.ApplicationServices import Application as AcadApp\nfrom Autodesk.AutoCAD.DatabaseServices import (\n    OpenMode, Polyline, SymbolUtilityServices, ObjectId,\n    LayerTableRecord\n)\nfrom Autodesk.AutoCAD.Geometry import Point2d\n\ncontour_layer = str(IN[0])\ntracker_layer = str(IN[1])\naxis_layer    = str(IN[2])\ncol_tol       = float(IN[3])\next_m         = float(IN[4])\ndyn_doc_in    = IN[5]\n_surface_trigger = IN[6]   # trigger de orden: Tracker_Surface debe correr antes\n\nlog = []\n\ndef pip(px, py, poly):\n    inside = False\n    n = len(poly)\n    if n < 3:\n        return False\n    j = n - 1\n    for i in range(n):\n        xi, yi = poly[i]\n        xj, yj = poly[j]\n        if ((yi > py) != (yj > py)) and \\\n           (px < (xj - xi) * (py - yi) / ((yj - yi) if (yj - yi) != 0 else 1e-12) + xi):\n            inside = not inside\n        j = i\n    return inside\n\ndef vertical_intersections(xv, poly):\n    ys = []\n    n = len(poly)\n    for i in range(n):\n        x1, y1 = poly[i]\n        x2, y2 = poly[(i + 1) % n]\n        if x1 == x2:\n            continue\n        if xv < min(x1, x2) or xv > max(x1, x2):\n            continue\n        t = (xv - x1) / (x2 - x1)\n        if 0.0 <= t <= 1.0:\n            ys.append(y1 + t * (y2 - y1))\n    return ys\n\nnames_in_order = []\nhandles_in_order = []\n\ntry:\n    doc = AcadApp.DocumentManager.MdiActiveDocument\n    db  = doc.Database\n\n    dlock = doc.LockDocument()\n    try:\n        tr = db.TransactionManager.StartTransaction()\n        try:\n            ms_id = SymbolUtilityServices.GetBlockModelSpaceId(db)\n            btr   = tr.GetObject(ms_id, OpenMode.ForWrite)\n\n            contours = []\n            trackers = []\n            old_axis_oids = []\n\n            for oid in btr:\n                obj = tr.GetObject(oid, OpenMode.ForRead)\n                if not isinstance(obj, Polyline):\n                    continue\n                lay = obj.Layer\n                n = obj.NumberOfVertices\n                if lay == axis_layer:\n                    old_axis_oids.append(oid)\n                    continue\n                if lay == contour_layer and n >= 3:\n                    pts = []\n                    for i in range(n):\n                        p = obj.GetPoint2dAt(i)\n                        pts.append((p.X, p.Y))\n                    contours.append(pts)\n                elif lay == tracker_layer and n >= 2:\n                    p1 = obj.GetPoint2dAt(0)\n                    p2 = obj.GetPoint2dAt(n - 1)\n                    xmid = (p1.X + p2.X) / 2.0\n                    ymid = (p1.Y + p2.Y) / 2.0\n                    trackers.append({\"xmid\": xmid, \"ymid\": ymid, \"oid\": oid})\n\n            if not contours:\n                raise Exception(\"No hay polilineas en la capa '{}'.\".format(contour_layer))\n            if not trackers:\n                raise Exception(\"No hay polilineas en la capa '{}'.\".format(tracker_layer))\n\n            log.append(\"Contornos: {}\".format(len(contours)))\n            log.append(\"Trackers:  {}\".format(len(trackers)))\n\n            # Borrar ejes previos (helpers de ejecuciones anteriores)\n            n_old_axis = 0\n            for oid in old_axis_oids:\n                try:\n                    o = tr.GetObject(oid, OpenMode.ForWrite)\n                    o.Erase()\n                    n_old_axis += 1\n                except:\n                    pass\n            if n_old_axis:\n                log.append(\"Ejes previos borrados: {}\".format(n_old_axis))\n\n            # Asegurar capa ejes\n            lt = tr.GetObject(db.LayerTableId, OpenMode.ForRead)\n            axis_layer_id = ObjectId.Null\n            if lt.Has(axis_layer):\n                try:\n                    axis_layer_id = lt.get_Item(axis_layer)\n                except:\n                    for lid in lt:\n                        lrec = tr.GetObject(lid, OpenMode.ForRead)\n                        if lrec.Name == axis_layer:\n                            axis_layer_id = lid\n                            break\n            else:\n                lt.UpgradeOpen()\n                ltr = LayerTableRecord()\n                ltr.Name = axis_layer\n                axis_layer_id = lt.Add(ltr)\n                tr.AddNewlyCreatedDBObject(ltr, True)\n                log.append(\"Capa '{}' creada.\".format(axis_layer))\n\n            # Ordenar contornos izq->dcha por X minimo\n            contours_sorted = sorted(contours, key=lambda c: min(p[0] for p in c))\n\n            # --- AGRUPACION POR CONTORNO ---\n            axes_to_create = []\n            for c_idx, cont in enumerate(contours_sorted):\n                inside = [t for t in trackers if pip(t[\"xmid\"], t[\"ymid\"], cont)]\n                if not inside:\n                    log.append(\"Contorno C{:02d}: 0 trackers dentro\".format(c_idx + 1))\n                    continue\n                inside.sort(key=lambda t: t[\"xmid\"])\n                cols = []\n                cur = [inside[0]]\n                for t in inside[1:]:\n                    if t[\"xmid\"] - cur[-1][\"xmid\"] <= col_tol:\n                        cur.append(t)\n                    else:\n                        cols.append(cur)\n                        cur = [t]\n                cols.append(cur)\n                log.append(\"Contorno C{:02d}: {} trackers -> {} columnas\".format(\n                    c_idx + 1, len(inside), len(cols)))\n                for idx, col in enumerate(cols):\n                    col_x = sum(tt[\"xmid\"] for tt in col) / len(col)\n                    ys = sorted(vertical_intersections(col_x, cont))\n                    y_min = ys[0]\n                    y_max = ys[-1]\n                    name = \"AL_C{:02d}_{:02d}\".format(c_idx + 1, idx + 1)\n                    # Orden N->S: primer vertice arriba (y_max+ext), segundo abajo (y_min-ext).\n                    # Asi la flecha del alignment apunta hacia el sur (hacia abajo).\n                    axes_to_create.append((name, col_x, y_max + ext_m, y_min - ext_m))\n\n            log.append(\"Ejes a crear: {}\".format(len(axes_to_create)))\n\n            # Crear polilineas helper en orden (vertice 0 = inicio = Norte,\n            # vertice 1 = fin = Sur). Con este orden la flecha del alignment\n            # apunta hacia abajo y el estacionamiento crece N->S.\n            for (name, col_x, y_start, y_end) in axes_to_create:\n                pl = Polyline()\n                pl.AddVertexAt(0, Point2d(col_x, y_start), 0.0, 0.0, 0.0)\n                pl.AddVertexAt(1, Point2d(col_x, y_end),   0.0, 0.0, 0.0)\n                pl.LayerId = axis_layer_id\n                btr.AppendEntity(pl)\n                tr.AddNewlyCreatedDBObject(pl, True)\n                names_in_order.append(name)\n                try:\n                    h_str = pl.Handle.ToString()\n                except:\n                    try:\n                        h_str = pl.ObjectId.Handle.ToString()\n                    except:\n                        h_str = None\n                handles_in_order.append(h_str)\n\n            log.append(\"Polilineas helper creadas: {}\".format(len(names_in_order)))\n\n            # Borrar trackers originales (los contornos se mantienen)\n            n_t_erased = 0\n            for t in trackers:\n                try:\n                    tr.GetObject(t[\"oid\"], OpenMode.ForWrite).Erase()\n                    n_t_erased += 1\n                except:\n                    pass\n            log.append(\"Trackers originales borrados: {}\".format(n_t_erased))\n            log.append(\"Contornos originales: MANTENIDOS\")\n\n            tr.Commit()\n        finally:\n            tr.Dispose()\n    finally:\n        dlock.Dispose()\n\n    main_mod = sys.modules.get('__main__')\n    if main_mod is None:\n        import __main__ as main_mod\n    main_mod._tracker_align_names   = names_in_order\n    main_mod._tracker_align_handles = handles_in_order\n    main_mod._tracker_align_log     = \"\\n\".join(log)\n\n    OUT = dyn_doc_in\n\nexcept Exception as ex:\n    main_mod = sys.modules.get('__main__')\n    if main_mod is None:\n        import __main__ as main_mod\n    main_mod._tracker_align_names   = []\n    main_mod._tracker_align_handles = []\n    main_mod._tracker_align_log     = \"ERROR:\\n\" + str(ex) + \"\\n\\n\" + traceback.format_exc()\n    OUT = dyn_doc_in\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
