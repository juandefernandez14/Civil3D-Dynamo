    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\n# PolylineFilter - filtra las polylines de AcObjectsOfType para devolver\n# solo las polylines helper creadas por Python1 (Fase 1), en el mismo\n# orden que _tracker_align_names.\n#\n# Usa los Handles (ID unico de AutoCAD) que Python1 guardo en\n# _tracker_align_handles. Asi ignoramos las polylines de contornos\n# aunque sigan en el ModelSpace.\n#\n# IN[0] = lista de Dynamo Polylines (salida de AcObjectsOfType)\n# OUT   = lista filtrada y reordenada para CreateAlignmentByPolyline\n\nimport sys\nimport traceback\n\npls_in = IN[0]\nif pls_in is None:\n    pls = []\nelif isinstance(pls_in, list):\n    pls = pls_in\nelse:\n    pls = [pls_in]\n\nmain_mod = sys.modules.get('__main__')\nif main_mod is None:\n    import __main__ as main_mod\n\nhandles_wanted = list(getattr(main_mod, '_tracker_align_handles', []) or [])\n\ndef get_handle(p):\n    # 1) propiedad Handle directa\n    try:\n        h = p.Handle\n        if h is not None:\n            return str(h)\n    except:\n        pass\n    # 2) via InternalObjectId / ObjectId\n    for attr in ('InternalObjectId', 'ObjectId', 'InternalObjectID', 'objectId'):\n        try:\n            oid = getattr(p, attr)\n            if oid is not None:\n                return oid.Handle.ToString()\n        except:\n            pass\n    # 3) via InternalDBObject\n    try:\n        dbo = p.InternalDBObject\n        if dbo is not None:\n            return dbo.Handle.ToString()\n    except:\n        pass\n    return None\n\ntry:\n    by_handle = {}\n    unknown = 0\n    for p in pls:\n        h = get_handle(p)\n        if h is None:\n            unknown += 1\n            continue\n        by_handle[h] = p\n\n    ordered = []\n    missing = 0\n    for h in handles_wanted:\n        if h in by_handle:\n            ordered.append(by_handle[h])\n        else:\n            missing += 1\n\n    line = \"Filter: in={}, wanted={}, matched={}, missing={}, unknown={}\".format(\n        len(pls), len(handles_wanted), len(ordered), missing, unknown)\n    prev = getattr(main_mod, '_tracker_align_log', '') or ''\n    main_mod._tracker_align_log = prev + \"\\n\" + line\n\n    OUT = ordered\nexcept Exception as ex:\n    prev = getattr(main_mod, '_tracker_align_log', '') or ''\n    main_mod._tracker_align_log = prev + \"\\nFILTER ERROR: \" + str(ex) + \"\\n\" + traceback.format_exc()\n    OUT = []\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "e85597390b0a5ecea078c6d22b2eb06c",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "315f45e486325cb5b4ce108797c514b8",
          "Name": "IN[0]",
          "Description": "",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "ada76deb97d3540e9920cef2c33727e5",
          "Name": "",
          "Description": "",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\n# =============================================================================\n# Tracker_Surface  -  Nodo Python principal\n# Civil 3D 2024 / Dynamo / CPython3\n#\n# Flujo:\n#   - Por cada polilinea de contorno: FeatureLine + AssignElevationsFromSurface\n#     (insertIntermediateGradeBreakPoints=True)\n#   - Por cada polilinea de tracker: FeatureLine + AssignElevationsFromSurface\n#     (insertIntermediateGradeBreakPoints=False)\n#   - Todas las FeatureLines se anyaden a la superficie como breaklines.\n#   - Contornos como boundary (primero Outer, resto Show).\n#   - Estilo de FeatureLine aplicado mediante indexador directo (robusto).\n#\n# IN[0] : str  nombre del MDT\n# IN[1] : str  capa de contornos\n# IN[2] : str  capa de trackers\n# IN[3] : str  nombre de la nueva superficie de trackers\n# IN[4] : str  nombre del estilo de FeatureLine\n# =============================================================================\n\nimport clr\nimport traceback\n\nclr.AddReference('AcMgd')\nclr.AddReference('AcCoreMgd')\nclr.AddReference('AcDbMgd')\nclr.AddReference('AecBaseMgd')\nclr.AddReference('AeccDbMgd')\n\nfrom Autodesk.AutoCAD.ApplicationServices import Application as AcadApp\nfrom Autodesk.AutoCAD.DatabaseServices import (\n    OpenMode, BlockTable, BlockTableRecord,\n    Polyline, SymbolUtilityServices, ObjectIdCollection, ObjectId\n)\nfrom Autodesk.AutoCAD.Geometry import Point3d, Point3dCollection\nfrom Autodesk.Civil import SurfaceBoundaryType\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import TinSurface, FeatureLine\nfrom System import String as SysString\n\n# --------------------------------------------------------------------------- #\n# Inputs\n# --------------------------------------------------------------------------- #\nmdt_name       = str(IN[0])\ncontour_layer  = str(IN[1])\ntracker_layer  = str(IN[2])\nout_surf_name  = str(IN[3])\nfl_style_name  = str(IN[4])\n\nlog = []\n\ntry:\n    doc  = AcadApp.DocumentManager.MdiActiveDocument\n    db   = doc.Database\n    cdoc = CivilApplication.ActiveDocument\n\n    dlock = doc.LockDocument()\n    try:\n        tr = db.TransactionManager.StartTransaction()\n        try:\n\n            # ---------------------------------------------------------------- #\n            # 1. MDT\n            # ---------------------------------------------------------------- #\n            mdt_surf = None\n            mdt_surf_id = None\n            for sid in cdoc.GetSurfaceIds():\n                s = tr.GetObject(sid, OpenMode.ForRead)\n                if s.Name == mdt_name:\n                    mdt_surf = s\n                    mdt_surf_id = sid\n                    break\n            if mdt_surf is None:\n                raise Exception(\"No se ha encontrado el MDT '{}'.\".format(mdt_name))\n\n            # ---------------------------------------------------------------- #\n            # 2. Recoger polylines por capa y borrar FLs previas\n            # ---------------------------------------------------------------- #\n            bt   = tr.GetObject(db.BlockTableId, OpenMode.ForRead)\n            ms_id = SymbolUtilityServices.GetBlockModelSpaceId(db)\n            btr  = tr.GetObject(ms_id, OpenMode.ForWrite)\n\n            contour_poly_ids = []\n            contour_xy_lists = []\n            tracker_poly_ids = []\n            old_fls_to_erase = []\n\n            for oid in btr:\n                obj = tr.GetObject(oid, OpenMode.ForRead)\n                if isinstance(obj, FeatureLine):\n                    try:\n                        nm = obj.Name\n                        if nm and (nm.startswith(\"FL_C\") or nm.startswith(\"FL_T\")):\n                            old_fls_to_erase.append(oid)\n                    except:\n                        pass\n                    continue\n                if not isinstance(obj, Polyline):\n                    continue\n                lay = obj.Layer\n                n = obj.NumberOfVertices\n                if lay == contour_layer and n >= 3:\n                    pts = []\n                    for i in range(n):\n                        p = obj.GetPoint2dAt(i)\n                        pts.append((p.X, p.Y))\n                    contour_xy_lists.append(pts)\n                    contour_poly_ids.append(oid)\n                elif lay == tracker_layer and n >= 2:\n                    tracker_poly_ids.append(oid)\n\n            n_erased = 0\n            for oid in old_fls_to_erase:\n                try:\n                    fl_old = tr.GetObject(oid, OpenMode.ForWrite)\n                    fl_old.Erase()\n                    n_erased += 1\n                except:\n                    pass\n            if n_erased > 0:\n                log.append(\"FeatureLines previas borradas: {}\".format(n_erased))\n\n            if not contour_poly_ids:\n                raise Exception(\"No hay polilineas en la capa de contorno '{}'.\".format(contour_layer))\n            if not tracker_poly_ids:\n                raise Exception(\"No hay polilineas en la capa de trackers '{}'.\".format(tracker_layer))\n\n            log.append(\"Polilineas contorno: {}\".format(len(contour_poly_ids)))\n            log.append(\"Polilineas tracker:  {}\".format(len(tracker_poly_ids)))\n\n            # ---------------------------------------------------------------- #\n            # 2b. Buscar estilo de FeatureLine — ROBUSTO\n            #\n            # FeatureLineStyle.Name es ilegible via pythonnet (bug conocido).\n            # Estrategia: usar el indexador directo de la coleccion de estilos,\n            # que acepta el nombre como string y devuelve el ObjectId sin\n            # necesidad de leer .Name desde fuera.\n            # ---------------------------------------------------------------- #\n            fl_style_id = ObjectId.Null\n            wanted = fl_style_name.strip()\n\n            if wanted:\n                # --- Metodo 1: get_Item(string) en la coleccion ---\n                try:\n                    coll = cdoc.Styles.FeatureLineStyles\n                    try:\n                        fl_style_id = coll.get_Item(wanted)\n                        log.append(\"Estilo FL encontrado (get_Item): '{}'\".format(wanted))\n                    except:\n                        pass\n                except:\n                    pass\n\n                # --- Metodo 2: indexador con corchetes ---\n                if fl_style_id == ObjectId.Null:\n                    try:\n                        coll = cdoc.Styles.FeatureLineStyles\n                        fl_style_id = coll[wanted]\n                        log.append(\"Estilo FL encontrado (indexer): '{}'\".format(wanted))\n                    except:\n                        pass\n\n                # --- Metodo 3: reflexion para invocar get_Item(String) ---\n                if fl_style_id == ObjectId.Null:\n                    try:\n                        coll = cdoc.Styles.FeatureLineStyles\n                        ct = clr.GetClrType(coll.GetType())\n                        gi = ct.GetMethod(\"get_Item\", [clr.GetClrType(SysString)])\n                        if gi is not None:\n                            fl_style_id = gi.Invoke(coll, [wanted])\n                            if fl_style_id is not None and fl_style_id != ObjectId.Null:\n                                log.append(\"Estilo FL encontrado (reflection): '{}'\".format(wanted))\n                    except:\n                        pass\n\n                # --- Metodo 4: iterar e intentar leer Name con bare except ---\n                if fl_style_id == ObjectId.Null:\n                    try:\n                        coll = cdoc.Styles.FeatureLineStyles\n                        found_names = []\n                        for stid in coll:\n                            try:\n                                st = tr.GetObject(stid, OpenMode.ForRead)\n                                try:\n                                    nm = st.Name\n                                    found_names.append(nm)\n                                    if nm.strip().lower() == wanted.lower():\n                                        fl_style_id = stid\n                                        log.append(\"Estilo FL encontrado (iter): '{}'\".format(nm))\n                                        break\n                                except:\n                                    found_names.append(\"<ilegible>\")\n                            except:\n                                pass\n                        if fl_style_id == ObjectId.Null:\n                            log.append(\"Estilos encontrados: {}\".format(found_names))\n                    except Exception as ex:\n                        log.append(\"Error iterando estilos: {}\".format(str(ex)))\n\n                if fl_style_id == ObjectId.Null:\n                    log.append(\"AVISO: estilo FL '{}' NO encontrado.\".format(wanted))\n\n            # ---------------------------------------------------------------- #\n            # 3. Crear FeatureLines y asignar elevaciones\n            # ---------------------------------------------------------------- #\n            def make_fl(poly_id, name):\n                errors = []\n                try:\n                    return FeatureLine.Create(name, poly_id)\n                except Exception as e1:\n                    errors.append(\"v1(2args): \" + str(e1))\n                try:\n                    return FeatureLine.Create(name, poly_id, ObjectId.Null)\n                except Exception as e2:\n                    errors.append(\"v2(3args): \" + str(e2))\n                raise Exception(\" || \".join(errors))\n\n            def assign_z(fl_obj, insert_grade_breaks):\n                errors = []\n                try:\n                    return fl_obj.AssignElevationsFromSurface(\n                        mdt_surf_id, insert_grade_breaks)\n                except Exception as e1:\n                    errors.append(\"v1(2args): \" + str(e1))\n                try:\n                    return fl_obj.AssignElevationsFromSurface(mdt_surf_id)\n                except Exception as e2:\n                    errors.append(\"v2(1arg): \" + str(e2))\n                raise Exception(\" || \".join(errors))\n\n            featureline_ids = ObjectIdCollection()\n            n_fl_contour = 0\n            n_fl_tracker = 0\n            first_fl_err = None\n            first_assign_err = None\n            n_styled = 0\n            first_style_err = None\n\n            # -- contornos: CON grade break points --\n            for i, poly_id in enumerate(contour_poly_ids):\n                fl_name = \"FL_C{:02d}\".format(i + 1)\n                try:\n                    fl_id = make_fl(poly_id, fl_name)\n                except Exception as ex_cr:\n                    if first_fl_err is None:\n                        first_fl_err = str(ex_cr)\n                    continue\n                try:\n                    fl_obj = tr.GetObject(fl_id, OpenMode.ForWrite)\n                    assign_z(fl_obj, True)\n                    if fl_style_id != ObjectId.Null:\n                        try:\n                            fl_obj.StyleId = fl_style_id\n                            n_styled += 1\n                        except Exception as ex_sty:\n                            if first_style_err is None:\n                                first_style_err = str(ex_sty)\n                    featureline_ids.Add(fl_id)\n                    n_fl_contour += 1\n                except Exception as ex_az:\n                    if first_assign_err is None:\n                        first_assign_err = str(ex_az)\n\n            # -- trackers: SIN grade break points --\n            for i, poly_id in enumerate(tracker_poly_ids):\n                fl_name = \"FL_T{:02d}\".format(i + 1)\n                try:\n                    fl_id = make_fl(poly_id, fl_name)\n                except Exception as ex_cr:\n                    if first_fl_err is None:\n                        first_fl_err = str(ex_cr)\n                    continue\n                try:\n                    fl_obj = tr.GetObject(fl_id, OpenMode.ForWrite)\n                    assign_z(fl_obj, False)\n                    if fl_style_id != ObjectId.Null:\n                        try:\n                            fl_obj.StyleId = fl_style_id\n                            n_styled += 1\n                        except Exception as ex_sty:\n                            if first_style_err is None:\n                                first_style_err = str(ex_sty)\n                    featureline_ids.Add(fl_id)\n                    n_fl_tracker += 1\n                except Exception as ex_az:\n                    if first_assign_err is None:\n                        first_assign_err = str(ex_az)\n\n            log.append(\"FeatureLines contorno: {}\".format(n_fl_contour))\n            log.append(\"FeatureLines tracker:  {}\".format(n_fl_tracker))\n            if fl_style_id != ObjectId.Null:\n                log.append(\"FLs con estilo '{}' aplicado: {}\".format(wanted, n_styled))\n                if first_style_err:\n                    log.append(\"Primer error estilo: {}\".format(first_style_err))\n            if first_fl_err:\n                log.append(\"Primer error FL.Create: {}\".format(first_fl_err))\n                try:\n                    sigs = []\n                    ct = clr.GetClrType(FeatureLine)\n                    for mm in ct.GetMethods():\n                        if mm.Name == \"Create\":\n                            params = \", \".join(p.ParameterType.Name + \" \" + p.Name\n                                               for p in mm.GetParameters())\n                            sigs.append(\"Create(\" + params + \")\")\n                    if sigs:\n                        log.append(\"Firmas FeatureLine.Create:\")\n                        for s in sigs:\n                            log.append(\"  \" + s)\n                except:\n                    pass\n            if first_assign_err:\n                log.append(\"Primer error AssignElevations: {}\".format(first_assign_err))\n\n            # ---------------------------------------------------------------- #\n            # 4. Crear superficie TIN\n            # ---------------------------------------------------------------- #\n            existing_id = None\n            for sid in cdoc.GetSurfaceIds():\n                s = tr.GetObject(sid, OpenMode.ForRead)\n                if s.Name == out_surf_name:\n                    existing_id = sid\n                    break\n            if existing_id is not None:\n                sx = tr.GetObject(existing_id, OpenMode.ForWrite)\n                sx.Erase()\n\n            new_surf_id = TinSurface.Create(db, out_surf_name)\n            new_surf    = tr.GetObject(new_surf_id, OpenMode.ForWrite)\n\n            # ---------------------------------------------------------------- #\n            # 5. Breaklines\n            # ---------------------------------------------------------------- #\n            if featureline_ids.Count > 0:\n                try:\n                    new_surf.BreaklinesDefinition.AddStandardBreaklines(\n                        featureline_ids,\n                        1.0,    # midOrdinateDistance\n                        100.0,  # maximumDistance\n                        0.0,    # weedingDistance\n                        0.0     # weedingAngle\n                    )\n                    log.append(\"Breaklines anyadidas: {}\".format(featureline_ids.Count))\n                except Exception as ex_bl:\n                    log.append(\"ERROR AddStandardBreaklines: {}\".format(ex_bl))\n\n            try:\n                new_surf.Rebuild()\n            except:\n                pass\n\n            n_tri = -1\n            try:\n                gp = new_surf.GetGeneralProperties()\n                for prop_name in (\"NumberOfTriangles\", \"TriangleCount\", \"NumTriangles\"):\n                    if hasattr(gp, prop_name):\n                        n_tri = getattr(gp, prop_name)\n                        break\n                if n_tri >= 0:\n                    log.append(\"Triangulos: {}\".format(n_tri))\n            except:\n                pass\n\n            # ---------------------------------------------------------------- #\n            # 6. Boundaries\n            # ---------------------------------------------------------------- #\n            n_bnd = 0\n            first = True\n            for c in contour_xy_lists:\n                pc = Point3dCollection()\n                for (x, y) in c:\n                    pc.Add(Point3d(x, y, 0.0))\n                if (c[0][0], c[0][1]) != (c[-1][0], c[-1][1]):\n                    pc.Add(Point3d(c[0][0], c[0][1], 0.0))\n                btype = SurfaceBoundaryType.Outer if first else SurfaceBoundaryType.Show\n                try:\n                    new_surf.BoundariesDefinition.AddBoundaries(pc, 1.0, btype, True)\n                    n_bnd += 1\n                except Exception as ex_bn:\n                    log.append(\"AVISO boundary: {}\".format(ex_bn))\n                first = False\n            log.append(\"Boundaries anyadidos: {}\".format(n_bnd))\n\n            tr.Commit()\n        finally:\n            tr.Dispose()\n    finally:\n        dlock.Dispose()\n\n    log.append(\"\")\n    log.append(\"=== RESUMEN ===\")\n    log.append(\"Superficie creada: {}\".format(out_surf_name))\n\n    OUT = \"\\n\".join(log)\n\nexcept Exception as ex:\n    OUT = \"ERROR:\\n\" + str(ex) + \"\\n\\n\" + traceback.format_exc()\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "dd5385ebb22e4942a0215aa69fb2499c",
      "NodeType": "PythonScriptNode",
      "Inputs": [
