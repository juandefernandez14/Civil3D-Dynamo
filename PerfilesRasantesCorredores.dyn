    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\n# =============================================================================\n# Rasante_Viales - Paso 3: Genera rasante auto para cada alignment\n#\n# Algoritmo (enfoque HIBRIDO - el script propone, el usuario ajusta):\n#   1. Muestrear TN cada `intervalo` m a lo largo del eje\n#        -> Alignment.PointLocation(sta, 0) + Surface.FindElevationAtXY(x,y)\n#   2. Desplazar cotas +altura objetivo (p.ej. +10 cm)\n#   3. Simplificar Douglas-Peucker con tolerancia 2*altura (~20 cm)\n#        -> reduce la nube de puntos a los PVIs significativos\n#   4. Fusionar PVIs demasiado cercanos (< 1.5 * long_acuerdo)\n#        -> deja sitio para los acuerdos verticales\n#   5. Corregir pendientes:\n#        - si |s| > max -> capar a +/-max\n#        - si |s| < min -> redondear a +/-min preservando signo\n#   6. Crear Profile Layout con Profile.CreateByLayout\n#   7. Insertar PVIs via profile.PVIs.AddPVI(Point2d(sta, elev))\n#   8. Insertar acuerdos parabolicos simetricos de longitud = long_acuerdo\n#\n# El perfil resultante queda como Profile tipo Layout (editable en Civil 3D),\n# por lo que el usuario puede arrastrar PVIs, cambiar longitudes de acuerdo,\n# anyadir o borrar PVIs directamente en la ProfileView.\n#\n# ENTRADAS:\n#   IN[0] : list[str]  nombres alignments (output Paso 1, barrera sync)\n#   IN[1] : str        nombre superficie TN\n#   IN[2] : float      altura objetivo rasante sobre TN (m)\n#   IN[3] : float      pendiente maxima (%)\n#   IN[4] : float      pendiente minima (%)\n#   IN[5] : float      longitud minima acuerdo vertical (m)\n#   IN[6] : float      intervalo muestreo TN (m)\n#   IN[7] : str        nombre estilo perfil rasante\n#\n# SALIDA (lista de 2):\n#   [0] list[str]  rasantes creadas (nombre: N_PVIs)\n#   [1] list[str]  log / diagnostico\n# =============================================================================\n\nimport clr\nimport math\nimport traceback\n\nclr.AddReference(\"AcMgd\")\nclr.AddReference(\"AcDbMgd\")\nclr.AddReference(\"AcCoreMgd\")\nclr.AddReference(\"AeccDbMgd\")\n\nfrom System import String as SysString, Double\nimport System\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import (\n    OpenMode, ObjectId, LayerTableRecord\n)\nfrom Autodesk.AutoCAD.Geometry import Point2d\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import Profile\n\n# ═══════════════════════════════════════════════════════════════════════\n# Inputs\n# ═══════════════════════════════════════════════════════════════════════\nalignment_names = IN[0] if IN[0] is not None else []\nif not isinstance(alignment_names, list):\n    alignment_names = [alignment_names]\n\nsurface_name        = str(IN[1]) if IN[1] else \"\"\ntarget_h            = float(IN[2])          # m\nmax_slope           = float(IN[3]) / 100.0  # decimal\nmin_slope           = float(IN[4]) / 100.0  # decimal\nmin_curve_length    = float(IN[5])          # m\nsampling_interval   = float(IN[6])          # m\nrasante_style_name  = str(IN[7]) if IN[7] else \"\"\n\n# IN[9]: lista de \"name|handle\" que viene de Paso 2 (barrera sync + datos)\npv_handles_in = IN[9] if (len(IN) > 9 and IN[9] is not None) else []\nif not isinstance(pv_handles_in, list):\n    pv_handles_in = [pv_handles_in]\n\n# Parsear: dict nombre_PV -> handle (string hex)\npv_handle_by_name = {}\nfor s in pv_handles_in:\n    try:\n        parts = str(s).split(\"|\", 1)\n        if len(parts) == 2 and parts[1]:\n            pv_handle_by_name[parts[0]] = parts[1]\n    except Exception:\n        pass\n\nrasante_prefix = \"RAS \"\nprofile_layer  = \"0\"\n\n# Derivados\ndp_tolerance = target_h * 2.0              # tolerancia Douglas-Peucker (m)\nmin_pvi_distance = min_curve_length * 1.5  # separacion minima entre PVIs (m)\n\nlog = []\nrasantes_created = []\n\n\n# ═══════════════════════════════════════════════════════════════════════\n# Helpers: lookup robustos (mismo patron que Pasos 1 y 2)\n# ═══════════════════════════════════════════════════════════════════════\n\ndef get_name_safe(obj):\n    try:\n        return obj.Name\n    except Exception:\n        return None\n\n\ndef find_alignment_by_name(cdoc, tr, name):\n    try:\n        ids = cdoc.GetAlignmentIds()\n        for i in range(ids.Count):\n            try:\n                aid = ids.get_Item(i)\n            except Exception:\n                try:\n                    aid = ids[i]\n                except Exception:\n                    continue\n            try:\n                a = tr.GetObject(aid, OpenMode.ForRead)\n                if get_name_safe(a) == name:\n                    return aid, a\n            except Exception:\n                pass\n    except Exception:\n        pass\n    return None, None\n\n\ndef find_surface_by_name(cdoc, tr, name):\n    try:\n        ids = cdoc.GetSurfaceIds()\n        for i in range(ids.Count):\n            try:\n                sid = ids.get_Item(i)\n            except Exception:\n                try:\n                    sid = ids[i]\n                except Exception:\n                    continue\n            try:\n                s = tr.GetObject(sid, OpenMode.ForRead)\n                if get_name_safe(s) == name:\n                    return s\n            except Exception:\n                pass\n    except Exception:\n        pass\n    return None\n\n\ndef find_profile_style_by_name(cdoc, tr, name, log):\n    \"\"\"Patron 4-metodos ya probado (evita el bug de .Name).\"\"\"\n    if not name:\n        return ObjectId.Null\n    wanted = name.strip()\n    try:\n        coll = cdoc.Styles.ProfileStyles\n    except Exception:\n        return ObjectId.Null\n\n    try:\n        sid = coll.get_Item(wanted)\n        if sid is not None and not sid.IsNull:\n            log.append(\"Estilo rasante encontrado (get_Item): '{}'\".format(wanted))\n            return sid\n    except Exception:\n        pass\n    try:\n        sid = coll[wanted]\n        if sid is not None and not sid.IsNull:\n            log.append(\"Estilo rasante encontrado (indexer): '{}'\".format(wanted))\n            return sid\n    except Exception:\n        pass\n    try:\n        ct = clr.GetClrType(coll.GetType())\n        gi = ct.GetMethod(\"get_Item\", [clr.GetClrType(SysString)])\n        if gi is not None:\n            sid = gi.Invoke(coll, [wanted])\n            if sid is not None and not sid.IsNull:\n                log.append(\"Estilo rasante encontrado (reflection): '{}'\"\n                           .format(wanted))\n                return sid\n    except Exception:\n        pass\n    return ObjectId.Null\n\n\ndef get_profile_label_set_id(cdoc, tr):\n    \"\"\"Civil 3D NO acepta null para labelSetId; devolvemos uno valido.\"\"\"\n    try:\n        coll = cdoc.Styles.LabelSetStyles.ProfileLabelSetStyles\n    except Exception:\n        return ObjectId.Null\n\n    for cand in (\"_No Labels\", \"No Labels\", \"_Sin etiquetas\", \"Standard\"):\n        try:\n            oid = coll.get_Item(cand)\n            if oid is not None and not oid.IsNull:\n                return oid\n        except Exception:\n            pass\n        try:\n            oid = coll[cand]\n            if oid is not None and not oid.IsNull:\n                return oid\n        except Exception:\n            pass\n\n    try:\n        oid = coll.get_Item(0)\n        if oid is not None and not oid.IsNull:\n            return oid\n    except Exception:\n        pass\n    try:\n        for oid in coll:\n            if oid is not None and not oid.IsNull:\n                return oid\n    except Exception:\n        pass\n    return ObjectId.Null\n\n\ndef ensure_layer(tr, db, name):\n    lt = tr.GetObject(db.LayerTableId, OpenMode.ForRead)\n    try:\n        if lt.Has(name):\n            return lt.get_Item(name)\n    except Exception:\n        pass\n    try:\n        lt.UpgradeOpen()\n        ltr = LayerTableRecord()\n        ltr.Name = name\n        lid = lt.Add(ltr)\n        tr.AddNewlyCreatedDBObject(ltr, True)\n        return lid\n    except Exception:\n        try:\n            return lt.get_Item(\"0\")\n        except Exception:\n            return ObjectId.Null\n\n\ndef find_pv_bandset_by_name(cdoc, tr, name, log):\n    \"\"\"Busca Band Set por nombre. Prueba varias rutas de coleccion y 3\n    metodos de indexacion (mismo patron que Paso 2).\"\"\"\n    if not name:\n        return ObjectId.Null\n    wanted = name.strip()\n\n    paths = []\n    for accessor in (\n        lambda: cdoc.Styles.ProfileViewBandSetStyles,\n        lambda: cdoc.Styles.BandSetStyles.ProfileViewBandSetStyles,\n        lambda: cdoc.Styles.BandSetStyles,\n        lambda: cdoc.Styles.ProfileView.BandSetStyles,\n    ):\n        try:\n            coll = accessor()\n            if coll is not None:\n                paths.append(coll)\n        except Exception:\n            pass\n\n    for coll in paths:\n        try:\n            bid = coll.get_Item(wanted)\n            if bid is not None and not bid.IsNull:\n                log.append(\"Band set encontrado (get_Item): '{}'\".format(wanted))\n                return bid\n        except Exception:\n            pass\n        try:\n            bid = coll[wanted]\n            if bid is not None and not bid.IsNull:\n                log.append(\"Band set encontrado (indexer): '{}'\".format(wanted))\n                return bid\n        except Exception:\n            pass\n        try:\n            ct = clr.GetClrType(coll.GetType())\n            gi = ct.GetMethod(\"get_Item\", [clr.GetClrType(SysString)])\n            if gi is not None:\n                bid = gi.Invoke(coll, [wanted])\n                if bid is not None and not bid.IsNull:\n                    log.append(\"Band set encontrado (reflection): '{}'\"\n                               .format(wanted))\n                    return bid\n        except Exception:\n            pass\n    return ObjectId.Null\n\n\ndef list_pv_band_methods(pv_obj, log):\n    \"\"\"Diagnostico: lista metodos de ProfileView relacionados con bandas.\"\"\"\n    try:\n        ct = clr.GetClrType(pv_obj.GetType())\n        found = []\n        for m in ct.GetMethods():\n            if \"Band\" in m.Name:\n                params_str = \", \".join(\n                    \"{} {}\".format(p.ParameterType.Name, p.Name)\n                    for p in m.GetParameters())\n                found.append(\"{}({})\".format(m.Name, params_str))\n        for s in found[:10]:\n            log.append(\"  PV.{}\".format(s))\n    except Exception as ex:\n        log.append(\"  list_pv_band_methods error: \" + str(ex)[:100])\n\n\ndef apply_bandset_to_pv(pv_obj, bandset_id, log, label):\n    \"\"\"Aplica un band set a una ProfileView. Prueba 3 caminos:\n       1) pv.ImportBandSet(id)\n       2) pv.Bands.ImportBandSetStyle(id)\n       3) Reflexion: buscar cualquier metodo que tome ObjectId y lo invoca\"\"\"\n    tried = []\n\n    # Intento 1\n    try:\n        pv_obj.ImportBandSet(bandset_id)\n        log.append(\"  {}: band set aplicado via ImportBandSet\".format(label))\n        return True\n    except Exception as e:\n        tried.append(\"ImportBandSet: \" + str(e)[:150])\n\n    # Intento 2\n    try:\n        pv_obj.Bands.ImportBandSetStyle(bandset_id)\n        log.append(\"  {}: band set aplicado via Bands.ImportBandSetStyle\"\n                   .format(label))\n        return True\n    except Exception as e:\n        tried.append(\"Bands.ImportBandSetStyle: \" + str(e)[:150])\n\n    # Intento 3: reflexion sobre el objeto PV, buscar cualquier metodo con\n    #            \"Import\" o \"Band\" que tome un ObjectId\n    try:\n        ct = clr.GetClrType(pv_obj.GetType())\n        for m in ct.GetMethods():\n            name = m.Name\n            if not (\"Band\" in name and (\"Import\" in name or \"Set\" in name)):\n                continue\n            params = m.GetParameters()\n            if len(params) != 1:\n                continue\n            pt_name = params[0].ParameterType.Name\n            if pt_name != \"ObjectId\":\n                continue\n            try:\n                args = System.Array[System.Object]([bandset_id])\n                m.Invoke(pv_obj, args)\n                log.append(\"  {}: band set aplicado via reflection.{}\"\n                           .format(label, name))\n                return True\n            except Exception as e_refl:\n                tried.append(\"refl.{}: {}\".format(name, str(e_refl)[:150]))\n    except Exception as e:\n        tried.append(\"reflection scan: \" + str(e)[:100])\n\n    log.append(\"{}: no pude aplicar band set. Intentos: {}\".format(\n        label, \" || \".join(tried)))\n    return False\n\n\ndef find_pv_for_alignment(alignment, alignment_id, tr, db, name_hint, log=None):\n    \"\"\"Busca la ProfileView asociada al alignment. 2 estrategias:\n       1) alignment.GetProfileViewIds() — en teoria lo correcto\n       2) Iterar ModelSpace filtrando ProfileView por nombre o AlignmentId\n    \"\"\"\n    from Autodesk.Civil.DatabaseServices import ProfileView\n    from Autodesk.AutoCAD.DatabaseServices import BlockTableRecord\n\n    # Metodo 1\n    pv_ids_count = -1\n    try:\n        pv_ids = alignment.GetProfileViewIds()\n        pv_ids_count = pv_ids.Count\n        if log is not None:\n            log.append(\"  GetProfileViewIds devolvio {} PVs\".format(pv_ids_count))\n        for i in range(pv_ids_count):\n            try:\n                pvid = pv_ids.get_Item(i)\n            except Exception:\n                try:\n                    pvid = pv_ids[i]\n                except Exception:\n                    continue\n            try:\n                return tr.GetObject(pvid, OpenMode.ForWrite)\n            except Exception:\n                pass\n    except Exception as ex:\n        if log is not None:\n            log.append(\"  GetProfileViewIds ERROR: \" + str(ex)[:100])\n\n    # Metodo 2: iterar TODOS los BlockTableRecords (ModelSpace + Layouts)\n    #           porque las ProfileViews pueden estar en un Layout (Paper Space)\n    try:\n        bt = tr.GetObject(db.BlockTableId, OpenMode.ForRead)\n        n_checked = 0\n        types_seen = {}\n        containers_seen = {}\n        pv_obj = None\n\n        for btr_id in bt:\n            try:\n                btr = tr.GetObject(btr_id, OpenMode.ForRead)\n                btr_name = \"<?>\"\n                try:\n                    btr_name = btr.Name\n                except Exception:\n                    pass\n                n_in_btr = 0\n                for oid in btr:\n                    try:\n                        obj = tr.GetObject(oid, OpenMode.ForRead)\n                        n_checked += 1\n                        n_in_btr += 1\n                        type_name = obj.GetType().Name\n                        types_seen[type_name] = types_seen.get(type_name, 0) + 1\n                        if type_name == \"ProfileView\":\n                            containers_seen[btr_name] = containers_seen.get(\n                                btr_name, 0) + 1\n                            try:\n                                obj_name = obj.Name\n                                if obj_name == name_hint:\n                                    obj.UpgradeOpen()\n                                    pv_obj = obj\n                                    if log is not None:\n                                        log.append(\n                                            \"  PV '{}' encontrada en '{}'\"\n                                            .format(name_hint, btr_name))\n                                    break\n                            except Exception:\n                                pass\n                            try:\n                                if obj.AlignmentId == alignment_id:\n                                    obj.UpgradeOpen()\n                                    pv_obj = obj\n                                    if log is not None:\n                                        log.append(\n                                            \"  PV encontrada por AlignmentId en '{}'\"\n                                            .format(btr_name))\n                                    break\n                            except Exception:\n                                pass\n                    except Exception:\n                        pass\n                if pv_obj is not None:\n                    break\n            except Exception:\n                pass\n\n        if pv_obj is not None:\n            return pv_obj\n\n        if log is not None:\n            tstr = \", \".join(\"{}:{}\".format(k, v)\n                             for k, v in sorted(types_seen.items()))\n            log.append(\"  Scan full BT: {} objetos. Tipos: {}\"\n                       .format(n_checked, tstr))\n            if containers_seen:\n                log.append(\"  PVs vistas (pero sin coincidir): {}\"\n                           .format(dict(containers_seen)))\n    except Exception as ex:\n        if log is not None:\n            log.append(\"  BlockTable iterate ERROR: \" + str(ex)[:150])\n\n    return None\n\n\n# ═══════════════════════════════════════════════════════════════════════\n# Algoritmo rasante\n# ═══════════════════════════════════════════════════════════════════════\n\ndef alignment_xy_at_station(alignment, station, diag=None):\n    \"\"\"Devuelve (x, y) en la estacion. Prueba 4 metodos; si diag no es None\n    apunta ahi los errores del primer fallo.\"\"\"\n    errors = []\n\n    # Metodo A: out params vuelven como tupla (pythonnet CPython3 default)\n    try:\n        result = alignment.PointLocation(float(station), 0.0)\n        if isinstance(result, (tuple, list)):\n            if len(result) >= 2:\n                return float(result[0]), float(result[1])\n            errors.append(\"A: tupla con {} elems\".format(len(result)))\n        elif result is None:\n            errors.append(\"A: returno None\")\n        else:\n            errors.append(\"A: tipo={}\".format(type(result).__name__))\n    except Exception as e:\n        errors.append(\"A: \" + str(e)[:100])\n\n    # Metodo B: clr.Reference[Double]\n    try:\n        e_ref = clr.Reference[Double](0.0)\n        n_ref = clr.Reference[Double](0.0)\n        alignment.PointLocation(float(station), 0.0, e_ref, n_ref)\n        return float(e_ref.Value), float(n_ref.Value)\n    except Exception as e:\n        errors.append(\"B: \" + str(e)[:100])\n\n    # Metodo C: StrongBox\n    try:\n        from System.Runtime.CompilerServices import StrongBox\n        e_box = StrongBox[Double](0.0)\n        n_box = StrongBox[Double](0.0)\n        alignment.PointLocation(float(station), 0.0, e_box, n_box)\n        return float(e_box.Value), float(n_box.Value)\n    except Exception as e:\n        errors.append(\"C: \" + str(e)[:100])\n\n    # Metodo D: reflexion para llamar con System.Double refs\n    try:\n        ct = clr.GetClrType(alignment.GetType())\n        methods = ct.GetMethods()\n        for m in methods:\n            if m.Name == \"PointLocation\":\n                ps = m.GetParameters()\n                if len(ps) == 4:\n                    # Construir args: station, offset, e_out, n_out\n                    args = System.Array[System.Object]([\n                        float(station), 0.0, 0.0, 0.0])\n                    m.Invoke(alignment, args)\n                    return float(args[2]), float(args[3])\n    except Exception as e:\n        errors.append(\"D: \" + str(e)[:100])\n\n    if diag is not None:\n        diag.append(\"XY@sta {:.2f}: fallaron los 4 metodos. {}\"\n                    .format(station, \" | \".join(errors)))\n    return None, None\n\n\ndef sample_tn(alignment, surface, start_sta, end_sta, interval, log,\n              diagnose_first=False):\n    \"\"\"Muestrea cotas del TN cada `interval` m, incluido el final.\"\"\"\n    samples = []\n    diag_info = []\n\n    if diagnose_first:\n        diag_info.append(\"alignment type: {}\".format(type(alignment).__name__))\n        diag_info.append(\"surface type: {}\".format(type(surface).__name__))\n        diag_info.append(\"stations: [{:.2f}, {:.2f}] len={:.2f}\"\n                         .format(start_sta, end_sta, end_sta - start_sta))\n\n    first_xy_fail_logged = False\n    first_elev_fail_logged = False\n    n_xy_fail = 0\n    n_elev_fail = 0\n\n    s = start_sta\n    idx = 0\n    while s <= end_sta + 1e-6:\n        xy_errs = [] if (diagnose_first and not first_xy_fail_logged) else None\n        x, y = alignment_xy_at_station(alignment, s, xy_errs)\n\n        if x is None:\n            n_xy_fail += 1\n            if xy_errs and not first_xy_fail_logged:\n                diag_info.extend(xy_errs)\n                first_xy_fail_logged = True\n        else:\n            try:\n                elev = surface.FindElevationAtXY(float(x), float(y))\n                samples.append((s, float(elev)))\n                if diagnose_first and idx == 0:\n                    diag_info.append(\"1a muestra OK: sta={:.2f} xy=({:.2f},{:.2f}) z={:.3f}\"\n                                     .format(s, x, y, float(elev)))\n            except Exception as e:\n                n_elev_fail += 1\n                if diagnose_first and not first_elev_fail_logged:\n                    diag_info.append(\"FindElevationAtXY fallo @sta={:.2f} xy=({:.2f},{:.2f}): {}\"\n                                     .format(s, x, y, str(e)[:150]))\n                    first_elev_fail_logged = True\n\n        s += interval\n        idx += 1\n\n    # Incluir estacion final\n    if not samples or abs(samples[-1][0] - end_sta) > 0.01:\n        x, y = alignment_xy_at_station(alignment, end_sta)\n        if x is not None:\n            try:\n                elev = surface.FindElevationAtXY(float(x), float(y))\n                samples.append((end_sta, float(elev)))\n            except Exception:\n                pass\n\n    if diagnose_first:\n        diag_info.append(\"total muestras: {}, XY fails: {}, elev fails: {}\"\n                         .format(len(samples), n_xy_fail, n_elev_fail))\n        for line in diag_info:\n            log.append(\"  [DIAG] \" + line)\n\n    return samples\n\n\ndef douglas_peucker(points, epsilon):\n    \"\"\"Simplifica polyline (sta, elev) por desviacion vertical maxima.\"\"\"\n    if len(points) <= 2:\n        return list(points)\n\n    s1, e1 = points[0]\n    s2, e2 = points[-1]\n    ds = s2 - s1\n\n    max_dev = 0.0\n    max_idx = 0\n    for i in range(1, len(points) - 1):\n        s, e = points[i]\n        if abs(ds) < 1e-10:\n            dev = abs(e - e1)\n        else:\n            t = (s - s1) / ds\n            e_interp = e1 + t * (e2 - e1)\n            dev = abs(e - e_interp)\n        if dev > max_dev:\n            max_dev = dev\n            max_idx = i\n\n    if max_dev > epsilon:\n        left  = douglas_peucker(points[:max_idx + 1], epsilon)\n        right = douglas_peucker(points[max_idx:],     epsilon)\n        return left[:-1] + right\n    return [points[0], points[-1]]\n\n\ndef merge_short_segments(pvis, min_length):\n    \"\"\"Descarta PVIs interiores demasiado pegados a un vecino.\"\"\"\n    if len(pvis) <= 2:\n        return list(pvis)\n    result = [pvis[0]]\n    for i in range(1, len(pvis) - 1):\n        ds_prev = pvis[i][0] - result[-1][0]\n        ds_next = pvis[i + 1][0] - pvis[i][0]\n        if ds_prev >= min_length and ds_next >= min_length:\n            result.append(pvis[i])\n    result.append(pvis[-1])\n    return result\n\n\ndef correct_slopes(pvis, min_s, max_s):\n    \"\"\"Pasada forward: ajusta elevacion de cada PVI para cumplir\n    pendiente en [min_s, max_s].\"\"\"\n    if len(pvis) < 2:\n        return list(pvis)\n    corrected = [pvis[0]]\n    for i in range(1, len(pvis)):\n        s_prev, e_prev = corrected[-1]\n        s_cur,  e_cur  = pvis[i]\n        ds = s_cur - s_prev\n        if ds <= 1e-6:\n            corrected.append((s_cur, e_cur))\n            continue\n        slope = (e_cur - e_prev) / ds\n        abs_s = abs(slope)\n        if abs_s > max_s:\n            sign = 1.0 if slope >= 0 else -1.0\n            corrected.append((s_cur, e_prev + sign * max_s * ds))\n        elif abs_s < min_s:\n            # evitar slope=0 por drenaje: forzamos al minimo\n            sign = 1.0 if slope >= 0 else -1.0\n            if slope == 0.0:\n                sign = 1.0  # ascendente por convencion\n            corrected.append((s_cur, e_prev + sign * min_s * ds))\n        else:\n            corrected.append((s_cur, e_cur))\n    return corrected\n\n\n# ═══════════════════════════════════════════════════════════════════════\n# Main\n# ═══════════════════════════════════════════════════════════════════════\n\ndoc = Application.DocumentManager.MdiActiveDocument\ndb  = doc.Database\n\nlck = None\ntr  = None\n\ntry:\n    lck = doc.LockDocument()\n    tr  = db.TransactionManager.StartTransaction()\n    cdoc = CivilApplication.ActiveDocument\n\n    # -- Superficie TN --\n    surface = find_surface_by_name(cdoc, tr, surface_name)\n    if surface is None:\n        log.append(\"ERROR: superficie '{}' no encontrada\".format(surface_name))\n        tr.Commit()\n    else:\n        log.append(\"Superficie: '{}'\".format(surface_name))\n        log.append(\"Params: h={:.2f}m, pendiente [{:.2f}%, {:.2f}%], \"\n                   \"acuerdo>={:.1f}m, muestreo cada {:.1f}m\"\n                   .format(target_h, min_slope * 100, max_slope * 100,\n                           min_curve_length, sampling_interval))\n\n        style_id = find_profile_style_by_name(\n            cdoc, tr, rasante_style_name, log)\n        if rasante_style_name and style_id.IsNull:\n            log.append(\"Estilo rasante '{}' NO encontrado. Uso el default.\"\n                       .format(rasante_style_name))\n\n        label_set_id = get_profile_label_set_id(cdoc, tr)\n        if label_set_id.IsNull:\n            log.append(\"AVISO: no encuentro ningun Profile Label Set.\")\n\n        layer_id = ensure_layer(tr, db, profile_layer)\n\n        first_iter = True\n        for aname in alignment_names:\n            aname = str(aname)\n            aid, alignment = find_alignment_by_name(cdoc, tr, aname)\n            if aid is None:\n                log.append(\"{}: alignment no encontrado\".format(aname))\n                continue\n\n            try:\n                start_sta = alignment.StartingStation\n                end_sta   = alignment.EndingStation\n\n                # 1. Muestrear TN (diagnostico detallado solo en el 1er eje)\n                tn_samples = sample_tn(alignment, surface,\n                                       start_sta, end_sta, sampling_interval,\n                                       log, diagnose_first=first_iter)\n                first_iter = False\n                if len(tn_samples) < 2:\n                    log.append(\"{}: muestreo TN insuficiente ({} puntos)\"\n                               .format(aname, len(tn_samples)))\n                    continue\n\n                # 2. Desplazar por altura objetivo\n                target_poly = [(s, e + target_h) for s, e in tn_samples]\n\n                # 3. Douglas-Peucker\n                pvis_dp = douglas_peucker(target_poly, dp_tolerance)\n\n                # 4. Fusionar PVIs cercanos\n                pvis_merged = merge_short_segments(pvis_dp, min_pvi_distance)\n\n                # 5. Corregir pendientes\n                pvis_final = correct_slopes(pvis_merged, min_slope, max_slope)\n\n                # 6. Borrar rasante previa con el mismo nombre\n                rasante_name = rasante_prefix + aname\n                try:\n                    prof_ids = alignment.GetProfileIds()\n                    to_erase = []\n                    for pi in range(prof_ids.Count):\n                        try:\n                            pid = prof_ids.get_Item(pi)\n                        except Exception:\n                            try:\n                                pid = prof_ids[pi]\n                            except Exception:\n                                continue\n                        try:\n                            p = tr.GetObject(pid, OpenMode.ForRead)\n                            if get_name_safe(p) == rasante_name:\n                                to_erase.append(pid)\n                        except Exception:\n                            pass\n                    for pid in to_erase:\n                        try:\n                            obj = tr.GetObject(pid, OpenMode.ForWrite)\n                            obj.Erase()\n                        except Exception:\n                            pass\n                except Exception:\n                    pass\n\n                # 7. Crear Profile Layout\n                new_prof_id = Profile.CreateByLayout(\n                    rasante_name, aid, layer_id, style_id, label_set_id)\n\n                if new_prof_id is None or new_prof_id.IsNull:\n                    log.append(\"{}: CreateByLayout devolvio ObjectId nulo\"\n                               .format(aname))\n                    continue\n\n                new_prof = tr.GetObject(new_prof_id, OpenMode.ForWrite)\n\n                # 8. Anyadir PVIs (prueba varias firmas porque varian\n                #    entre versiones de Civil 3D)\n                n_pvi_ok = 0\n                first_pvi_method = None\n                first_pvi_err = None\n                for s, e in pvis_final:\n                    added = False\n\n                    # Firma 1: AddPVI(double station, double elevation)\n                    if not added:\n                        try:\n                            new_prof.PVIs.AddPVI(float(s), float(e))\n                            added = True\n                            if first_pvi_method is None:\n                                first_pvi_method = \"AddPVI(sta, elev)\"\n                        except Exception as ex1:\n                            if first_pvi_err is None:\n                                first_pvi_err = \"sig1: \" + str(ex1)[:80]\n\n                    # Firma 2: AddPVI(Point2d)\n                    if not added:\n                        try:\n                            new_prof.PVIs.AddPVI(Point2d(float(s), float(e)))\n                            added = True\n                            if first_pvi_method is None:\n                                first_pvi_method = \"AddPVI(Point2d)\"\n                        except Exception as ex2:\n                            if first_pvi_err is None:\n                                first_pvi_err = (first_pvi_err or \"\") \\\n                                    + \" | sig2: \" + str(ex2)[:80]\n\n                    if added:\n                        n_pvi_ok += 1\n                    else:\n                        log.append(\"{}: PVI @sta {:.2f} fallo ({})\"\n                                   .format(aname, s, first_pvi_err))\n\n                if first_pvi_method and n_pvi_ok > 0:\n                    log.append(\"{}: PVIs con firma {} (total {}/{})\"\n                               .format(aname, first_pvi_method,\n                                       n_pvi_ok, len(pvis_final)))\n\n                # 9. Anyadir acuerdos: USO \"AddFreeSymmetricParabolaByPVIAndCurveLength\"\n                #    (el metodo \"por PVI\") porque tiene 2 params claros (PVI, double)\n                #    y corresponde al boton \"Free Vertical Curve (Parabola)\" del\n                #    menu de Civil 3D.\n                n_curves = 0\n                curve_errors = []\n                try:\n                    entities = new_prof.Entities\n                    n_ent = entities.Count\n\n                    # Diagnostico (solo primer eje): firmas COMPLETAS de\n                    # todos los metodos AddFreeSymmetric*\n                    if first_iter:\n                        try:\n                            ct = clr.GetClrType(entities.GetType())\n                            for m in ct.GetMethods():\n                                if (m.Name.startswith(\"AddFree\")\n                                        and \"Parabola\" in m.Name):\n                                    params_str = \", \".join(\n                                        \"{} {}\".format(\n                                            p.ParameterType.Name, p.Name)\n                                        for p in m.GetParameters())\n                                    log.append(\"  {}({})\".format(\n                                        m.Name, params_str))\n                        except Exception as ex_r:\n                            log.append(\"  Reflection error: \"\n                                       + str(ex_r)[:150])\n\n                    # Iterar PVIs interiores (sin el 1o ni el ultimo)\n                    pvi_coll = new_prof.PVIs\n                    n_pvi = pvi_coll.Count\n                    log.append(\"{}: PVI count en profile = {}\"\n                               .format(aname, n_pvi))\n\n                    for pi in range(1, n_pvi - 1):\n                        try:\n                            pvi = pvi_coll.get_Item(pi)\n                        except Exception:\n                            try:\n                                pvi = pvi_coll[pi]\n                            except Exception as ex_g:\n                                curve_errors.append(\n                                    \"PVI[{}] acceso: {}\".format(\n                                        pi, str(ex_g)[:100]))\n                                continue\n                        try:\n                            entities.AddFreeSymmetricParabolaByPVIAndCurveLength(\n                                pvi, float(min_curve_length))\n                            n_curves += 1\n                        except Exception as ex_c:\n                            if len(curve_errors) < 3:\n                                curve_errors.append(\n                                    \"PVI[{}] AddCurve: {}\".format(\n                                        pi, str(ex_c)[:300]))\n                except Exception as ex_cv:\n                    log.append(\"{}: error general acuerdos: {}\"\n                               .format(aname, str(ex_cv)[:200]))\n\n                # Loguear resultado\n                n_expected = max(0, len(pvis_final) - 2)\n                log.append(\"{}: acuerdos OK={}/{} esperados\"\n                           .format(aname, n_curves, n_expected))\n                if curve_errors:\n                    for ce in curve_errors:\n                        log.append(\"  {}: {}\".format(aname, ce))\n\n                rasantes_created.append(\n                    \"{}: {} PVIs, {} acuerdos (muestras TN={}, DP={})\"\n                    .format(rasante_name, n_pvi_ok, n_curves,\n                            len(tn_samples), len(pvis_dp)))\n\n            except Exception as ex:\n                log.append(\"{}: fallo generar rasante: {}\"\n                           .format(aname, str(ex)))\n\n        log.append(\"Rasantes creadas: {}\".format(len(rasantes_created)))\n        tr.Commit()\n\nexcept Exception:\n    log.append(\"ERROR GLOBAL: \" + traceback.format_exc())\n    try:\n        if tr: tr.Abort()\n    except Exception:\n        pass\nfinally:\n    try:\n        if tr: tr.Dispose()\n    except Exception:\n        pass\n    try:\n        if lck: lck.Dispose()\n    except Exception:\n        pass\n\n\nOUT = [rasantes_created, log]\n",
      "Engine": "CPython3",
