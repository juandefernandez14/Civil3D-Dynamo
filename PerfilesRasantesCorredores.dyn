      "InputValue": "ANCHO 4m T1"
    },
    {
      "ConcreteType": "CoreNodeModels.Input.StringInput, CoreNodeModels",
      "Id": "6de0aabf930b465494a294c5c6903448",
      "NodeType": "StringInputNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "156be6fee8774c7b9e83b453e2ef24d7",
          "Name": "",
          "Description": "String",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Creates a string",
      "InputValue": "RAS"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\n# =============================================================================\n# Create_Corridors (integrado en Rasante_y_Corredores.dyn)\n# Civil 3D 2024 / Dynamo / CPython3\n#\n# IN[0] : str   nombre del assembly\n# IN[1] : str   nombre de la superficie MDT (target)\n# IN[2] : str   prefijo rasante (ej. \"RAS\")\n# IN[3] : any   SYNC BARRIER (output del Paso 3) - no se usa, solo fuerza orden\n# =============================================================================\n\nimport clr\nimport traceback\n\nclr.AddReference('AcMgd')\nclr.AddReference('AcCoreMgd')\nclr.AddReference('AcDbMgd')\nclr.AddReference('AecBaseMgd')\nclr.AddReference('AeccDbMgd')\n\nfrom Autodesk.AutoCAD.ApplicationServices import Application as AcadApp\nfrom Autodesk.AutoCAD.DatabaseServices import (\n    OpenMode, ObjectIdCollection, SymbolUtilityServices, ObjectId\n)\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import (\n    Alignment, Profile, Corridor, Assembly\n)\nfrom System import Enum\nfrom System.Reflection import BindingFlags\nfrom System import AppDomain\n\nCORRIDOR_STYLE_NAME     = \"Not display\"\nCODE_SET_STYLE_NAME     = \"Plan View - Solid Hatch (Lynka)\"\nSURFACE_STYLE_NAME      = \"_No Display\"\nTOP_PREFIX              = \"TOP \"\nDATUM_PREFIX            = \"DATUM \"\nTOP_CODE                = \"Top\"\nDATUM_CODE              = \"Datum\"\nBOUNDARY_NAME           = \"Corridor Boundary(1)\"\nTARGET_SUBASM_PREFIXES  = (\"C1 -\", \"F1 -\", \"C1-\", \"F1-\")\n\nlog = []\ndef say(m): log.append(str(m))\n\nassembly_name = str(IN[0]).strip()\nmdt_name      = str(IN[1]).strip()\nras_prefix    = str(IN[2]).strip()\n# IN[3] es el sync barrier desde Paso 3 (ignorado)\n\nsay(\"=== CREAR CORREDORES ===\")\nsay(\"Assembly: '{}'\".format(assembly_name))\nsay(\"MDT target: '{}'\".format(mdt_name))\nsay(\"Prefijo rasante: '{}'\".format(ras_prefix))\nsay(\"\")\n\ndoc = AcadApp.DocumentManager.MdiActiveDocument\ndb  = doc.Database\n\ndef safe_name(obj):\n    try: return obj.Name\n    except: pass\n    try: return obj.get_Name()\n    except: pass\n    return None\n\ndef find_type_by_name(simple_name):\n    for asm in AppDomain.CurrentDomain.GetAssemblies():\n        try:\n            for t in asm.GetExportedTypes():\n                if t.Name == simple_name:\n                    return t\n        except: continue\n    return None\n\ndef find_style_id_in_collection(tr_local, coll, target_name):\n    try:\n        for sid in coll:\n            try:\n                s = tr_local.GetObject(sid, OpenMode.ForRead)\n                nm = safe_name(s)\n                if nm and nm.strip() == target_name:\n                    return sid\n            except: continue\n    except: pass\n    try:\n        for i in range(coll.Count):\n            sid = coll.get_Item(i) if hasattr(coll, 'get_Item') else coll[i]\n            try:\n                s = tr_local.GetObject(sid, OpenMode.ForRead)\n                nm = safe_name(s)\n                if nm and nm.strip() == target_name:\n                    return sid\n            except: continue\n    except: pass\n    return None\n\ndef get_subasm_name(ti):\n    for attr in (\"SubassemblyName\", \"SubAssemblyName\",\n                 \"SubassemblyLogicalName\", \"AssemblyGroupName\"):\n        if hasattr(ti, attr):\n            try:\n                v = getattr(ti, attr)\n                if v is not None:\n                    return str(v)\n            except: continue\n    return \"\"\n\ndef starts_with_any(name, prefixes):\n    n_lower = name.lower().strip()\n    for p in prefixes:\n        if n_lower.startswith(p.lower()):\n            return True\n    return False\n\noc_type   = find_type_by_name(\"OverhangCorrectionType\")\ncsbt_type = find_type_by_name(\"CorridorSurfaceBoundaryType\")\noc_top_links = None\noc_bottom_links = None\ncsbt_outside = None\nif oc_type is not None:\n    try: oc_top_links = Enum.Parse(oc_type, \"TopLinks\")\n    except: pass\n    try: oc_bottom_links = Enum.Parse(oc_type, \"BottomLinks\")\n    except: pass\nif csbt_type is not None:\n    for cand in (\"OutsideBoundary\", \"Outside\", \"Outer\"):\n        try:\n            csbt_outside = Enum.Parse(csbt_type, cand)\n            break\n        except: continue\n\nn_created = 0\nn_skipped = 0\nn_errors  = 0\n\ndoc_lock = doc.LockDocument()\ntry:\n    tr = db.TransactionManager.StartTransaction()\n    try:\n        civDoc = CivilApplication.ActiveDocument\n\n        mdt_surf_id = None\n        for sid in civDoc.GetSurfaceIds():\n            s = tr.GetObject(sid, OpenMode.ForRead)\n            if safe_name(s) == mdt_name:\n                mdt_surf_id = sid\n                break\n        if mdt_surf_id is None:\n            raise Exception(\"Superficie '{}' no encontrada.\".format(mdt_name))\n        say(\"MDT: OK\")\n\n        assembly_id = None\n        bt = tr.GetObject(db.BlockTableId, OpenMode.ForRead)\n        ms_id = SymbolUtilityServices.GetBlockModelSpaceId(db)\n        btr = tr.GetObject(ms_id, OpenMode.ForRead)\n        for oid in btr:\n            try:\n                obj = tr.GetObject(oid, OpenMode.ForRead)\n                if isinstance(obj, Assembly):\n                    if safe_name(obj) == assembly_name:\n                        assembly_id = oid\n                        break\n            except: continue\n        if assembly_id is None:\n            raise Exception(\"Assembly '{}' no encontrado.\".format(assembly_name))\n        say(\"Assembly: OK\")\n\n        surface_style_id = ObjectId.Null\n        try:\n            surf_styles = civDoc.Styles.SurfaceStyles\n            surface_style_id = find_style_id_in_collection(\n                tr, surf_styles, SURFACE_STYLE_NAME)\n            if surface_style_id is None or surface_style_id == ObjectId.Null:\n                say(\"AVISO: SurfaceStyle '{}' no encontrado\".format(SURFACE_STYLE_NAME))\n                surface_style_id = ObjectId.Null\n        except Exception as ex:\n            say(\"AVISO SurfaceStyles: {}\".format(str(ex)[:150]))\n\n        say(\"\")\n        corr_coll = civDoc.CorridorCollection\n        align_ids = civDoc.GetAlignmentIds()\n        say(\"Alignments en dibujo: {}\".format(align_ids.Count))\n        say(\"\")\n\n        for aidx in range(align_ids.Count):\n            a_id = align_ids.get_Item(aidx)\n            al = tr.GetObject(a_id, OpenMode.ForRead)\n            align_name = safe_name(al)\n            if align_name is None:\n                n_skipped += 1\n                continue\n\n            rasante_id = None\n            rasante_name = None\n            prof_ids = al.GetProfileIds()\n            pfx_lower = ras_prefix.lower()\n            all_profiles = []\n            for pidx in range(prof_ids.Count):\n                p_id = prof_ids.get_Item(pidx)\n                prof = tr.GetObject(p_id, OpenMode.ForRead)\n                pname = safe_name(prof)\n                if pname: all_profiles.append(pname)\n                if pname and pname.strip().lower().startswith(pfx_lower):\n                    rasante_id = p_id\n                    rasante_name = pname\n                    break\n            if rasante_id is None:\n                n_skipped += 1\n                say(\"[SKIP] '{}': sin rasante. Perfiles: {}\".format(\n                    align_name, all_profiles))\n                continue\n\n            start_sta = al.StartingStation\n            end_sta   = al.EndingStation\n            corr_name = align_name\n\n            try:\n                for i in range(corr_coll.Count):\n                    existing_id = corr_coll.get_Item(i)\n                    try:\n                        ec = tr.GetObject(existing_id, OpenMode.ForRead)\n                        if safe_name(ec) == corr_name:\n                            ec.UpgradeOpen()\n                            ec.Erase()\n                            break\n                    except: continue\n            except: pass\n\n            try:\n                new_corr_id = corr_coll.Add(corr_name)\n                corridor = tr.GetObject(new_corr_id, OpenMode.ForWrite)\n\n                try: corridor.StyleName = CORRIDOR_STYLE_NAME\n                except: pass\n                try: corridor.CodeSetStyleName = CODE_SET_STYLE_NAME\n                except: pass\n\n                bl_name = \"BL_\" + align_name\n                if len(bl_name) > 80: bl_name = bl_name[:80]\n                baseline = corridor.Baselines.Add(bl_name, a_id, rasante_id)\n\n                region = baseline.BaselineRegions.Add(\n                    \"Region_1\", assembly_id, start_sta, end_sta)\n\n                # Frecuencia default de UI Civil 3D 2024\n                try:\n                    aas = region.AppliedAssemblySetting\n                    aas.FrequencyAlongTangents                = 10.0\n                    aas.FrequencyAlongCurves                  = 2.0\n                    aas.FrequencyAlongSpirals                 = 10.0\n                    aas.MODAlongCurves                        = 0.1\n                    aas.AppliedAtHorizontalGeometryPoints     = True\n                    aas.AppliedAtSuperelevationCriticalPoints = True\n                    aas.FrequencyAlongProfileCurves           = 5.0\n                    aas.AppliedAtProfileGeometryPoints        = True\n                    aas.AppliedAtProfileHighLowPoints         = True\n                    aas.AppliedAtOffsetTargetGeometryPoints   = True\n                    aas.AppliedAdjacentToOffsetTargetStartEnd = True\n                except Exception as ex_freq:\n                    if n_created == 0:\n                        say(\"  AVISO freq: {}\".format(str(ex_freq)[:150]))\n\n                # Targets: MDT solo en C1-/F1- con TargetType==1 (Surface)\n                try:\n                    tgts = region.GetTargets()\n                    changed = False\n                    first_log = (n_created == 0)\n                    n_assigned = 0\n\n                    for ti_idx in range(tgts.Count):\n                        ti = tgts.get_Item(ti_idx)\n                        sub_name = get_subasm_name(ti)\n                        if not starts_with_any(sub_name, TARGET_SUBASM_PREFIXES):\n                            continue\n                        try: tt_int = int(ti.TargetType)\n                        except: continue\n                        if tt_int != 1:\n                            continue\n                        ids = ObjectIdCollection()\n                        ids.Add(mdt_surf_id)\n                        try:\n                            ti.TargetIds = ids\n                            changed = True\n                            n_assigned += 1\n                        except Exception as ex_set:\n                            if first_log:\n                                say(\"  TargetIds fail '{}': {}\".format(\n                                    sub_name, str(ex_set)[:80]))\n\n                    if first_log:\n                        say(\"  Targets MDT asignados: {}\".format(n_assigned))\n                    if changed:\n                        region.SetTargets(tgts)\n                except Exception as ex_tgt:\n                    if n_created == 0:\n                        say(\"  AVISO targets: {}\".format(str(ex_tgt)[:120]))\n\n                try: corridor.Rebuild()\n                except Exception as ex_rb:\n                    say(\"  AVISO Rebuild-1 '{}': {}\".format(corr_name, str(ex_rb)[:100]))\n\n                top_surf_name   = TOP_PREFIX   + align_name\n                datum_surf_name = DATUM_PREFIX + align_name\n                try: corridor.CorridorSurfaces.Remove(top_surf_name)\n                except: pass\n                try: corridor.CorridorSurfaces.Remove(datum_surf_name)\n                except: pass\n\n                top_surf = corridor.CorridorSurfaces.Add(top_surf_name)\n                if surface_style_id is not None and surface_style_id != ObjectId.Null:\n                    try: top_surf.SurfaceStyleId = surface_style_id\n                    except: pass\n                added_top = False\n                for code_variant in (TOP_CODE, TOP_CODE.lower(), TOP_CODE.upper()):\n                    try:\n                        top_surf.AddLinkCode(code_variant, False)\n                        added_top = True\n                        break\n                    except: continue\n                if oc_top_links is not None:\n                    try: top_surf.OverhangCorrection = oc_top_links\n                    except: pass\n\n                datum_surf = corridor.CorridorSurfaces.Add(datum_surf_name)\n                if surface_style_id is not None and surface_style_id != ObjectId.Null:\n                    try: datum_surf.SurfaceStyleId = surface_style_id\n                    except: pass\n                added_datum = False\n                for code_variant in (DATUM_CODE, DATUM_CODE.lower(), DATUM_CODE.upper()):\n                    try:\n                        datum_surf.AddLinkCode(code_variant, False)\n                        added_datum = True\n                        break\n                    except: continue\n                if oc_bottom_links is not None:\n                    try: datum_surf.OverhangCorrection = oc_bottom_links\n                    except: pass\n\n                try: corridor.Rebuild()\n                except: pass\n\n                try:\n                    top_bnd = top_surf.Boundaries.AddCorridorExtentsBoundary(BOUNDARY_NAME)\n                    if csbt_outside is not None:\n                        try: top_bnd.BoundaryType = csbt_outside\n                        except: pass\n                except Exception as ex_b1:\n                    say(\"  AVISO TOP boundary: {}\".format(str(ex_b1)[:120]))\n                try:\n                    datum_bnd = datum_surf.Boundaries.AddCorridorExtentsBoundary(BOUNDARY_NAME)\n                    if csbt_outside is not None:\n                        try: datum_bnd.BoundaryType = csbt_outside\n                        except: pass\n                except Exception as ex_b2:\n                    say(\"  AVISO DATUM boundary: {}\".format(str(ex_b2)[:120]))\n\n                try: corridor.Rebuild()\n                except: pass\n\n                n_created += 1\n                status = \"TOP:{} DATUM:{}\".format(\n                    \"OK\" if added_top else \"FAIL\",\n                    \"OK\" if added_datum else \"FAIL\")\n                say(\"[OK] '{}' | rasante '{}' | {:.1f}-{:.1f} | {}\".format(\n                    corr_name, rasante_name, start_sta, end_sta, status))\n\n            except Exception as ex:\n                n_errors += 1\n                say(\"[ERROR] '{}': {}\".format(align_name, str(ex)[:200]))\n                if n_errors <= 2:\n                    for line in traceback.format_exc().split(\"\\n\")[:6]:\n                        say(\"    \" + line)\n\n        tr.Commit()\n    finally:\n        tr.Dispose()\nfinally:\n    doc_lock.Dispose()\n\nsay(\"\")\nsay(\"=== RESUMEN CORREDORES ===\")\nsay(\"Corredores creados: {}\".format(n_created))\nsay(\"Skipped (sin rasante): {}\".format(n_skipped))\nsay(\"Errores: {}\".format(n_errors))\n\nOUT = log\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "01178e4f4c944450931421aa309d3900",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "58aa7d58d99d4c67a122abe6e050cd27",
          "Name": "IN[0]",
          "Description": "",
          "UsingDefaultValue": false,
