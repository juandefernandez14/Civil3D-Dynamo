    {
      "ConcreteType": "CoreNodeModels.Input.StringInput, CoreNodeModels",
      "Id": "a1000000000000000000000000000010",
      "NodeType": "StringInputNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "a2000000000000000000000000000010",
          "Name": "",
          "Description": "String",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Creates a string",
      "InputValue": "Estilo de diseño (Lynka)"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\n# =============================================================================\n# Rasante_Viales_Parte1.dyn - Representar ejes existentes con TN\n#\n# Los alignments ya estan creados en el dibujo. Este nodo:\n#   1. Busca todos los alignments cuya capa coincida con la indicada\n#   2. Para cada uno, crea (o regenera) un perfil TN muestreando la superficie\n#   3. El perfil se llama \"TN_<nombre_del_alignment>\"\n#\n# Si al re-ejecutar ya existe un perfil con ese nombre, lo borra antes de\n# crear el nuevo (idempotente).\n#\n# ENTRADAS:\n#   IN[0] : str  Capa de los ejes (e.g. \"EJES\"). Vacio = todos los alignments\n#   IN[1] : str  Nombre de la superficie TN (MDT)\n#   IN[2] : str  Nombre del estilo de perfil TN (e.g. \"Existing Ground (Lynka)\")\n#\n# SALIDA (lista de 3 elementos):\n#   [0] list[str]  nombres de los alignments procesados\n#   [1] list[str]  nombres de los perfiles TN creados\n#   [2] list[str]  log / diagnostico\n# =============================================================================\n\nimport clr\nimport traceback\n\nclr.AddReference(\"AcMgd\")\nclr.AddReference(\"AcDbMgd\")\nclr.AddReference(\"AcCoreMgd\")\nclr.AddReference(\"AeccDbMgd\")\n\nfrom System import String as SysString\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import (\n    OpenMode, ObjectId, LayerTableRecord\n)\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import Profile\n\nlayer_name    = str(IN[0]) if IN[0] else \"\"\nsurface_name  = str(IN[1]) if IN[1] else \"\"\ntn_style_name = str(IN[2]) if IN[2] else \"\"\ntn_prefix     = \"TN_\"\nprofile_layer = \"0\"          # capa por defecto para el perfil\n\nlog = []\nalignments_found  = []\nprofiles_created  = []\n\n\ndef get_name_safe(obj):\n    try:\n        return obj.Name\n    except Exception:\n        return None\n\n\ndef ensure_layer(tr, db, name):\n    \"\"\"Busca/crea la capa indicada y devuelve su ObjectId.\"\"\"\n    lt = tr.GetObject(db.LayerTableId, OpenMode.ForRead)\n    try:\n        if lt.Has(name):\n            return lt.get_Item(name)\n    except Exception:\n        pass\n    try:\n        lt.UpgradeOpen()\n        ltr = LayerTableRecord()\n        ltr.Name = name\n        lid = lt.Add(ltr)\n        tr.AddNewlyCreatedDBObject(ltr, True)\n        return lid\n    except Exception:\n        try:\n            return lt.get_Item(\"0\")\n        except Exception:\n            return ObjectId.Null\n\n\ndef find_surface_by_name(cdoc, tr, name):\n    \"\"\"Busca una superficie por nombre exacto. Devuelve el objeto Surface o None.\"\"\"\n    try:\n        sids = cdoc.GetSurfaceIds()\n        for i in range(sids.Count):\n            try:\n                sid = sids.get_Item(i)\n            except Exception:\n                try:\n                    sid = sids[i]\n                except Exception:\n                    continue\n            try:\n                surf = tr.GetObject(sid, OpenMode.ForRead)\n                if get_name_safe(surf) == name:\n                    return surf\n            except Exception:\n                pass\n    except Exception:\n        pass\n    return None\n\n\ndef default_style_id(styles_col):\n    try:\n        if styles_col.Count > 0:\n            try:\n                return styles_col.get_Item(0)\n            except Exception:\n                return styles_col[0]\n    except Exception:\n        pass\n    return ObjectId.Null\n\n\ndef get_profile_label_set_id(cdoc, tr):\n    \"\"\"Devuelve un ObjectId valido de ProfileLabelSetStyle. Civil 3D NO\n    acepta ObjectId.Null para este parametro al crear un Profile, asi que\n    siempre hay que darle uno. Preferimos uno con nombre estandar; si no,\n    el primero disponible por indice.\"\"\"\n    try:\n        coll = cdoc.Styles.LabelSetStyles.ProfileLabelSetStyles\n    except Exception:\n        return ObjectId.Null\n\n    # Nombres tipicos de label sets \"vacios\" en plantillas Civil 3D\n    for candidate in (\"_No Labels\", \"No Labels\", \"_Sin etiquetas\", \"Standard\"):\n        # Metodo 1: get_Item(string)\n        try:\n            oid = coll.get_Item(candidate)\n            if oid is not None and not oid.IsNull:\n                return oid\n        except Exception:\n            pass\n        # Metodo 2: indexer corchetes\n        try:\n            oid = coll[candidate]\n            if oid is not None and not oid.IsNull:\n                return oid\n        except Exception:\n            pass\n\n    # Fallback: primer item por indice\n    try:\n        oid = coll.get_Item(0)\n        if oid is not None and not oid.IsNull:\n            return oid\n    except Exception:\n        pass\n\n    # Fallback: iterar y tomar el primero\n    try:\n        for oid in coll:\n            if oid is not None and not oid.IsNull:\n                return oid\n    except Exception:\n        pass\n\n    return ObjectId.Null\n\n\ndef find_profile_style_by_name(cdoc, tr, name, log):\n    \"\"\"Busca un estilo de Profile por nombre. Usa los 4 metodos en cascada\n    (get_Item string, indexer, reflection, iter) para evitar el bug de\n    pythonnet que impide leer .Name en objetos Style de Civil 3D.\"\"\"\n    if not name:\n        return ObjectId.Null\n\n    wanted = name.strip()\n    try:\n        coll = cdoc.Styles.ProfileStyles\n    except Exception:\n        return ObjectId.Null\n\n    # Metodo 1: get_Item(string) - indexer .NET con clave string\n    try:\n        sid = coll.get_Item(wanted)\n        if sid is not None and not sid.IsNull:\n            log.append(\"Estilo perfil TN encontrado (get_Item): '{}'\"\n                       .format(wanted))\n            return sid\n    except Exception:\n        pass\n\n    # Metodo 2: indexer Python con corchetes\n    try:\n        sid = coll[wanted]\n        if sid is not None and not sid.IsNull:\n            log.append(\"Estilo perfil TN encontrado (indexer): '{}'\"\n                       .format(wanted))\n            return sid\n    except Exception:\n        pass\n\n    # Metodo 3: reflexion explicita\n    try:\n        ct = clr.GetClrType(coll.GetType())\n        gi = ct.GetMethod(\"get_Item\", [clr.GetClrType(SysString)])\n        if gi is not None:\n            sid = gi.Invoke(coll, [wanted])\n            if sid is not None and not sid.IsNull:\n                log.append(\"Estilo perfil TN encontrado (reflection): '{}'\"\n                           .format(wanted))\n                return sid\n    except Exception:\n        pass\n\n    # Metodo 4: iterar (bare except por el bug de .Name)\n    try:\n        for stid in coll:\n            try:\n                st = tr.GetObject(stid, OpenMode.ForRead)\n                try:\n                    nm = st.Name\n                    if nm and nm.strip().lower() == wanted.lower():\n                        log.append(\"Estilo perfil TN encontrado (iter): '{}'\"\n                                   .format(nm))\n                        return stid\n                except:\n                    pass\n            except Exception:\n                pass\n    except Exception:\n        pass\n\n    return ObjectId.Null\n\n\n# ═══════════════════════════════════════════════════════════════════════\n# Proceso\n# ═══════════════════════════════════════════════════════════════════════\n\ndoc = Application.DocumentManager.MdiActiveDocument\ndb  = doc.Database\n\nlck = None\ntr  = None\n\ntry:\n    lck = doc.LockDocument()\n    tr  = db.TransactionManager.StartTransaction()\n\n    cdoc = CivilApplication.ActiveDocument\n\n    # ── Encontrar superficie ──────────────────────────────────────\n    surface = find_surface_by_name(cdoc, tr, surface_name)\n    if surface is None:\n        log.append(\"ERROR: Superficie '{}' no encontrada\".format(surface_name))\n        # Listar superficies disponibles para diagnostico\n        try:\n            sids = cdoc.GetSurfaceIds()\n            names = []\n            for i in range(sids.Count):\n                try:\n                    sid = sids.get_Item(i)\n                    s = tr.GetObject(sid, OpenMode.ForRead)\n                    nm = get_name_safe(s)\n                    if nm: names.append(nm)\n                except Exception:\n                    pass\n            log.append(\"Superficies disponibles: \" + str(names))\n        except Exception:\n            pass\n        OUT = [[], [], log]\n    else:\n        log.append(\"Superficie encontrada: '{}'\".format(surface_name))\n\n        # ── Preparar estilo perfil TN y label set ────────────────\n        prof_style_id = find_profile_style_by_name(cdoc, tr, tn_style_name, log)\n        if tn_style_name and prof_style_id.IsNull:\n            log.append(\"Estilo perfil TN '{}' NO encontrado. \"\n                       \"Se usara el default del dibujo.\".format(tn_style_name))\n\n        # Label set: Civil 3D NO acepta null para este parametro.\n        # Usamos uno estandar o el primero disponible.\n        label_set_id = get_profile_label_set_id(cdoc, tr)\n        if label_set_id.IsNull:\n            log.append(\"AVISO: No se encontro ningun Profile Label Set.\")\n\n        layer_id = ensure_layer(tr, db, profile_layer)\n\n        # ── Encontrar alignments en la capa ───────────────────────\n        align_ids = cdoc.GetAlignmentIds()\n        matching = []\n        for i in range(align_ids.Count):\n            try:\n                aid = align_ids.get_Item(i)\n            except Exception:\n                try:\n                    aid = align_ids[i]\n                except Exception:\n                    continue\n            try:\n                a = tr.GetObject(aid, OpenMode.ForRead)\n                a_layer = getattr(a, \"Layer\", None)\n                a_name  = get_name_safe(a) or \"Align_?\"\n                if layer_name == \"\" or a_layer == layer_name:\n                    matching.append((a_name, aid, a))\n            except Exception:\n                pass\n\n        matching.sort(key=lambda x: x[0])\n        log.append(\"Alignments en capa '{}': {} ({})\".format(\n            layer_name, len(matching),\n            \", \".join(a[0] for a in matching)))\n\n        # ── Para cada alignment: borrar TN previo y crear nuevo ───\n        for aname, aid, a in matching:\n            alignments_found.append(aname)\n            tn_name = tn_prefix + aname\n\n            # Borrar perfil con ese nombre (re-ejecucion limpia)\n            try:\n                prof_ids = a.GetProfileIds()\n                for pi in range(prof_ids.Count):\n                    try:\n                        pid = prof_ids.get_Item(pi)\n                    except Exception:\n                        try:\n                            pid = prof_ids[pi]\n                        except Exception:\n                            continue\n                    try:\n                        p = tr.GetObject(pid, OpenMode.ForRead)\n                        if get_name_safe(p) == tn_name:\n                            p.UpgradeOpen()\n                            p.Erase()\n                    except Exception:\n                        pass\n            except Exception:\n                pass\n\n            # Crear nuevo perfil TN\n            try:\n                new_pid = Profile.CreateFromSurface(\n                    tn_name,\n                    aid,\n                    surface.ObjectId,\n                    layer_id,\n                    prof_style_id,\n                    label_set_id\n                )\n                if new_pid and not new_pid.IsNull:\n                    profiles_created.append(tn_name)\n            except Exception as ex:\n                log.append(\"{}: fallo creando perfil TN: {}\".format(\n                    aname, str(ex)))\n\n        log.append(\"Perfiles TN creados: {}\".format(len(profiles_created)))\n        OUT = [alignments_found, profiles_created, log]\n\n    tr.Commit()\n\nexcept Exception:\n    log.append(\"ERROR GLOBAL: \" + traceback.format_exc())\n    try:\n        if tr: tr.Abort()\n    except Exception:\n        pass\n    OUT = [alignments_found, profiles_created, log]\nfinally:\n    try:\n        if tr: tr.Dispose()\n    except Exception:\n        pass\n    try:\n        if lck: lck.Dispose()\n    except Exception:\n        pass\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "b1000000000000000000000000000001",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "b1100000000000000000000000000001",
          "Name": "IN[0]",
          "Description": "",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "b1100001000000000000000000000001",
          "Name": "IN[1]",
          "Description": "",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "b1100002000000000000000000000001",
          "Name": "IN[2]",
          "Description": "",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "b2000000000000000000000000000001",
          "Name": "",
          "Description": "",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\n# =============================================================================\n# Rasante_Viales - Paso 2: ProfileViews en rejilla (con estilo configurable)\n#\n# Toma la lista de nombres de alignments del Paso 1 (sync + evita re-scan) y\n# crea una ProfileView por cada uno, distribuidas en rejilla. Aplica el\n# estilo ProfileView indicado.\n#\n# Una vez creada la PV, Civil 3D incluye automaticamente todos los perfiles\n# del alignment (incluido TN_<aname> creado en Paso 1).\n#\n# ENTRADAS:\n#   IN[0] : list[str]  nombres alignments (output del Paso 1, barrera sync)\n#   IN[1] : float      Origen X\n#   IN[2] : float      Origen Y\n#   IN[3] : float      Numero de columnas\n#   IN[4] : float      Espaciado X (m, positivo hacia derecha)\n#   IN[5] : float      Espaciado Y (m, positivo hacia arriba, negativo hacia abajo)\n#   IN[6] : str        Nombre del estilo ProfileView\n#\n# SALIDA (lista de 2):\n#   [0] list[str]  ProfileViews creadas con su coordenada\n#   [1] list[str]  log / diagnostico\n# =============================================================================\n\nimport clr\nimport traceback\n\nclr.AddReference(\"AcMgd\")\nclr.AddReference(\"AcDbMgd\")\nclr.AddReference(\"AcCoreMgd\")\nclr.AddReference(\"AeccDbMgd\")\n\nfrom System import String as SysString\nfrom Autodesk.AutoCAD.ApplicationServices import Application\nfrom Autodesk.AutoCAD.DatabaseServices import OpenMode, ObjectId\nfrom Autodesk.AutoCAD.Geometry import Point3d\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import ProfileView\n\nalignment_names = IN[0] if IN[0] is not None else []\nif not isinstance(alignment_names, list):\n    alignment_names = [alignment_names]\n\norigin_x       = float(IN[1])\norigin_y       = float(IN[2])\nn_cols         = int(float(IN[3]))\nspacing_x      = float(IN[4])\nspacing_y      = float(IN[5])\npv_style_name  = str(IN[6]) if IN[6] else \"\"\nbandset_name   = str(IN[7]) if IN[7] else \"\"\n\nif n_cols < 1:\n    n_cols = 1\n\n# Sin prefijo: la PV se llama igual que el eje (CI01, CI02...)\npv_prefix = \"\"\nlog = []\npvs_created = []\npv_handles = []   # list de \"name|handle\" para pasar a Paso 3\n\n\ndef get_name_safe(obj):\n    try:\n        return obj.Name\n    except Exception:\n        return None\n\n\ndef find_alignment_by_name(cdoc, tr, name):\n    try:\n        align_ids = cdoc.GetAlignmentIds()\n        for i in range(align_ids.Count):\n            try:\n                aid = align_ids.get_Item(i)\n            except Exception:\n                try:\n                    aid = align_ids[i]\n                except Exception:\n                    continue\n            try:\n                a = tr.GetObject(aid, OpenMode.ForRead)\n                if get_name_safe(a) == name:\n                    return aid, a\n            except Exception:\n                pass\n    except Exception:\n        pass\n    return None, None\n\n\ndef find_pv_style_by_name(cdoc, tr, name, log):\n    \"\"\"Busca un estilo PV por nombre. Replica la estrategia del script de\n    trackers, que evita el bug de pythonnet al leer .Name de objetos Style.\n    Prueba 4 metodos en cascada.\n    \"\"\"\n    if not name:\n        return ObjectId.Null\n\n    wanted = name.strip()\n    style_id = ObjectId.Null\n\n    # Metodo 1: get_Item(string) en la coleccion (indexer .NET directo).\n    # La coleccion mantiene un mapping interno nombre->ObjectId sin leer .Name.\n    try:\n        coll = cdoc.Styles.ProfileViewStyles\n        try:\n            style_id = coll.get_Item(wanted)\n            if style_id is not None and not style_id.IsNull:\n                log.append(\"Estilo PV encontrado (get_Item): '{}'\".format(wanted))\n                return style_id\n        except Exception:\n            pass\n    except Exception:\n        pass\n\n    # Metodo 2: indexer con corchetes al estilo Python (this[string])\n    try:\n        coll = cdoc.Styles.ProfileViewStyles\n        style_id = coll[wanted]\n        if style_id is not None and not style_id.IsNull:\n            log.append(\"Estilo PV encontrado (indexer): '{}'\".format(wanted))\n            return style_id\n    except Exception:\n        pass\n\n    # Metodo 3: reflexion para invocar get_Item(String) explicitamente\n    try:\n        coll = cdoc.Styles.ProfileViewStyles\n        ct = clr.GetClrType(coll.GetType())\n        gi = ct.GetMethod(\"get_Item\", [clr.GetClrType(SysString)])\n        if gi is not None:\n            style_id = gi.Invoke(coll, [wanted])\n            if style_id is not None and not style_id.IsNull:\n                log.append(\"Estilo PV encontrado (reflection): '{}'\"\n                           .format(wanted))\n                return style_id\n    except Exception:\n        pass\n\n    # Metodo 4: iterar con bare except (pythonnet tiene bug con .Name)\n    try:\n        coll = cdoc.Styles.ProfileViewStyles\n        found_names = []\n        for stid in coll:\n            try:\n                st = tr.GetObject(stid, OpenMode.ForRead)\n                try:\n                    nm = st.Name\n                    found_names.append(nm)\n                    if nm and nm.strip().lower() == wanted.lower():\n                        log.append(\"Estilo PV encontrado (iter): '{}'\".format(nm))\n                        return stid\n                except:\n                    found_names.append(\"<ilegible>\")\n            except Exception:\n                pass\n        if found_names:\n            log.append(\"Estilos encontrados al iterar: \" + str(found_names))\n    except Exception as ex:\n        log.append(\"Error iterando estilos PV: \" + str(ex))\n\n    return ObjectId.Null\n\n\ndef list_pv_style_names(cdoc, tr):\n    \"\"\"Lista nombres de estilos PV (solo para diagnostico). Usa bare except\n    porque .Name puede fallar en pythonnet.\"\"\"\n    names = []\n    try:\n        coll = cdoc.Styles.ProfileViewStyles\n        for stid in coll:\n            try:\n                st = tr.GetObject(stid, OpenMode.ForRead)\n                try:\n                    nm = st.Name\n                    if nm and nm not in names:\n                        names.append(nm)\n                except:\n                    pass\n            except Exception:\n                pass\n    except Exception:\n        pass\n    return names\n\n\ndef find_pv_bandset_by_name(cdoc, tr, name, log):\n    \"\"\"Busca un Band Set de ProfileView por nombre. Prueba varias rutas de\n    coleccion (Civil 3D expone los band sets en distintas jerarquias segun\n    version) y, dentro de cada ruta, 3 metodos de indexacion.\"\"\"\n    if not name:\n        return ObjectId.Null\n\n    wanted = name.strip()\n\n    # Rutas candidatas donde puede vivir la coleccion de band sets de PV\n    paths = []\n    for accessor in (\n        lambda: cdoc.Styles.ProfileViewBandSetStyles,\n        lambda: cdoc.Styles.BandSetStyles.ProfileViewBandSetStyles,\n        lambda: cdoc.Styles.BandSetStyles,\n        lambda: cdoc.Styles.ProfileView.BandSetStyles,\n    ):\n        try:\n            coll = accessor()\n            if coll is not None:\n                paths.append(coll)\n        except Exception:\n            pass\n\n    for coll in paths:\n        # Metodo 1: get_Item(string)\n        try:\n            bid = coll.get_Item(wanted)\n            if bid is not None and not bid.IsNull:\n                log.append(\"Band set encontrado (get_Item): '{}'\".format(wanted))\n                return bid\n        except Exception:\n            pass\n        # Metodo 2: indexer\n        try:\n            bid = coll[wanted]\n            if bid is not None and not bid.IsNull:\n                log.append(\"Band set encontrado (indexer): '{}'\".format(wanted))\n                return bid\n        except Exception:\n            pass\n        # Metodo 3: reflexion\n        try:\n            ct = clr.GetClrType(coll.GetType())\n            gi = ct.GetMethod(\"get_Item\", [clr.GetClrType(SysString)])\n            if gi is not None:\n                bid = gi.Invoke(coll, [wanted])\n                if bid is not None and not bid.IsNull:\n                    log.append(\"Band set encontrado (reflection): '{}'\"\n                               .format(wanted))\n                    return bid\n        except Exception:\n            pass\n\n    return ObjectId.Null\n\n\ndef apply_bandset_to_pv(pv_obj, bandset_id, log, aname):\n    \"\"\"Aplica un band set a una ProfileView. Intenta varias firmas del API\n    porque el metodo exacto varia entre versiones de Civil 3D.\"\"\"\n    tried_errors = []\n\n    # Metodo A: pv.ImportBandSet(id)\n    try:\n        pv_obj.ImportBandSet(bandset_id)\n        return True\n    except Exception as e:\n        tried_errors.append(\"ImportBandSet: \" + str(e))\n\n    # Metodo B: pv.Bands.ImportBandSetStyle(id)\n    try:\n        pv_obj.Bands.ImportBandSetStyle(bandset_id)\n        return True\n    except Exception as e:\n        tried_errors.append(\"Bands.ImportBandSetStyle: \" + str(e))\n\n    log.append(\"{}: no pude aplicar band set. Errores: {}\".format(\n        aname, \" | \".join(tried_errors)))\n    return False\n\n\n# ═══════════════════════════════════════════════════════════════════════\ndoc = Application.DocumentManager.MdiActiveDocument\ndb  = doc.Database\n\nlck = None\ntr  = None\n\ntry:\n    lck = doc.LockDocument()\n    tr  = db.TransactionManager.StartTransaction()\n    cdoc = CivilApplication.ActiveDocument\n\n    # Buscar estilo PV por nombre\n    pv_style_id = find_pv_style_by_name(cdoc, tr, pv_style_name, log)\n    if pv_style_name and pv_style_id.IsNull:\n        log.append(\"Estilo PV '{}' NO encontrado. Se usara el estilo por defecto.\"\n                   .format(pv_style_name))\n        log.append(\"Estilos PV disponibles (diagnostico): \"\n                   + str(list_pv_style_names(cdoc, tr)))\n\n    # Buscar band set por nombre\n    bandset_id = find_pv_bandset_by_name(cdoc, tr, bandset_name, log)\n    if bandset_name and bandset_id.IsNull:\n        log.append(\"Band Set '{}' NO encontrado. No se importara.\"\n                   .format(bandset_name))\n\n    n_rows = (len(alignment_names) + n_cols - 1) // n_cols if alignment_names else 0\n    log.append(\"Rejilla: {} columnas x {} filas\".format(n_cols, n_rows))\n\n    for i, aname in enumerate(alignment_names):\n        aname = str(aname)\n        aid, a = find_alignment_by_name(cdoc, tr, aname)\n        if aid is None:\n            log.append(\"{}: alignment no encontrado, omitido\".format(aname))\n            continue\n\n        pv_name = pv_prefix + aname\n\n        # Posicion en la rejilla (fila por fila)\n        col = i % n_cols\n        row = i // n_cols\n        x = origin_x + col * spacing_x\n        y = origin_y + row * spacing_y\n        origin = Point3d(x, y, 0.0)\n\n        # Borrar PV existente con ese nombre (idempotente)\n        try:\n            pv_ids = a.GetProfileViewIds()\n            to_erase = []\n            for pi in range(pv_ids.Count):\n                try:\n                    pvid = pv_ids.get_Item(pi)\n                except Exception:\n                    try:\n                        pvid = pv_ids[pi]\n                    except Exception:\n                        continue\n                try:\n                    pv = tr.GetObject(pvid, OpenMode.ForRead)\n                    if get_name_safe(pv) == pv_name:\n                        to_erase.append(pvid)\n                except Exception:\n                    pass\n            for pvid in to_erase:\n                try:\n                    obj = tr.GetObject(pvid, OpenMode.ForWrite)\n                    obj.Erase()\n                except Exception:\n                    pass\n        except Exception:\n            pass\n\n        # Crear PV nueva\n        try:\n            new_pv_id = ProfileView.Create(aid, origin)\n            if new_pv_id and not new_pv_id.IsNull:\n                pv_obj = tr.GetObject(new_pv_id, OpenMode.ForWrite)\n                # Renombrar\n                try:\n                    pv_obj.Name = pv_name\n                except Exception as ex_rn:\n                    log.append(\"{}: no pude renombrar: {}\".format(\n                        aname, str(ex_rn)))\n                # Aplicar estilo PV\n                if not pv_style_id.IsNull:\n                    try:\n                        pv_obj.StyleId = pv_style_id\n                    except Exception as ex_st:\n                        log.append(\"{}: no pude asignar estilo: {}\".format(\n                            aname, str(ex_st)))\n                # Aplicar band set\n                if not bandset_id.IsNull:\n                    apply_bandset_to_pv(pv_obj, bandset_id, log, aname)\n                pvs_created.append(\"{} @ ({:.2f}, {:.2f})\".format(pv_name, x, y))\n                try:\n                    pv_handles.append(\"{}|{}\".format(pv_name, pv_obj.Handle.ToString()))\n                except Exception:\n                    pv_handles.append(\"{}|\".format(pv_name))\n            else:\n                log.append(\"{}: ProfileView.Create devolvio ObjectId nulo\"\n                           .format(aname))\n        except Exception as ex:\n            log.append(\"{}: fallo crear PV: {}\".format(aname, str(ex)))\n\n    log.append(\"PVs creadas: {}\".format(len(pvs_created)))\n    tr.Commit()\n\nexcept Exception:\n    log.append(\"ERROR: \" + traceback.format_exc())\n    try:\n        if tr: tr.Abort()\n    except Exception:\n        pass\nfinally:\n    try:\n        if tr: tr.Dispose()\n    except Exception:\n        pass\n    try:\n        if lck: lck.Dispose()\n    except Exception:\n        pass\n\n\nOUT = [pvs_created, log, pv_handles]\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
