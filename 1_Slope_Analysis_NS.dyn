    {
      "ConcreteType": "CoreNodeModels.Input.StringInput, CoreNodeModels",
      "Id": "a0c205022fd74415844458f7475e4366",
      "NodeType": "StringInputNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "cfd6b666a3844b8694018266673572c7",
          "Name": "",
