    {
      "Id": "f5dcc513b2c5451e844f3cb46b28c2d5",
      "Name": "Log",
      "Type": "string",
      "InitialValue": "Contornos encontrados: 9\nTrackers encontrados:  745\nOpcion de puntos: 2 (2 extremos)\nEstilo 'elevaciones' asignado.\n3 rangos de color aplicados (-7.48 a 0.91).\nEtiquetas de pendiente creadas: 745\n\n=== RESUMEN ===\nTrackers dentro del contorno:  745\n  Verde   (<= 3.0 %):          534\n  Amarillo(3.0 - 4.0 %):        82\n  Rojo    (> 4.0 %):           129\nTrackers fuera del contorno:   0\nTrackers con error de muestreo:0\nSuperficie creada:             Slope_Analysis_N-S",
      "Description": "Visualizes a node's output"
    }
