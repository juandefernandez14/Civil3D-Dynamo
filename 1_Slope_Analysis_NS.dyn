    {
      "ConcreteType": "CoreNodeModels.Input.DoubleInput, CoreNodeModels",
      "NumberType": "Double",
      "Id": "28f6ba2cd42a4a99a63617b5cd68c66d",
      "NodeType": "NumberInputNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "5419f7be1b064cdfab7186d97a0dc7d9",
          "Name": "",
          "Description": "Number",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Creates a number",
      "InputValue": 2.0
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# -*- coding: utf-8 -*-\n# =============================================================================\n# Slope_Analysis_NS.dyn  -  Nodo Python principal\n# Civil 3D 2024 / Dynamo / CPython3\n#\n# Entradas (puertos IN[0..6]):\n#   IN[0] : str    nombre del MDT (surface ya referenciado por data shortcut)\n#   IN[1] : str    nombre de capa del contorno (polilineas cerradas)\n#   IN[2] : str    nombre de capa de los trackers (polilineas de 2 vertices)\n#   IN[3] : float  pendiente maxima admisible (%)  --> umbral rojo\n#   IN[4] : float  pendiente de aviso (%)          --> umbral amarillo\n#   IN[5] : str    nombre de la nueva superficie TIN (p.ej. \"Slope_Analysis_N-S\")\n#   IN[6] : int    opcion de puntos por tracker:\n#                   1 = un punto en el centroide (triangulacion entre trackers)\n#                   2 = dos puntos (ambos extremos) -> bandas planas por tracker\n#\n# Salida:\n#   OUT   : str    log con el resumen del analisis\n# =============================================================================\n\nimport clr\nimport math\nimport traceback\n\nclr.AddReference('AcMgd')\nclr.AddReference('AcCoreMgd')\nclr.AddReference('AcDbMgd')\nclr.AddReference('AecBaseMgd')\nclr.AddReference('AeccDbMgd')\n\nfrom Autodesk.AutoCAD.ApplicationServices import Application as AcadApp\nfrom Autodesk.AutoCAD.DatabaseServices import (\n    Transaction, OpenMode, BlockTable, BlockTableRecord,\n    Polyline, SymbolUtilityServices\n)\nfrom Autodesk.AutoCAD.Geometry import Point2d, Point3d, Point3dCollection\nfrom Autodesk.Civil import SurfaceBoundaryType\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\nfrom Autodesk.Civil.DatabaseServices import (\n    TinSurface, SurfaceAnalysisElevationData, SurfaceSlopeLabel\n)\n\nimport System\nfrom System import Array\nfrom Autodesk.AutoCAD.Colors import Color as AcadColor\n\n# --------------------------------------------------------------------------- #\n# Inputs\n# --------------------------------------------------------------------------- #\nmdt_name       = str(IN[0])\ncontour_layer  = str(IN[1])\ntracker_layer  = str(IN[2])\nmax_slope_pct  = float(IN[3])\nwarn_slope_pct = float(IN[4])\nout_surf_name  = str(IN[5])\nopt_pts        = int(float(IN[6])) if len(IN) > 6 and IN[6] is not None else 1\nif opt_pts not in (1, 2):\n    opt_pts = 1\n\nlog = []\n\ndef pip(px, py, poly):\n    \"\"\"Ray-casting point-in-polygon (poly = list of (x,y), no need to close).\"\"\"\n    inside = False\n    n = len(poly)\n    if n < 3:\n        return False\n    j = n - 1\n    for i in range(n):\n        xi, yi = poly[i]\n        xj, yj = poly[j]\n        if ((yi > py) != (yj > py)) and \\\n           (px < (xj - xi) * (py - yi) / ((yj - yi) if (yj - yi) != 0 else 1e-12) + xi):\n            inside = not inside\n        j = i\n    return inside\n\ntry:\n    doc  = AcadApp.DocumentManager.MdiActiveDocument\n    db   = doc.Database\n    cdoc = CivilApplication.ActiveDocument\n\n    dlock = doc.LockDocument()\n    try:\n        tr = db.TransactionManager.StartTransaction()\n        try:\n\n            # ---------------------------------------------------------------- #\n            # 1. Localizar el MDT por nombre\n            # ---------------------------------------------------------------- #\n            mdt_surf = None\n            mdt_surf_id = None\n            for sid in cdoc.GetSurfaceIds():\n                s = tr.GetObject(sid, OpenMode.ForRead)\n                if s.Name == mdt_name:\n                    mdt_surf = s\n                    mdt_surf_id = sid\n                    break\n            if mdt_surf is None:\n                raise Exception(\"No se ha encontrado el MDT '{}'. \"\n                                \"Comprueba que el data shortcut esta referenciado.\"\n                                .format(mdt_name))\n\n            # ---------------------------------------------------------------- #\n            # 2. Recorrer ModelSpace y separar contornos / trackers\n            # ---------------------------------------------------------------- #\n            bt  = tr.GetObject(db.BlockTableId, OpenMode.ForRead)\n            ms_id = SymbolUtilityServices.GetBlockModelSpaceId(db)\n            btr = tr.GetObject(ms_id, OpenMode.ForRead)\n\n            contours = []   # lista de poligonos [(x,y),...]\n            trackers = []   # lista de ((xA,yA),(xB,yB), handle_str)\n\n            for oid in btr:\n                obj = tr.GetObject(oid, OpenMode.ForRead)\n                if not isinstance(obj, Polyline):\n                    continue\n                lay = obj.Layer\n                n = obj.NumberOfVertices\n                if lay == contour_layer and n >= 3:\n                    pts = []\n                    for i in range(n):\n                        p = obj.GetPoint2dAt(i)\n                        pts.append((p.X, p.Y))\n                    contours.append(pts)\n                elif lay == tracker_layer and n >= 2:\n                    p1 = obj.GetPoint2dAt(0)\n                    p2 = obj.GetPoint2dAt(n - 1)\n                    # Forzar que el primer vertice sea el del Norte (mayor Y)\n                    if p1.Y >= p2.Y:\n                        trackers.append(((p1.X, p1.Y),\n                                         (p2.X, p2.Y),\n                                         str(obj.Handle)))\n                    else:\n                        trackers.append(((p2.X, p2.Y),\n                                         (p1.X, p1.Y),\n                                         str(obj.Handle)))\n\n            if not contours:\n                raise Exception(\"No hay polilineas en la capa de contorno '{}'.\"\n                                .format(contour_layer))\n            if not trackers:\n                raise Exception(\"No hay polilineas en la capa de trackers '{}'.\"\n                                .format(tracker_layer))\n\n            log.append(\"Contornos encontrados: {}\".format(len(contours)))\n            log.append(\"Trackers encontrados:  {}\".format(len(trackers)))\n            log.append(\"Opcion de puntos: {} ({})\".format(\n                opt_pts,\n                \"2 extremos\" if opt_pts == 2 else \"centroide\"))\n\n            # ---------------------------------------------------------------- #\n            # 3. Para cada tracker: filtrar por contorno, muestrear Z en MDT,\n            #    calcular pendiente absoluta en %, acumular 2 puntos por tracker\n            # ---------------------------------------------------------------- #\n            surf_points = []   # Point3d con Z = pendiente(%)\n            label_pairs = []   # [(Point3d_A, Point3d_B), ...] para etiquetas\n            n_ok = n_warn = n_ko = n_out = n_err = 0\n\n            for (xa, ya), (xb, yb), handle in trackers:\n\n                # filtro: AMBOS vertices deben estar dentro de algun contorno\n                inA = any(pip(xa, ya, c) for c in contours)\n                inB = any(pip(xb, yb, c) for c in contours)\n                if not (inA and inB):\n                    n_out += 1\n                    continue\n\n                # muestreo de cotas en el MDT\n                try:\n                    za = mdt_surf.FindElevationAtXY(xa, ya)\n                    zb = mdt_surf.FindElevationAtXY(xb, yb)\n                except:\n                    n_err += 1\n                    continue\n\n                dx = xb - xa\n                dy = yb - ya\n                L  = math.sqrt(dx * dx + dy * dy)\n                if L < 1e-6:\n                    n_err += 1\n                    continue\n\n                slope_pct = (zb - za) / L * 100.0\n\n                if abs(slope_pct) > max_slope_pct:\n                    n_ko += 1\n                elif abs(slope_pct) > warn_slope_pct:\n                    n_warn += 1\n                else:\n                    n_ok += 1\n\n                if opt_pts == 2:\n                    # Opcion 2: 2 puntos por tracker (ambos extremos)\n                    # con Z = pendiente -> bandas planas por tracker\n                    surf_points.append(Point3d(xa, ya, slope_pct))\n                    surf_points.append(Point3d(xb, yb, slope_pct))\n                else:\n                    # Opcion 1: 1 punto por tracker en el centroide 2D\n                    # con Z = pendiente -> triangulacion entre centroides\n                    xm = (xa + xb) / 2.0\n                    ym = (ya + yb) / 2.0\n                    surf_points.append(Point3d(xm, ym, slope_pct))\n\n                # Acumular para crear etiqueta despues (Point2d)\n                label_pairs.append((Point2d(xa, ya), Point2d(xb, yb)))\n\n            if not surf_points:\n                raise Exception(\"Ningun tracker ha podido ser analizado \"\n                                \"(todos fuera de contorno o errores de muestreo).\")\n\n            # ---------------------------------------------------------------- #\n            # 4. Crear la superficie TIN (borrando la anterior si existe)\n            # ---------------------------------------------------------------- #\n            existing_id = None\n            for sid in cdoc.GetSurfaceIds():\n                s = tr.GetObject(sid, OpenMode.ForRead)\n                if s.Name == out_surf_name:\n                    existing_id = sid\n                    break\n            if existing_id is not None:\n                sx = tr.GetObject(existing_id, OpenMode.ForWrite)\n                sx.Erase()\n\n            new_surf_id = TinSurface.Create(db, out_surf_name)\n            new_surf    = tr.GetObject(new_surf_id, OpenMode.ForWrite)\n\n            # Anyadir vertices\n            for p in surf_points:\n                new_surf.AddVertex(p)\n\n            # ---------------------------------------------------------------- #\n            # 5. Anyadir contornos: el primero como Outer, los demas como Show\n            # ---------------------------------------------------------------- #\n            first = True\n            for c in contours:\n                pc = Point3dCollection()\n                for (x, y) in c:\n                    pc.Add(Point3d(x, y, 0.0))\n                # cerrar si no esta cerrado\n                if (c[0][0], c[0][1]) != (c[-1][0], c[-1][1]):\n                    pc.Add(Point3d(c[0][0], c[0][1], 0.0))\n                btype = SurfaceBoundaryType.Outer if first else SurfaceBoundaryType.Show\n                new_surf.BoundariesDefinition.AddBoundaries(pc, 1.0, btype, True)\n                first = False\n\n            # ---------------------------------------------------------------- #\n            # 6. Asignar estilo \"elevaciones\" a la superficie\n            # ---------------------------------------------------------------- #\n            style_set = False\n            try:\n                ss = cdoc.Styles.SurfaceStyles\n                for name_try in [\"elevaciones\", \"Elevaciones\", \"ELEVACIONES\"]:\n                    try:\n                        style_id = ss.get_Item(name_try)\n                        new_surf.StyleId = style_id\n                        style_set = True\n                        log.append(\"Estilo '{}' asignado.\".format(name_try))\n                        break\n                    except:\n                        continue\n                if not style_set:\n                    log.append(\"AVISO: estilo 'elevaciones' no encontrado. \"\n                               \"Asignalo a mano.\")\n            except Exception as ex_sty:\n                log.append(\"AVISO: error buscando estilos: {}\".format(ex_sty))\n\n            # ---------------------------------------------------------------- #\n            # 6b. Analisis de elevaciones: rangos dinamicos segun datos reales\n            #     Solo se crean las bandas amarillo/rojo si hay datos que las\n            #     alcancen. El verde absorbe los extremos que caen dentro.\n            # ---------------------------------------------------------------- #\n            z_min = min(p.Z for p in surf_points)\n            z_max = max(p.Z for p in surf_points)\n\n            green  = AcadColor.FromRgb(80, 200, 80)\n            yellow = AcadColor.FromRgb(240, 220, 60)\n            red    = AcadColor.FromRgb(220, 50, 50)\n\n            ranges = []\n            # --- lado negativo ---\n            if z_min < -max_slope_pct:\n                ranges.append((z_min,           -max_slope_pct, red))\n                ranges.append((-max_slope_pct, -warn_slope_pct, yellow))\n                green_lo = -warn_slope_pct\n            elif z_min < -warn_slope_pct:\n                ranges.append((z_min, -warn_slope_pct, yellow))\n                green_lo = -warn_slope_pct\n            else:\n                green_lo = z_min   # z_min dentro del verde, verde absorbe\n\n            # --- lado positivo: decidir green_hi y colas ---\n            pos_tail = []\n            if z_max > max_slope_pct:\n                green_hi = warn_slope_pct\n                pos_tail.append((warn_slope_pct, max_slope_pct, yellow))\n                pos_tail.append((max_slope_pct,  z_max,         red))\n            elif z_max > warn_slope_pct:\n                green_hi = warn_slope_pct\n                pos_tail.append((warn_slope_pct, z_max, yellow))\n            else:\n                green_hi = z_max   # z_max dentro del verde, verde absorbe\n\n            # --- verde + cola positiva ---\n            # Asegurar que el verde tenga anchura no-nula (caso extremo)\n            if green_lo >= green_hi:\n                green_hi = green_lo + 0.001\n            ranges.append((green_lo, green_hi, green))\n            ranges.extend(pos_tail)\n\n            try:\n                data_arr = [\n                    SurfaceAnalysisElevationData(mn, mx, col)\n                    for (mn, mx, col) in ranges\n                ]\n                arr = Array[SurfaceAnalysisElevationData](data_arr)\n                new_surf.Analysis.SetElevationData(arr)\n                log.append(\"{} rangos de color aplicados ({:.2f} a {:.2f}).\".format(\n                    len(ranges), z_min, z_max))\n            except Exception as ex_an:\n                log.append(\"AVISO: no se pudieron aplicar los rangos por API \"\n                           \"({}). Configuralos a mano en Analysis -> Elevations.\"\n                           .format(ex_an))\n                log.append(\"Rangos a configurar manualmente:\")\n                for (mn, mx, col) in ranges:\n                    col_name = (\"Verde\" if col is green else\n                                \"Amarillo\" if col is yellow else \"Rojo\")\n                    log.append(\"  {}: [{:.2f}, {:.2f}]\".format(col_name, mn, mx))\n\n            # ---------------------------------------------------------------- #\n            # 7. Etiquetas de pendiente \"Two points\" sobre el MDT\n            # Firma correcta en Civil 3D 2024:\n            #   SurfaceSlopeLabel.Create(surfaceId, Point2d, Point2d, styleId)\n            # ---------------------------------------------------------------- #\n            slope_style_id = None\n            try:\n                lss = cdoc.Styles.LabelStyles.SurfaceLabelStyles.SlopeLabelStyles\n                for stid in lss:\n                    slope_style_id = stid\n                    break\n            except Exception as ex_ss:\n                log.append(\"AVISO: no se pudo leer SlopeLabelStyles: {}\".format(ex_ss))\n\n            n_labels = 0\n            n_label_err = 0\n            first_err = None\n            for pA, pB in label_pairs:\n                try:\n                    if slope_style_id is not None:\n                        SurfaceSlopeLabel.Create(mdt_surf_id, pA, pB, slope_style_id)\n                    else:\n                        SurfaceSlopeLabel.Create(mdt_surf_id, pA, pB)\n                    n_labels += 1\n                except Exception as ex_lb:\n                    n_label_err += 1\n                    if first_err is None:\n                        first_err = str(ex_lb)\n            log.append(\"Etiquetas de pendiente creadas: {}\".format(n_labels))\n            if n_label_err > 0:\n                log.append(\"Etiquetas con error: {}\".format(n_label_err))\n                log.append(\"Primer error: {}\".format(first_err))\n\n            tr.Commit()\n        finally:\n            tr.Dispose()\n    finally:\n        dlock.Dispose()\n\n    log.append(\"\")\n    log.append(\"=== RESUMEN ===\")\n    log.append(\"Trackers dentro del contorno:  {}\".format(n_ok + n_warn + n_ko))\n    log.append(\"  Verde   (<= {} %):          {}\".format(warn_slope_pct, n_ok))\n    log.append(\"  Amarillo({} - {} %):        {}\".format(warn_slope_pct, max_slope_pct, n_warn))\n    log.append(\"  Rojo    (> {} %):           {}\".format(max_slope_pct, n_ko))\n    log.append(\"Trackers fuera del contorno:   {}\".format(n_out))\n    log.append(\"Trackers con error de muestreo:{}\".format(n_err))\n    log.append(\"Superficie creada:             {}\".format(out_surf_name))\n\n    OUT = \"\\n\".join(log)\n\nexcept Exception as ex:\n    OUT = \"ERROR:\\n\" + str(ex) + \"\\n\\n\" + traceback.format_exc()\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "9d9c1518a4284deea3d5e22eba4380d5",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "c1903e7381a44338a59946af0e1da91a",
          "Name": "IN[0]",
          "Description": "",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "2929e3efff1046f3bef330ffa7c43b4a",
          "Name": "IN[1]",
          "Description": "",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "976f96b2805d4b5a835b64fcfb3cad35",
          "Name": "IN[2]",
          "Description": "",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "c4a5c53500f54eeaa714e9e8283248c6",
          "Name": "IN[3]",
          "Description": "",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "61206da73dc544da9f31e12de7bcbd1e",
          "Name": "IN[4]",
          "Description": "",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
